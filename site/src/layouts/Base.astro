---
import '@fontsource-variable/ibarra-real-nova';
import '@fontsource-variable/ibarra-real-nova/wght-italic.css';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bedrijf from '../content/bedrijf.json';

const { titel, omschrijving, thema, basis = '', noindex = false, variant, eigenKader = false } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: bedrijf.naam,
  slogan: bedrijf.tagline,
  telephone: bedrijf.telefoon_link,
  email: bedrijf.email,
  url: Astro.site?.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: bedrijf.adres_straat,
    addressLocality: 'Rotterdam',
    postalCode: '3063 AV',
    addressCountry: 'NL',
  },
  areaServed: 'Rotterdam',
  foundingDate: bedrijf.sinds,
};
---
<!doctype html>
<html lang="nl" data-thema={thema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={omschrijving} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <script is:inline>document.documentElement.classList.add('heeft-js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script src="https://cms-denhaag.vercel.app/preview-bridge.js" defer></script>
  </head>
  <body>
    <a href="#inhoud" class="skiplink">Naar de inhoud</a>
    {eigenKader ? <slot name="kop" /> : <Header basis={basis} vector={thema === 'groen'} />}
    <main id="inhoud">
      <slot />
    </main>
    {eigenKader ? <slot name="voet" /> : <Footer basis={basis} />}
    {variant && (
      <div class="variant-switch" role="group" aria-label="Ontwerpvariant kiezen">
        <span>Variant</span>
        <a href="/fris" class={variant === 'fris' ? 'actief' : ''} aria-current={variant === 'fris' ? 'true' : undefined}>Fris</a>
        <a href="/groen" class={variant === 'groen' ? 'actief' : ''} aria-current={variant === 'groen' ? 'true' : undefined}>Groen</a>
        <a href="/v1" class={variant === 'v1' ? 'actief' : ''} aria-current={variant === 'v1' ? 'true' : undefined}>v1</a>
        <a href="/" class={variant === 'v3' ? 'actief' : ''} aria-current={variant === 'v3' ? 'true' : undefined}>v3</a>
      </div>
    )}
  </body>
</html>

<style>
  .skiplink {
    position: absolute;
    left: -100vw;
    top: 0.5rem;
    z-index: 100;
    background: var(--navy);
    color: #fff;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
  }
  .skiplink:focus {
    left: 0.5rem;
  }
  .variant-switch {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    translate: -50% 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.4rem 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(0, 40, 58, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 40px -16px rgba(0, 20, 30, 0.7);
    font-family: var(--font-tekst);
  }
  .variant-switch > span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9fbdd2;
    margin-right: 0.25rem;
  }
  .variant-switch a {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #dcebf4;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .variant-switch a:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .variant-switch a.actief {
    background: #fff;
    color: var(--navy);
  }
  @media (max-width: 520px) {
    .variant-switch {
      bottom: 0.7rem;
      padding-left: 0.75rem;
    }
    .variant-switch > span {
      display: none;
    }
  }
</style>
