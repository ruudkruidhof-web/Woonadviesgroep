  @media (min-width: 900px) {
    .hero {
      padding-block: 2.25rem 2.75rem;
    }
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
      align-items: center;
    }
    .hero-beeld {
      justify-self: end;
      width: min(100%, 23.5rem);
      rotate: 1.2deg;
      margin-right: 0.5rem;
    }
    .zekerheden {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      margin-top: 1.75rem;
      font-size: 0.92rem;
    }
    .zekerheden li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
    section:not(.hero) {
      padding-top: 6.5rem;
    }
    .register-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: 4.5rem;
    }
    .register-beeld {
      display: block;
      position: sticky;
      top: 7rem;
      width: min(100%, 22rem);
      justify-self: end;
      aspect-ratio: 3 / 4;
      border-radius: 999px 999px var(--radius) var(--radius);
      overflow: hidden;
      box-shadow: 0 30px 60px -30px rgba(0, 56, 80, 0.4);
    }
    .register-beeld img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .register-beeld img.actief {
      opacity: 1;
    }
    summary {
      grid-template-columns: 3.2rem 1fr auto;
      padding-block: 1.8rem;
    }
    .verhaal {
      margin-top: 6.5rem;
      padding-block: 6rem 6.5rem;
    }
    .verhaal-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
    .verhaal-beeld {
      justify-self: start;
      rotate: -1.2deg;
    }
    .verhaal-beeld blockquote {
      left: auto;
      right: -3.5rem;
      bottom: 2.5rem;
      max-width: 17rem;
      rotate: 1.2deg;
    }
    .route-vlak {
      margin-top: 4rem;
    }
    .route-pad {
      display: block;
    }
    .stations {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
    .stations::before {
      display: none;
    }
    .station {
      padding-left: 0;
      padding-top: 5rem;
    }
    .station-nr {
      top: 0;
      left: 0;
    }
    .route-einde {
      position: absolute;
      top: 0.35rem;
      right: 0;
      margin: 0;
      padding-left: 0.9rem;
      background: linear-gradient(90deg, transparent, #012f44 22%, #012f44);
    }
    .reviews-grid {
      grid-template-columns: 19.5rem minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
    }
    .score-kaart {
      align-content: start;
      padding: 2.5rem 2.2rem;
    }
    .rail-wrap {
      margin-inline: 0 calc((100vw - var(--maat)) / -2);
    }
    .rail {
      padding: 0.5rem calc((100vw - var(--maat)) / 2) 1rem 0;
      scroll-padding-inline: 0;
    }
    .rail li {
      flex-basis: 22.5rem;
    }
    .rail-knoppen {
      padding-inline: 0;
    }
    .route-slot {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
      margin-top: 5rem;
    }
    .briefje {
      margin: 0;
    }
    .manifest-strip {
      grid-template-columns: auto 1fr;
      column-gap: 3.5rem;
      row-gap: 1.8rem;
      align-items: center;
      padding-bottom: 5rem;
    }
    .manifest-merk {
      grid-row: span 2;
      justify-self: center;
    }
    .manifest-tekst {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .manifest-tekst p + p {
      margin-top: 0;
    }
    .artikelen {
      grid-template-columns: 1.5fr 1fr;
      gap: 3.5rem;
    }
    .artikel-groot img {
      aspect-ratio: 4 / 3;
    }
    .artikel-groot h3 {
      font-size: 1.8rem;
    }
    .artikelen-rest {
      gap: 3rem;
    }
    .artikelen-rest article {
      display: grid;
      grid-template-columns: 9.5rem 1fr;
      gap: 1.4rem;
      align-items: start;
    }
    .artikelen-rest img {
      aspect-ratio: 1;
    }
    .artikelen-rest time {
      margin-top: 0;
    }
    .contact {
      margin-top: 7rem;
      padding-block: 6.5rem;
    }
    .contact-inhoud {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 4rem;
    }
    .kaartje {
      justify-self: end;
      width: min(100%, 23rem);
    }
    #plan-dialoog[open] {
      grid-template-columns: 1fr 1.4fr;
    }
    .dialoog-merk {
      display: flex;
    }
    #plan-dialoog form {
      padding: 2.6rem 2.6rem 2.4rem;
    }
    .dialoog-succes {
      grid-column: 2;
      padding: 3.2rem 2.6rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero h1 .regel, .hero .intro, .hero-acties, .zekerheden, .hero-beeld', {
      opacity: 0,
      y: 26,
      duration: 0.9,
      ease: 'power2.out',
      stagger: 0.09,
    });
    gsap.from('.stempel', { opacity: 0, scale: 0.6, duration: 0.7, ease: 'back.out(1.6)', delay: 1 });

    const lijn = document.querySelector('.rust-lijn path');
    const lijnLengte = lijn.getTotalLength();
    gsap.fromTo(
      lijn,
      { strokeDasharray: lijnLengte, strokeDashoffset: lijnLengte },
      { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut', delay: 0.9 }
    );

    gsap.to('.hero-beeld', {
      y: -12,
      duration: 3.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 1.6,
    });
    gsap.to('.hero-cirkel-blauw', {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.hero-cirkel-bruin', {
      yPercent: -14,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });

    const pad = document.querySelector('.route-pad path');
    const padZichtbaar = () => getComputedStyle(document.querySelector('.route-pad')).display !== 'none';
    if (pad && padZichtbaar()) {
      const lengte = pad.getTotalLength();
      gsap.fromTo(
        pad,
        { strokeDasharray: `7 7`, strokeDashoffset: 0, opacity: 0 },
        {
          opacity: 1,
          duration: 0.1,
          scrollTrigger: { trigger: '.route-vlak', start: 'top 95%', once: true },
        }
      );
      gsap.fromTo(
        '.route-pad',
        { clipPath: 'inset(0 100% 0 0)' },
        {
          clipPath: 'inset(0 0% 0 0)',
          ease: 'none',
          scrollTrigger: { trigger: '.route-vlak', start: 'top 92%', end: 'top 58%', scrub: 0.4 },
        }
      );
    }

    document.querySelectorAll('.reveal').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });
  });

  mm.add('(prefers-reduced-motion: reduce)', () => {
    gsap.set('.reveal, .route-pad', { opacity: 1, clearProps: 'clipPath' });
  });

  const beelden = document.querySelectorAll('.register-beeld img');
  const kies = (index) => {
    beelden.forEach((b) => b.classList.toggle('actief', b.dataset.index === index));
  };

  const rijen = [...document.querySelectorAll('.register-rijen > li')];
  const animatieOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  const sluit = (details) => {
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) {
      details.open = false;
      return;
    }
    gsap.to(klep, {
      height: 0,
      opacity: 0,
      duration: 0.35,
      ease: 'power2.inOut',
      onComplete: () => {
        details.open = false;
        gsap.set(klep, { clearProps: 'all' });
      },
    });
  };

  const openen = (details) => {
    details.open = true;
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) return;
    gsap.fromTo(
      klep,
      { height: 0, opacity: 0 },
      { height: 'auto', opacity: 1, duration: 0.45, ease: 'power2.out', onComplete: () => gsap.set(klep, { clearProps: 'all' }) }
    );
  };

  rijen.forEach((rij) => {
    const details = rij.querySelector('details');
    rij.querySelector('summary').addEventListener('click', (e) => {
      e.preventDefault();
      if (details.open) {
        sluit(details);
        return;
      }
      rijen.forEach((andere) => {
        const d = andere.querySelector('details');
        if (d !== details && d.open) sluit(d);
      });
      openen(details);
      kies(rij.dataset.index);
    });
    rij.addEventListener('mouseenter', () => kies(rij.dataset.index));
    rij.addEventListener('focusin', () => kies(rij.dataset.index));
  });

  const rail = document.querySelector('.rail');
  const railKnoppen = [...document.querySelectorAll('.rail-knop')];
  const railStap = () => {
    const kaart = rail.querySelector('li');
    return kaart ? kaart.getBoundingClientRect().width + 18 : 340;
  };
  const railStatus = () => {
    const max = rail.scrollWidth - rail.clientWidth - 4;
    railKnoppen.forEach((k) => {
      k.disabled = k.dataset.richting === '-1' ? rail.scrollLeft <= 4 : rail.scrollLeft >= max;
    });
  };
  railKnoppen.forEach((k) => {
    k.addEventListener('click', () => {
      rail.scrollBy({ left: railStap() * Number(k.dataset.richting), behavior: animatieOk ? 'smooth' : 'auto' });
    });
  });
  rail.addEventListener('scroll', railStatus, { passive: true });
  window.addEventListener('resize', railStatus);
  railStatus();

  const dialoog = document.getElementById('plan-dialoog');
  const formulier = dialoog.querySelector('form');
  const succes = dialoog.querySelector('.dialoog-succes');
  const onderwerp = formulier.querySelector('select');

  document.querySelectorAll('[data-plan-open]').forEach((knop) => {
    knop.addEventListener('click', (e) => {
      e.preventDefault();
      formulier.hidden = false;
      succes.hidden = true;
      if (knop.dataset.dienst) onderwerp.value = knop.dataset.dienst;
      dialoog.showModal();
      formulier.querySelector('input').focus();
      if (animatieOk) {
        gsap.from(dialoog, { opacity: 0, y: 18, scale: 0.97, duration: 0.35, ease: 'power2.out' });
      }
    });
  });
  dialoog.querySelectorAll('.dialoog-sluit, .dialoog-sluit-2').forEach((k) => {
    k.addEventListener('click', () => dialoog.close());
  });
  dialoog.addEventListener('click', (e) => {
    if (e.target === dialoog) dialoog.close();
  });
  formulier.addEventListener('submit', (e) => {
    // Conceptfase: nog geen backend gekoppeld, de tracker leest het formulier via data-hb-lead
    e.preventDefault();
    formulier.hidden = true;
    succes.hidden = false;
  });
</script>
