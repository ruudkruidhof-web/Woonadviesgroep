    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #003850;
    border: 1.5px solid var(--sky);
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.5rem;
