    color: #b6cddd;
  }
  .route-vlak {
    position: relative;
    margin-top: 3.2rem;
  }
  .route-pad {
    display: none;
    position: absolute;
    top: 0.05rem;
    left: 0;
    width: 100%;
    height: 3.4rem;
    color: rgba(106, 171, 218, 0.75);
    pointer-events: none;
  }
  .stations {
    list-style: none;
