---
import Base from '../layouts/Base.astro';
import Merk from '../components/Merk.astro';
import home from '../content/teksten/home.json';
import diensten from '../content/diensten.json';
import werkwijze from '../content/werkwijze.json';
import nieuws from '../content/nieuws.json';
import reviews from '../content/reviews.json';
import bedrijf from '../content/bedrijf.json';

const datumFmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const [hoofdartikel, ...restartikelen] = nieuws;
const zekerheden = [
  'Volledig onafhankelijk',
  `AFM-geregistreerd (${bedrijf.afm})`,
  'Aangesloten bij Kifid',
  `Sinds ${bedrijf.sinds} in Rotterdam`,
];
---
<Base
  titel="WoonAdvies Groep | Onafhankelijk financieel advies in Rotterdam"
  omschrijving="Onafhankelijk advies over hypotheken, pensioenen, verzekeringen en financiën. Persoonlijk en transparant, vanuit Rotterdam. Financiële rust voor nu en in de toekomst."
>
  <section class="hero">
    <div class="hero-cirkel hero-cirkel-blauw" aria-hidden="true"></div>
    <div class="hero-cirkel hero-cirkel-bruin" aria-hidden="true"></div>
    <div class="maat hero-grid">
      <div class="hero-tekst">
        <h1>
          <span class="regel" data-cms-field="hero_titel_voor">{home.hero_titel_voor}</span>
          <em class="regel rust" data-cms-field="hero_titel_accent">{home.hero_titel_accent}<svg class="rust-lijn" viewBox="0 0 140 14" preserveAspectRatio="none" aria-hidden="true"><path d="M6 10 C 40 3, 95 13, 134 5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></em>
          <span class="regel na" data-cms-field="hero_titel_na">{home.hero_titel_na}</span>
        </h1>
        <p class="intro" data-cms-field="hero_tekst">{home.hero_tekst}</p>
        <div class="hero-acties">
          <a href="#contact" class="knop knop-vol" data-plan-open data-hb-goal="kennismaking">{home.hero_knop}</a>
          <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-lijn">Bel {bedrijf.telefoon}</a>
        </div>
      </div>
      <figure class="hero-beeld">
        <img src={home.hero_beeld} alt={home.hero_beeld_alt} width="1600" height="900" fetchpriority="high" data-cms-field="hero_beeld" />
        <span class="stempel" aria-hidden="true">
          <Merk breedte={44} klasse="stempel-merk" />
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="stempel-rond" d="M60 13 a47 47 0 1 1 -0.01 0" />
            </defs>
            <text>
              <textPath href="#stempel-rond">Financiële rust · sinds 2010 · Rotterdam ·&nbsp;</textPath>
            </text>
          </svg>
        </span>
      </figure>
    </div>
    <ul class="maat zekerheden">
      {zekerheden.map((z) => (
        <li>
          <svg width="15" height="10" viewBox="0 0 16 11" aria-hidden="true"><path d="M2 9.5 8 2l6 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {z}
        </li>
      ))}
    </ul>
  </section>

  <section class="register" id="diensten" aria-labelledby="register-kop">
    <div class="maat">
      <div class="register-kop">
        <h2 id="register-kop" class="reveal" data-cms-field="diensten_titel">{home.diensten_titel}</h2>
        <p class="reveal" data-cms-field="diensten_tekst">{home.diensten_tekst}</p>
      </div>
      <div class="register-grid">
        <ol class="register-rijen" data-cms-collection="diensten">
          {diensten.map((d, i) => (
            <li class="reveal" id={d.id} data-cms-item={d.id} data-index={i}>
              <details open={i === 0}>
                <summary>
                  <span class="register-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 data-cms-field="titel">{d.titel}</h3>
                  <span class="register-plus" aria-hidden="true"></span>
                </summary>
                <div class="register-klep">
                  <div class="register-inhoud">
                    <p data-cms-field="tekst">{d.tekst}</p>
                    <ul>
                      {d.punten.map((punt) => (
                        <li>
                          <svg width="12" height="9" viewBox="0 0 16 11" aria-hidden="true"><path d="M2 9.5 8 2l6 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {punt}
                        </li>
                      ))}
                    </ul>
                    <a href="#contact" data-plan-open data-dienst={d.titel} data-hb-goal="dienst-interesse">Bespreek uw situatie</a>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
        <figure class="register-beeld" aria-hidden="true">
          {diensten.map((d, i) => (
            <img src={d.beeld} alt="" width="900" height="1200" loading="lazy" class={i === 0 ? 'actief' : ''} data-index={i} />
          ))}
        </figure>
      </div>
    </div>
  </section>

  <section class="verhaal" aria-labelledby="verhaal-kop">
    <div class="maat verhaal-grid">
      <figure class="verhaal-beeld reveal">
        <img src={home.verhaal_beeld} alt={home.verhaal_beeld_alt} width="960" height="1200" loading="lazy" data-cms-field="verhaal_beeld" />
        <blockquote data-cms-field="verhaal_quote">{home.verhaal_quote}</blockquote>
      </figure>
      <div class="verhaal-tekst">
        <h2 id="verhaal-kop" class="reveal" data-cms-field="verhaal_titel">{home.verhaal_titel}</h2>
        <p class="reveal" data-cms-field="verhaal_tekst_1">{home.verhaal_tekst_1}</p>
        <p class="reveal" data-cms-field="verhaal_tekst_2">{home.verhaal_tekst_2}</p>
      </div>
    </div>
  </section>

  <section class="reviews" aria-labelledby="reviews-kop">
    <div class="maat reviews-grid">
      <div class="score-kaart reveal">
        <span class="google-g" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        </span>
        <p class="score-getal" aria-label={`Beoordeeld met ${reviews.score} van 5`}>{reviews.score}</p>
        <span class="sterren" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg width="19" height="18" viewBox="0 0 20 19"><path d="M10 .8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.3L10 15.1l-5.7 3.1 1.2-6.3L.8 7.5l6.4-.8Z" fill="currentColor"/></svg>
          ))}
        </span>
        <h2 id="reviews-kop">Wat klanten zeggen</h2>
        <p class="score-sub">Alle {reviews.aantal} Google-reviews geven ons vijf sterren.</p>
        <a class="knop knop-lijn" href={reviews.google_url}>Bekijk alle reviews</a>
      </div>
      <div class="rail-wrap">
        <ul class="rail" data-cms-collection="reviews" tabindex="0" aria-label="Reviews van klanten, horizontaal te scrollen">
          {reviews.items.map((r) => (
            <li data-cms-item={r.id}>
              <span class="sterren klein" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg width="14" height="13" viewBox="0 0 20 19"><path d="M10 .8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.3L10 15.1l-5.7 3.1 1.2-6.3L.8 7.5l6.4-.8Z" fill="currentColor"/></svg>
                ))}
              </span>
              <blockquote data-cms-field="tekst">{r.tekst}</blockquote>
              <p class="review-naam"><span data-cms-field="naam">{r.naam}</span> <span class="review-bron">via Google, {r.wanneer}</span></p>
            </li>
          ))}
        </ul>
        <div class="rail-knoppen">
          <button type="button" class="rail-knop" data-richting="-1" aria-label="Vorige reviews">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 2.5 4.5 8 10 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="rail-knop" data-richting="1" aria-label="Volgende reviews">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.5 11.5 8 6 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="route" id="werkwijze" aria-labelledby="route-kop">
    <div class="maat">
      <h2 id="route-kop" class="reveal" data-cms-field="werkwijze_titel">{home.werkwijze_titel}</h2>
      <p class="route-intro reveal" data-cms-field="werkwijze_tekst">{home.werkwijze_tekst}</p>
      <div class="route-vlak">
        <svg class="route-pad" viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 32 C 90 10, 200 54, 320 32 S 560 10, 680 32 S 920 54, 1000 30" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="7 7" stroke-linecap="round" />
        </svg>
        <ol class="stations" data-cms-collection="werkwijze">
          {werkwijze.map((stap, i) => (
            <li class="station reveal" data-cms-item={stap.id}>
              <span class="station-nr" aria-hidden="true">{i + 1}</span>
              <h3 data-cms-field="titel">{stap.titel}</h3>
              <p data-cms-field="tekst">{stap.tekst}</p>
            </li>
          ))}
        </ol>
        <p class="route-einde reveal">
          <svg width="30" height="28" viewBox="0 0 34 32" aria-hidden="true"><path d="M17 3 32 18h-5v11H7V18H2Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>
          <span data-cms-field="werkwijze_einde">{home.werkwijze_einde}</span>
        </p>
      </div>
      <div class="route-slot">
        <aside class="briefje reveal">
          <span class="briefje-merk"><Merk breedte={46} /></span>
          <h3 data-cms-field="kosten_titel">{home.kosten_titel}</h3>
          <p data-cms-field="werkwijze_kosten">{home.werkwijze_kosten}</p>
        </aside>
        <div class="route-cta reveal">
          <p>Het begint dus gewoon met een kop koffie. Bij u thuis of bij ons aan de Oostmaaslaan.</p>
          <a href="#contact" class="knop knop-vol" data-plan-open data-hb-goal="kennismaking">Plan een kennismaking</a>
          <a href={`tel:${bedrijf.telefoon_link}`} class="route-bel">Of bel {bedrijf.telefoon}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="manifest" aria-labelledby="manifest-kop">
    <div class="maat manifest-strip">
      <span class="manifest-merk reveal"><Merk breedte={124} /></span>
      <h2 id="manifest-kop" class="reveal" data-cms-field="manifest_titel">{home.manifest_titel}</h2>
      <div class="manifest-tekst">
        <p class="reveal" data-cms-field="manifest_tekst_1">{home.manifest_tekst_1}</p>
        <p class="reveal" data-cms-field="manifest_tekst_2">{home.manifest_tekst_2}</p>
      </div>
    </div>
  </section>

  <section class="actueel" id="actueel" aria-labelledby="actueel-kop">
    <div class="maat">
      <h2 id="actueel-kop" class="reveal" data-cms-field="actueel_titel">{home.actueel_titel}</h2>
      <div class="artikelen" data-cms-collection="nieuws">
        <article class="artikel-groot reveal" data-cms-item={hoofdartikel.id}>
          <img src={hoofdartikel.beeld} alt={hoofdartikel.beeld_alt} width="1400" height="933" loading="lazy" data-cms-field="beeld" />
          <div>
            <time datetime={hoofdartikel.datum}>{datumFmt.format(new Date(hoofdartikel.datum))}</time>
            <h3 data-cms-field="titel">{hoofdartikel.titel}</h3>
            <p data-cms-field="tekst">{hoofdartikel.tekst}</p>
          </div>
        </article>
        <div class="artikelen-rest">
          {restartikelen.map((artikel) => (
            <article class="reveal" data-cms-item={artikel.id}>
              <img src={artikel.beeld} alt={artikel.beeld_alt} width="900" height="600" loading="lazy" data-cms-field="beeld" />
              <div>
                <time datetime={artikel.datum}>{datumFmt.format(new Date(artikel.datum))}</time>
                <h3 data-cms-field="titel">{artikel.titel}</h3>
                <p data-cms-field="tekst">{artikel.tekst}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-kop">
    <img src={home.contact_beeld} alt="" width="2100" height="900" loading="lazy" class="contact-achtergrond" />
    <div class="maat contact-inhoud">
      <div class="contact-tekst">
        <h2 id="contact-kop" class="reveal" data-cms-field="contact_titel">{home.contact_titel}</h2>
        <p class="reveal" data-cms-field="contact_tekst">{home.contact_tekst}</p>
        <div class="contact-acties reveal">
          <a href="#contact" class="knop knop-vol" data-plan-open data-hb-goal="kennismaking">Plan een kennismaking</a>
          <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-wit" data-hb-goal="bellen">Bel {bedrijf.telefoon}</a>
        </div>
      </div>
      <aside class="kaartje reveal">
        <span class="kaartje-merk"><Merk breedte={54} /></span>
        <p class="kaartje-naam">{bedrijf.naam}</p>
        <p class="kaartje-motto">{bedrijf.tagline}</p>
        <dl class="kaartje-gegevens">
          <dt>Kantoor</dt>
          <dd>{bedrijf.adres_straat}<br />{bedrijf.adres_plaats}</dd>
          <dt>Telefoon</dt>
          <dd><a href={`tel:${bedrijf.telefoon_link}`}>{bedrijf.telefoon}</a></dd>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></dd>
        </dl>
        <p class="kaartje-voet">KvK {bedrijf.kvk} &middot; AFM {bedrijf.afm} &middot; Kifid {bedrijf.kifid}</p>
      </aside>
    </div>
  </section>

  <dialog id="plan-dialoog">
    <div class="dialoog-merk">
      <span class="dialoog-zegel"><Merk breedte={46} /></span>
      <p class="dialoog-motto">{bedrijf.tagline}</p>
      <p class="dialoog-sub">Liever direct iemand spreken?</p>
      <a href={`tel:${bedrijf.telefoon_link}`}>Bel {bedrijf.telefoon}</a>
    </div>
    <form method="dialog" data-hb-lead>
      <button type="button" class="dialoog-sluit" aria-label="Sluiten">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <h3>Plan een kennismaking</h3>
      <p class="dialoog-intro">Vrijblijvend en kosteloos, bij u thuis of bij ons op kantoor.</p>
      <label>
        Uw naam
        <input type="text" name="naam" autocomplete="name" required />
      </label>
      <label>
        Telefoon of e-mail
        <input type="text" name="contact" autocomplete="tel" required />
      </label>
      <label>
        Waar gaat het over?
        <select name="onderwerp">
          <option>Kennismaking</option>
          {diensten.map((d) => (
            <option>{d.titel}</option>
          ))}
        </select>
      </label>
      <label>
        Uw vraag <span>(niet verplicht)</span>
        <textarea name="bericht" rows="3"></textarea>
      </label>
      <button type="submit" class="knop knop-vol">Plan de kennismaking</button>
    </form>
    <div class="dialoog-succes" hidden>
      <svg width="44" height="41" viewBox="0 0 34 32" aria-hidden="true"><path d="M17 3 32 18h-5v11H7V18H2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <h3>Dank u wel!</h3>
      <p>We nemen binnen één werkdag contact met u op om een moment te vinden dat u schikt.</p>
      <button type="button" class="knop knop-lijn dialoog-sluit-2">Sluiten</button>
    </div>
  </dialog>
</Base>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: 3rem 4rem;
    background: linear-gradient(180deg, var(--ice) 0%, var(--paper) 96%);
  }
  .hero-cirkel {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }
  .hero-cirkel-blauw {
    width: clamp(320px, 42vw, 640px);
    height: clamp(320px, 42vw, 640px);
    background: radial-gradient(circle, rgba(106, 171, 218, 0.3), rgba(106, 171, 218, 0.06) 70%);
    top: -12%;
    right: -8%;
  }
  .hero-cirkel-bruin {
    width: clamp(280px, 36vw, 560px);
    height: clamp(280px, 36vw, 560px);
    background: radial-gradient(circle, rgba(106, 77, 71, 0.28), rgba(106, 77, 71, 0.05) 70%);
    top: 30%;
    right: 20%;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
  }
  h1 {
    font-size: clamp(2.9rem, 8vw, 4.6rem);
    font-weight: 500;
    max-width: 12ch;
  }
  .rust {
    position: relative;
    font-style: italic;
    color: var(--brown);
    margin-left: 0.18em;
    padding-right: 0.06em;
  }
  .rust-lijn {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.22em;
    color: var(--brown);
    overflow: visible;
  }
  h1 .na {
    display: block;
  }
  .regel {
    display: inline-block;
  }
  .intro {
    margin-top: 1.4rem;
    font-size: 1.13rem;
    max-width: 44ch;
  }
  .hero-acties {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-acties .knop {
    padding: 0.8rem 1.35rem;
    font-size: 0.95rem;
  }
  .zekerheden {
    list-style: none;
    margin: 2.8rem auto 0;
    padding: 1.4rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 1.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
  }
  .zekerheden li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .zekerheden svg {
    color: var(--sky-deep);
    flex-shrink: 0;
  }
  .zekerheden li:nth-child(even) svg {
    color: var(--brown);
  }
  .hero-beeld {
    position: relative;
    justify-self: center;
    width: min(84%, 21.5rem);
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: 0 36px 70px -34px rgba(0, 56, 80, 0.45);
  }
  .hero-beeld::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: -1.1rem 1.1rem;
    border-radius: inherit;
    background: var(--brown);
    opacity: 0.9;
    z-index: -1;
  }
  .hero-beeld > img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: 62% center;
    border-radius: inherit;
  }
  .stempel {
    position: absolute;
    left: -2.4rem;
    bottom: 1.6rem;
    width: 7.25rem;
    height: 7.25rem;
    display: grid;
    place-items: center;
    background: var(--paper);
    border-radius: 50%;
    box-shadow: 0 18px 36px -18px rgba(0, 56, 80, 0.45);
  }
  .stempel-merk {
    position: absolute;
  }
  .stempel svg {
    position: absolute;
    inset: 0;
    animation: stempel-draai 28s linear infinite;
  }
  .stempel text {
    font-family: var(--font-tekst);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    fill: var(--navy);
  }
  @keyframes stempel-draai {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stempel svg {
      animation: none;
    }
  }

  section:not(.hero) {
    padding-top: 5.5rem;
  }

  .register-kop {
    display: grid;
    gap: 0.9rem;
    max-width: 56ch;
  }
  h2 {
    font-size: clamp(2rem, 5vw, 2.9rem);
  }
  .register-grid {
    display: grid;
    gap: 3rem;
    margin-top: 2.2rem;
    align-items: start;
  }
  .register-rijen {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .register-rijen > li {
    border-top: 1px solid var(--line);
  }
  .register-rijen > li:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .register-nr {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--brown);
  }
  summary h3 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    font-weight: 500;
    transition: color 0.25s ease, translate 0.25s ease;
  }
  summary:hover h3,
  details[open] summary h3 {
    color: var(--sky-deep);
    translate: 0.4rem 0;
  }
  .register-plus {
    position: relative;
    width: 1.05rem;
    height: 1.05rem;
    align-self: center;
  }
  .register-plus::before,
  .register-plus::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    border-radius: 1px;
    background: var(--brown);
    transition: rotate 0.3s ease;
  }
  .register-plus::after {
    rotate: 90deg;
  }
  details[open] .register-plus::after {
    rotate: 0deg;
  }
  .register-klep {
    overflow: hidden;
  }
  .register-inhoud {
    padding: 0.2rem 0 1.8rem 3.2rem;
    max-width: 34rem;
  }
  .register-inhoud p {
    font-size: 0.98rem;
  }
  .register-inhoud ul {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
  }
  .register-inhoud ul li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .register-inhoud ul svg {
    color: var(--brown);
    flex-shrink: 0;
  }
  .register-inhoud > a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-block: 0.35rem 0.15rem;
    font-weight: 700;
    color: var(--sky-deep);
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
  }
  .register-inhoud > a::after {
    content: '→';
    transition: translate 0.2s ease;
  }
  .register-inhoud > a:hover::after {
    translate: 0.25rem 0;
  }
  .register-beeld {
    display: none;
  }

  .verhaal {
    background: linear-gradient(160deg, #f5ece5, #faf3ed);
    margin-top: 5.5rem;
    padding-block: 5rem 5.5rem;
  }
  .verhaal-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .verhaal-beeld {
    position: relative;
    width: min(100%, 24rem);
    justify-self: center;
  }
  .verhaal-beeld img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: 0 30px 60px -30px rgba(83, 60, 55, 0.5);
  }
  .verhaal-beeld blockquote {
    position: absolute;
    left: -0.75rem;
    right: 2.5rem;
    bottom: -1.75rem;
    background: var(--brown);
