    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    padding: 1.2rem 1.5rem;
    border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgba(83, 60, 55, 0.5);
  }
  .verhaal-tekst h2 {
    margin-bottom: 1.3rem;
  }
  .verhaal-tekst p + p {
    margin-top: 1.05rem;
  }

  .reviews {
    overflow: clip;
  }
  .reviews-grid {
