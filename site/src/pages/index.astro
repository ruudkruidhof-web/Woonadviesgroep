    align-items: center;
  }
  .briefje {
    position: relative;
    background: var(--paper);
    border-radius: var(--radius);
    padding: 2.4rem 1.9rem 1.7rem;
    rotate: -1.1deg;
    box-shadow: 0 30px 60px -28px rgba(0, 20, 30, 0.7);
  }
  .briefje-merk {
    position: absolute;
    top: -1.45rem;
    left: 1.9rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    background: var(--paper);
    border-radius: 50%;
    box-shadow: 0 10px 20px -10px rgba(0, 20, 30, 0.6);
  }
  .briefje h3 {
    font-size: 1.25rem;
  }
  .briefje p {
    margin-top: 0.55rem;
    font-size: 0.98rem;
    color: var(--navy-soft);
  }
  .route-cta p {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: #fff;
    max-width: 24ch;
  }
  .route-cta .knop {
    margin-top: 1.4rem;
    background: #fff;
    color: var(--navy);
  }
  .route-cta .knop:hover {
    background: var(--sky-wash);
  }
  .route-bel {
    display: block;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: #9fbdd2;
    text-decoration: none;
  }
  .route-bel:hover {
    color: #fff;
  }

  .manifest {
    overflow: clip;
  }
  .manifest-strip {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
    border-bottom: 1px solid var(--line);
    padding-bottom: 4rem;
  }
  .manifest-merk {
    display: block;
  }
  .manifest-tekst p {
    font-size: 1.05rem;
    max-width: 46ch;
  }
  .manifest-tekst p + p {
    margin-top: 1rem;
  }

  .artikelen {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.2rem;
  }
  .artikelen img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    transition: scale 0.4s ease;
  }
  .artikelen article:hover img {
    scale: 1.015;
  }
  .artikelen time {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1rem;
    color: var(--brown);
  }
  .artikelen h3 {
    margin-top: 0.45rem;
    font-size: 1.35rem;
    font-weight: 500;
    max-width: 24ch;
  }
  .artikelen p {
    margin-top: 0.55rem;
    font-size: 0.96rem;
    max-width: 46ch;
  }
  .artikelen-rest {
    display: grid;
    gap: 2.5rem;
  }

  .contact {
    position: relative;
    margin-top: 6.5rem;
    padding-block: 5.5rem;
    overflow: hidden;
  }
  .contact-achtergrond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(0, 56, 80, 0.92) 25%, rgba(0, 56, 80, 0.6) 70%, rgba(0, 56, 80, 0.4));
  }
  .contact-inhoud {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .contact h2 {
    color: #fff;
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    max-width: 16ch;
  }
  .contact-tekst > p {
    color: #d7e6f0;
    margin-top: 1rem;
    max-width: 46ch;
  }

  .kaartje {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 2.2rem 2rem 1.8rem;
    box-shadow: 0 40px 70px -30px rgba(0, 20, 30, 0.75);
    rotate: 1deg;
  }
  .kaartje-merk {
    display: block;
  }
  .kaartje-naam {
    margin-top: 1.1rem;
    font-family: var(--font-kop);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
  }
  .kaartje-motto {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1rem;
    color: var(--brown);
    margin-top: 0.3rem;
  }
  .kaartje-gegevens {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.55rem 1rem;
    margin: 1.6rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }
  .kaartje-gegevens dt {
    font-weight: 600;
    color: var(--navy);
  }
  .kaartje-gegevens dd {
    margin: 0;
    color: var(--navy-soft);
  }
  .kaartje-gegevens a {
    color: var(--sky-deep);
    text-decoration: none;
  }
  .kaartje-gegevens a:hover {
    text-decoration: underline;
  }
  .kaartje-voet {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    color: #7f95a5;
  }
  .contact-acties {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.1rem;
  }
  .contact .knop-vol {
    background: #fff;
    color: var(--navy);
  }
  .contact .knop-vol:hover {
    background: var(--sky-wash);
  }
  .knop-wit {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .knop-wit:hover,
  .knop-wit:focus-visible {
    border-color: #fff;
  }
  #plan-dialoog {
    width: min(92vw, 56rem);
    max-height: min(92vh, 46rem);
    margin: auto;
    border: 0;
    border-radius: 22px;
    padding: 0;
    background: var(--paper);
    box-shadow: 0 60px 120px -40px rgba(0, 30, 44, 0.6);
  }
  #plan-dialoog::backdrop {
    background: rgba(0, 30, 44, 0.55);
    backdrop-filter: blur(4px);
  }
  #plan-dialoog[open] {
    display: grid;
  }
  .dialoog-merk {
    display: none;
    flex-direction: column;
    align-items: start;
    background: linear-gradient(160deg, var(--navy), #0d4a66);
    color: #d7e6f0;
    padding: 2.5rem 2.2rem;
  }
  .dialoog-zegel {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    background: var(--paper);
    border-radius: 50%;
  }
  .dialoog-motto {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.3;
    color: #fff;
    margin-top: 1.4rem;
    margin-bottom: auto;
    max-width: 16ch;
  }
  .dialoog-sub {
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .dialoog-merk a {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1.5px solid var(--sky);
    align-self: start;
    margin-top: 0.3rem;
  }
  #plan-dialoog form {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 2.2rem 1.8rem;
  }
  #plan-dialoog form h3 {
    font-size: 1.7rem;
  }
  .dialoog-intro {
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }
  #plan-dialoog label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
  }
  #plan-dialoog label span {
    font-weight: 400;
    color: var(--navy-soft);
  }
  #plan-dialoog input,
  #plan-dialoog select,
  #plan-dialoog textarea {
    font: inherit;
    font-weight: 400;
    color: var(--navy);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
  }
  #plan-dialoog input:focus-visible,
  #plan-dialoog select:focus-visible,
  #plan-dialoog textarea:focus-visible {
    outline: 2px solid var(--sky-deep);
    outline-offset: 1px;
  }
  #plan-dialoog form .knop {
    justify-self: start;
    margin-top: 0.4rem;
  }
  .dialoog-sluit {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
  }
  .dialoog-sluit:hover {
    border-color: var(--sky);
    color: var(--sky-deep);
  }
  .dialoog-succes {
    display: grid;
    justify-items: start;
    gap: 0.8rem;
    padding: 2.6rem 2.2rem;
  }
  .dialoog-succes[hidden] {
    display: none;
  }
  .dialoog-succes svg {
    color: var(--brown);
  }
  .dialoog-succes h3 {
    font-size: 1.6rem;
  }
  .dialoog-succes p {
    max-width: 38ch;
