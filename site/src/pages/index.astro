    padding: 2.2rem 2rem;
  }
  .google-g {
    position: absolute;
    top: 1.6rem;
    right: 1.6rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 10px 24px -12px rgba(0, 56, 80, 0.35);
  }
  .score-getal {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 4.25rem;
    line-height: 1;
    color: var(--navy);
  }
  .sterren {
    display: inline-flex;
    gap: 0.2rem;
    color: #dfa437;
  }
  .score-kaart h2 {
    margin-top: 1rem;
    font-size: 1.65rem;
  }
  .score-sub {
    font-size: 0.98rem;
    max-width: 24ch;
  }
  .score-kaart .knop {
    margin-top: 1rem;
    padding: 0.7rem 1.3rem;
    font-size: 0.93rem;
    background: transparent;
  }
  .rail-wrap {
    min-width: 0;
    margin-inline: calc((100vw - var(--maat)) / -2);
  }
  .rail {
    list-style: none;
    margin: 0;
    padding: 0.5rem calc((100vw - var(--maat)) / 2) 1rem;
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: calc((100vw - var(--maat)) / 2);
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail:focus-visible {
    outline: 2px solid var(--sky-deep);
    outline-offset: -2px;
  }
  .rail li {
    position: relative;
    flex: 0 0 min(82vw, 21.5rem);
    display: grid;
    align-content: start;
    gap: 0.85rem;
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem 1.7rem 1.5rem;
  }
  .rail li::before {
    content: '\201E';
    position: absolute;
    top: -1.3rem;
    right: 1.3rem;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 4.5rem;
    line-height: 1;
    color: var(--sky);
    opacity: 0.55;
    pointer-events: none;
  }
  .rail blockquote {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .review-naam {
    margin-top: auto;
    padding-top: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--navy);
  }
  .review-bron {
    display: block;
    margin-top: 0.15rem;
    font-weight: 400;
    font-size: 0.85rem;
    color: #7f95a5;
  }
  .rail-knoppen {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-inline: calc((100vw - var(--maat)) / 2);
  }
  .rail-knop {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  .rail-knop:hover:not(:disabled) {
    border-color: var(--sky);
    color: var(--sky-deep);
  }
  .rail-knop:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .route {
    position: relative;
    margin-top: 6rem;
    padding-block: 5rem 5.5rem;
    background:
      radial-gradient(120% 90% at 12% 0%, #0d4a66 0%, transparent 60%),
      linear-gradient(165deg, #003850 0%, #012c40 100%);
    color: #cfe0ec;
    overflow: clip;
  }
  .route h2 {
    color: #fff;
  }
  .route-intro {
    margin-top: 1rem;
