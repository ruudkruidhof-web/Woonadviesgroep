---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Bewijs from '../components/v3/Bewijs.astro';
import Kamers from '../components/v3/Kamers.astro';
import BoogKamer from '../components/v3/BoogKamer.astro';
import Kaartregel from '../components/v3/Kaartregel.astro';
import Overstap from '../components/v3/Overstap.astro';
import diensten from '../content/v3-diensten.json';
import kaarten from '../content/v3-vergelijkingskaarten.json';
import teksten from '../content/teksten/v3-paginas.json';

const d = diensten.find((x) => x.id === 'hypotheken')!;
const p = d.pagina;
const kaart = kaarten.kaarten.find((k) => k.id === p.kaart)!;
const situaties = p.situaties.map((s) => ({ ...s, bel: s.id === 'scheiding' }));
---
<Pagina titel={d.titel} omschrijving={p.lead}>
  <Opening titel={d.titel} lead={p.lead} stappen={[{ href: '/#diensten', label: teksten.dienst.kruimel }]} onderwerp={d.titel}>
    <Bewijs items={p.bewijs} />
  </Opening>

  <Kamers id="situaties" titel={p.situaties_titel} lead={p.situaties_lead} items={situaties} knop={p.situaties_knop} onderwerp={d.titel} />

  <section class="advies sectie" aria-labelledby="advies-titel">
    <div class="maat midden">
      <h2 id="advies-titel" data-regels>{p.advies_titel}</h2>
      <p class="lead" data-onthul>{p.advies_lead}</p>
      <div class="tekst" data-onthul>
        {p.advies.map((a) => <p>{a}</p>)}
      </div>
    </div>
  </section>

  <BoogKamer id="kosten" kleur="navy" labelledby="kosten-titel">
    <h2 id="kosten-titel" data-regels>{p.kosten_titel}</h2>
    <p class="lead" data-onthul>{p.kosten_lead}</p>
    <div class="tekst" data-onthul>
      <p>{p.kosten}</p>
      <p>{p.feiten[2]}.</p>
    </div>
    {kaarten.toon_prijzen && (
      <div class="prijzen" data-onthul>
        <h3>{teksten.kaart.prijzen_titel}</h3>
        <dl>
          {kaart.prijzen.map((x) => (
            <div>
              <dt>{x.situatie}</dt>
              <dd class="cijfer">{x.bedrag}</dd>
            </div>
          ))}
        </dl>
        <p>{teksten.kaart.prijzen_uitleg}</p>
      </div>
    )}
    <div class="kaart" data-onthul>
      <Kaartregel ids={[p.kaart]} licht midden />
    </div>
  </BoogKamer>

  <Overstap volgende={p.volgende} onderwerp={d.titel} midden />
</Pagina>

<style>
  .midden {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  h2 {
    max-width: 20ch;
    text-wrap: balance;
  }
  .lead {
    max-width: 36rem;
    margin-top: 1.5rem;
    text-wrap: balance;
  }
  .tekst {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 2rem;
  }
  .tekst p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .advies {
    padding-block: calc(var(--sectie) * 0.45) calc(var(--sectie) * 0.85);
  }
  .prijzen {
    width: min(100%, 30rem);
    margin-top: 2.5rem;
    text-align: left;
  }
  .prijzen h3 {
    font-size: var(--h3);
    text-align: center;
  }
  .prijzen dl {
    margin-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .prijzen dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .prijzen dd {
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }
  .prijzen p {
    margin-top: 0.75rem;
    font-size: var(--klein);
    text-align: center;
  }
  .kaart {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
</style>
