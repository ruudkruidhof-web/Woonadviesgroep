---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Bewijs from '../components/v3/Bewijs.astro';
import Situaties from '../components/v3/Situaties.astro';
import Uitspraak from '../components/v3/Uitspraak.astro';
import Kostenkamer from '../components/v3/Kostenkamer.astro';
import Kostenkaart from '../components/v3/Kostenkaart.astro';
import Einde from '../components/v3/Einde.astro';
import { kostenrijen } from '../components/v3/merk';
import diensten from '../content/v3-diensten.json';
import teksten from '../content/teksten/v3-paginas.json';

const d = diensten.find((x) => x.id === 'hypotheken')!;
const p = d.pagina;
---
<Pagina titel={d.titel} omschrijving={p.omschrijving}>
  <Opening titel={d.titel} lead={p.lead} stappen={[{ href: '/#diensten', label: teksten.dienst.kruimel }]} onderwerp={d.titel}>
    <Bewijs items={p.bewijs} />
  </Opening>

  <Situaties titel={p.situaties_titel} items={p.situaties} knop={p.situaties_knop} onderwerp={d.titel} />

  <Uitspraak id="advies" titel={p.advies_titel} lead={p.advies_lead} regels={p.advies} staart={p.advies_staart} />

  <Kostenkamer titel={p.kosten_titel} lead={p.kosten_lead} tekst={p.kosten}>
    <Kostenkaart kop={d.titel} rijen={kostenrijen(p.kaart)} kaarten={[p.kaart]} prijzen={[p.kaart]} />
  </Kostenkamer>

  <Einde volgende={teksten.dienst.volgende} onderwerp={d.titel} />
</Pagina>
