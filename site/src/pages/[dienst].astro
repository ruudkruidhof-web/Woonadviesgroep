---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Bewijs from '../components/v3/Bewijs.astro';
import Kamers from '../components/v3/Kamers.astro';
import BoogKamer from '../components/v3/BoogKamer.astro';
import Prijzen from '../components/v3/Prijzen.astro';
import Kaartregel from '../components/v3/Kaartregel.astro';
import Overstap from '../components/v3/Overstap.astro';
import Icoon from '../components/v3/Icoon.astro';
import diensten from '../content/v3-diensten.json';
import kaarten from '../content/v3-vergelijkingskaarten.json';
import teksten from '../content/teksten/v3-paginas.json';

export function getStaticPaths() {
  return diensten.filter((d) => d.id !== 'hypotheken').map((d) => ({ params: { dienst: d.id }, props: { d } }));
}

const { d } = Astro.props;
const p = d.pagina;
const t = teksten.dienst;
const k = teksten.kaart;
const kaart = kaarten.kaarten.find((x) => x.id === p.kaart);
const [eerste, ...rest] = p.alineas;
const verwachten = kaart && [
  { id: `${d.id}-doen`, titel: k.dienst, tekst: kaart.dienst_uitleg, lijst: kaart.groepen.flatMap((g) => g.wel) },
  { id: `${d.id}-vergelijking`, titel: k.vergelijking, tekst: kaart.vergelijking },
  { id: `${d.id}-onderhoud`, titel: k.onderhoud, tekst: `${kaart.onderhoud_kort}. ${kaart.onderhoud_uitleg}` },
];
const tarief = teksten.dienstverlening.beloning[0];
---
<Pagina titel={d.titel} omschrijving={p.lead}>
  <Opening titel={d.titel} lead={p.lead} stappen={[{ href: '/#diensten', label: t.kruimel }]} onderwerp={d.titel}>
    <Bewijs />
  </Opening>

  <section class="uitleg sectie" aria-labelledby={p.uitleg_titel ? 'uitleg-titel' : undefined} aria-label={p.uitleg_titel ? undefined : `Meer over ${d.titel.toLowerCase()}`}>
    <div class="maat midden">
      {p.uitleg_titel && <h2 id="uitleg-titel" data-regels>{p.uitleg_titel}</h2>}
      {p.vragen && (
        <ol class="vragen">
          {p.vragen.map((v) => <li data-onthul>{v}</li>)}
        </ol>
      )}
      <p class="lead" data-onthul>{eerste}</p>
      {rest.length > 0 && (
        <div class="tekst" data-onthul>
          {rest.map((a) => <p>{a}</p>)}
        </div>
      )}
      {!kaart && (
        <ul class="situaties" data-onthul>
          {d.situaties.map((s) => (
            <li>
              <Icoon naam="dak" maat={11} />
              {s}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {verwachten && <Kamers id="verwachten" titel={t.verwachten_titel} items={verwachten} />}

  <BoogKamer id="kosten" kleur="navy" labelledby="kosten-titel">
    {kaart ? (
      <Fragment>
        <h2 id="kosten-titel" data-regels>{t.kosten_titel}</h2>
        <p class="lead" data-onthul>{k.kosten_tekst}.</p>
        <div class="tekst" data-onthul>
          <p>{tarief.tekst}</p>
        </div>
        <Prijzen kaart={kaart.id} />
        <div class="kaart" data-onthul>
          <Kaartregel ids={[kaart.id]} licht midden />
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <h2 id="kosten-titel" data-regels>{p.beloning_titel}</h2>
        <div class="tekst" data-onthul>
          {p.beloning.map((b) => <p>{b}</p>)}
        </div>
      </Fragment>
    )}
  </BoogKamer>

  <Overstap volgende={t.volgende} onderwerp={d.titel} midden />
</Pagina>

<style>
  .midden {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  h2 {
    max-width: 20ch;
    text-wrap: balance;
  }
  .lead {
    max-width: 38rem;
    margin-top: 1.5rem;
    text-wrap: pretty;
  }
  .uitleg {
    padding-top: calc(var(--sectie) * 0.35);
  }
  .uitleg .lead:first-child {
    margin-top: 0;
  }
  .uitleg h2 + .lead {
    margin-top: 1.75rem;
  }
  .vragen {
    display: grid;
    max-width: 44rem;
    margin: 0 0 clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding: 0;
    list-style: none;
  }
  .vragen li {
    font-family: var(--font-kop);
    font-size: var(--h2-blok);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--navy);
    text-wrap: balance;
  }
  .vragen li + li::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1.5px;
    margin: clamp(1.5rem, 1.2rem + 1vw, 2.25rem) auto;
    background: var(--sky-deep);
    opacity: 0.5;
  }
  .tekst {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 2rem;
  }
  .tekst p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .situaties {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2rem;
    max-width: 44rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .situaties li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--navy);
  }
  .situaties :global(.dak) {
    color: var(--sky-deep);
  }
  .kaart {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
</style>
