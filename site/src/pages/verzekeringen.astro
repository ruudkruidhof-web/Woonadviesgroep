---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Bewijs from '../components/v3/Bewijs.astro';
import Kostenkamer from '../components/v3/Kostenkamer.astro';
import Kostenkaart from '../components/v3/Kostenkaart.astro';
import Einde from '../components/v3/Einde.astro';
import { huis, kostenrijen } from '../components/v3/merk';
import diensten from '../content/v3-diensten.json';
import teksten from '../content/teksten/v3-paginas.json';

const d = diensten.find((x) => x.id === 'verzekeringen')!;
const p = d.pagina;
const t = teksten.dienst;
const [binnen, midden, buiten] = [d.situaties[2], d.situaties[1], d.situaties[0]];
const bogen = [
  { straal: 260, woord: buiten },
  { straal: 205, woord: midden },
  { straal: 150, woord: binnen },
];
---
<Pagina titel={d.titel} omschrijving={p.omschrijving}>
  <Opening titel={d.titel} lead={p.lead} stappen={[{ href: '/#diensten', label: t.kruimel }]} onderwerp={d.titel}>
    <Bewijs />
  </Opening>

  <section class="af kamer" id="afdekken" aria-labelledby="af-titel" data-kamer>
    <div class="maat af-vak">
      <div class="af-tekst">
        <h2 id="af-titel" data-regels>{p.uitleg_titel}</h2>
        <p class="af-lead" data-onthul>{p.alineas[0]}</p>
        <p data-onthul>{p.alineas[1]}</p>
      </div>

      <div class="af-figuur">
        <svg viewBox="0 0 560 420" aria-hidden="true" focusable="false" data-teken>
          <path d="M0 400H560" />
          {bogen.map((b) => (
            <path d={`M${280 - b.straal} 400A${b.straal} ${b.straal} 0 0 1 ${280 + b.straal} 400`} />
          ))}
          <path class="af-huis" d={huis} transform="translate(211.43 279.46) scale(0.2679)" />
        </svg>
        <ul>
          {bogen.map((b) => (
            <li style={`--y: ${(((400 - b.straal) / 420) * 100).toFixed(2)}%`}>{b.woord}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Kostenkamer kleur="navy" boog titel={t.kosten_titel} lead={`${teksten.kaart.kosten_tekst}.`} tekst={teksten.werkwijze.stappen[1].kosten.tekst}>
    <Kostenkaart kop={d.titel} rijen={kostenrijen(p.kaart)} kaarten={[p.kaart]} prijzen={[p.kaart]} />
  </Kostenkamer>

  <Einde volgende={t.volgende} onderwerp={d.titel} />
</Pagina>

<style>
  .af {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    background: var(--wash-warm);
  }
  .af-vak {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .af h2 {
    max-width: 11ch;
    font-size: var(--h2);
    line-height: 1.05;
    text-wrap: balance;
  }
  .af-tekst p {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .af-tekst .af-lead {
    max-width: 24ch;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-family: var(--font-kop);
    font-size: var(--h3-kaart);
    line-height: 1.2;
    color: var(--brown);
    text-wrap: balance;
  }

  .af-figuur {
    position: relative;
    width: min(100%, 35rem);
    margin-inline: auto;
  }
  .af-figuur svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--brown);
    stroke-width: 1.5px;
  }
  .af-figuur path {
    vector-effect: non-scaling-stroke;
  }
  .af-figuur .af-huis {
    stroke: var(--navy);
  }
  .af-figuur ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .af-figuur li {
    position: absolute;
    top: var(--y);
    left: 50%;
    padding-inline: 0.75rem;
    background: var(--wash-warm);
    font-family: var(--font-kop);
    font-size: clamp(0.9375rem, 0.8rem + 0.6vw, 1.25rem);
    line-height: 1.3;
    color: var(--navy);
    white-space: nowrap;
    translate: -50% -50%;
  }

  @media (min-width: 64rem) {
    .af-vak {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
    .af-figuur {
      margin-inline: auto 0;
    }
  }
</style>
