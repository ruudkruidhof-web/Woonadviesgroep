---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Kamers from '../components/v3/Kamers.astro';
import BoogKamer from '../components/v3/BoogKamer.astro';
import Overstap from '../components/v3/Overstap.astro';
import Merk from '../components/Merk.astro';
import teksten from '../content/teksten/v3-paginas.json';

const t = teksten.over;
const mensen = t.mensen.map((m) => ({ id: `over-${m.kort.toLowerCase()}`, titel: m.naam, tekst: t.rol, citaat: m.reviews[0] }));
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <Opening titel={t.titel} hier={t.meta_titel} lead={t.lead}>
    <figure class="foto">
      <img
        src="/beeld/adviseurs-v3-800.webp"
        srcset="/beeld/adviseurs-v3-800.webp 800w, /beeld/adviseurs-v3-1400.webp 1400w"
        sizes="(min-width: 48rem) 26rem, calc(100vw - 4rem)"
        alt={t.beeld_alt}
        width="800"
        height="800"
      />
      <figcaption>{t.beeld_onderschrift}</figcaption>
    </figure>
  </Opening>

  <section class="kern sectie" aria-label="Waar we voor staan">
    <div class="maat midden">
      <span class="zegel"><Merk breedte={48} /></span>
      <p data-onthul>{t.kern}</p>
    </div>
  </section>

  <Kamers id="mensen" titel={t.mensen_titel} items={mensen} />

  <BoogKamer id="verwachten" kleur="navy" labelledby="verwachten-titel">
    <h2 id="verwachten-titel" data-regels>{t.verwachten_titel}</h2>
    <div class="tekst" data-onthul>
      {t.verwachten.map((a) => <p>{a}</p>)}
    </div>
  </BoogKamer>

  <Overstap volgende={teksten.afsluiter} midden />
</Pagina>

<style>
  .foto {
    width: min(100%, 26rem);
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) 0 0;
  }
  .foto img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50% 50% var(--radius) var(--radius) / 34% 34% var(--radius) var(--radius);
  }
  .foto figcaption {
    margin-top: 0.9rem;
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }
  .midden {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .kern {
    padding-block: calc(var(--sectie) * 0.4) 0;
  }
  .zegel {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .kern p {
    max-width: 40rem;
    margin-top: 2rem;
    font-family: var(--font-kop);
    font-size: var(--h3);
    line-height: 1.4;
    color: var(--navy);
    text-wrap: balance;
  }
  h2 {
    max-width: 20ch;
    text-wrap: balance;
  }
  .tekst {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 2rem;
  }
  .tekst p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
</style>
