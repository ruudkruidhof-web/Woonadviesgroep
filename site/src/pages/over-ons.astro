---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Bewijs from '../components/v3/Bewijs.astro';
import Duo from '../components/v3/Duo.astro';
import Uitspraak from '../components/v3/Uitspraak.astro';
import Einde from '../components/v3/Einde.astro';
import teksten from '../content/teksten/v3-paginas.json';

const t = teksten.over;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <Opening titel={t.titel} hier={t.meta_titel} lead={t.lead}>
    <Bewijs items={t.bewijs} />
  </Opening>

  <Duo titel={t.mensen_titel} mensen={t.mensen} rol={t.rol} alt={t.beeld_alt} />

  <Uitspraak id="verwachten" kleur="navy" groot titel={t.verwachten_titel} regels={t.beloftes} slotregel={t.beloftes_slot} />

  <Einde volgende={teksten.afsluiter} />
</Pagina>
