---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/v3/Kop.astro';
import Voet from '../../components/v3/Voet.astro';
import Icoon from '../../components/v3/Icoon.astro';
import bedrijf from '../../content/bedrijf.json';
import '../../components/v3/v3.css';
---
<Base titel="Volgt na opdracht | WoonAdvies Groep" omschrijving="Deze pagina werken we uit na opdracht." thema="v3" basis="/v3" variant="v3" noindex eigenKader>
  <Kop slot="kop" />
  <section class="volgt sectie">
    <div class="maat">
      <h1>Deze pagina volgt na opdracht</h1>
      <p class="lead">In dit concept laten we eerst de homepage zien. Deze pagina werken we uit zodra we samen verder gaan.</p>
      <div class="volgt-acties">
        <a href="/v3" class="knop knop-vol">Terug naar de homepage <Icoon naam="dak" maat={12} /></a>
        <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink"><Icoon naam="bel" maat={15} /> <span>Bel <span class="cijfer">{bedrijf.telefoon}</span></span></a>
      </div>
    </div>
  </section>
  <Voet slot="voet" />
</Base>

<style>
  .volgt {
    min-height: 70svh;
  }
  .volgt h1 {
    max-width: 14ch;
    font-size: var(--h2);
  }
  .volgt .lead {
    max-width: 34rem;
    margin-top: 1.25rem;
  }
  .volgt-acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }
</style>
