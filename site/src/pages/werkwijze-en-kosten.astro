---
import Pagina from '../components/v3/Pagina.astro';
import PaginaKop from '../components/v3/PaginaKop.astro';
import Vergelijkingstabel from '../components/v3/Vergelijkingstabel.astro';
import Citaat from '../components/v3/Citaat.astro';
import Overstap from '../components/v3/Overstap.astro';
import { huis, huisViewBox } from '../components/v3/merk';
import teksten from '../content/teksten/v3-paginas.json';
import kaarten from '../content/v3-vergelijkingskaarten.json';

const t = teksten.werkwijze;
const k = teksten.kaart;
const beloning = teksten.dienstverlening.beloning;
const laatste = t.stappen.length - 1;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <PaginaKop titel={t.titel} lead={t.lead}>
    <nav class="mini" aria-label={t.mini_label}>
      <ol>
        {t.stappen.map((s, i) => (
          <li class:list={{ 'mini-thuis': i === laatste }}>
            {i === laatste && (
              <svg class="mini-huis" viewBox={huisViewBox} aria-hidden="true"><path d={huis} /></svg>
            )}
            <a href={`#${s.id}`}>
              <span class="mini-naam">{s.titel}</span>
              <span class="mini-kost">{s.kosten.kort}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </PaginaKop>

  <section class="ww band" aria-labelledby="ww-titel">
    <div class="maat">
      <h2 id="ww-titel" class="sr-alleen">{t.route_titel}</h2>
      <div class="ww-banen" aria-hidden="true">
        <span>{t.banen.wij}</span>
        <span>{t.banen.jij}</span>
        <span>{t.banen.kosten}</span>
      </div>
      <ol class="ww-route">
        {t.stappen.map((s, i) => (
          <li class="ww-stap" id={s.id} data-ww-stap>
            {i !== laatste && <span class="ww-lijn" aria-hidden="true"><span data-ww-vol></span></span>}
            <span class:list={['ww-nr', { 'ww-thuis': i === laatste }]} aria-hidden="true">
              {i === laatste ? <svg viewBox={huisViewBox}><path d={huis} /></svg> : i + 1}
            </span>
            <h3>
              {i !== laatste && <span class="sr-alleen">Stap {i + 1}, </span>}
              {s.titel}
            </h3>
            <div class="ww-baan ww-wij">
              <p class="ww-label">{t.banen.wij}</p>
              <p>{s.tekst}</p>
              {s.extra && (
                <details class="ww-meer">
                  <summary>{s.extra_titel}</summary>
                  <p>{s.extra}</p>
                </details>
              )}
            </div>
            <div class="ww-baan ww-jij">
              <p class="ww-label">{t.banen.jij}</p>
              {s.jij.map((j) => (
                <div class="ww-punt">
                  <h4>{j.titel}</h4>
                  <p>{j.tekst}</p>
                </div>
              ))}
            </div>
            <div class="ww-baan ww-kosten">
              <p class="ww-label">{t.banen.kosten}</p>
              <p class="ww-kort">{s.kosten.kort}</p>
              <p>{s.kosten.tekst}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="ww-citaat" data-onthul>
        <Citaat id={t.citaat} />
      </div>
    </div>
  </section>

  <section class="ww-blok" id="kosten" aria-labelledby="kosten-titel">
    <div class="maat">
      <h2 id="kosten-titel">{t.kosten_titel}</h2>
      <p class="ww-intro">{t.kosten_intro}</p>
      <dl class="ww-nota" data-onthul>
        {beloning.map((b) => (
          <div>
            <dt>{b.titel}</dt>
            <dd>{b.tekst}</dd>
          </div>
        ))}
      </dl>
      {kaarten.toon_prijzen && (
        <div class="ww-prijzen">
          <h3>{k.prijzen_titel}</h3>
          <dl>
            {kaarten.kaarten.map((x) => (
              <div>
                <dt>{x.titel}</dt>
                <dd class="cijfer">{x.prijs_kort}</dd>
              </div>
            ))}
          </dl>
          <p>{k.prijzen_uitleg}</p>
        </div>
      )}
    </div>
  </section>

  <section class="ww-blok" id="vergelijkingskaarten" aria-labelledby="kaarten-titel">
    <div class="maat">
      <h2 id="kaarten-titel">{t.kaarten_titel}</h2>
      <p class="ww-intro">{kaarten.uitleg}</p>
      <div class="ww-tabel" data-onthul>
        <Vergelijkingstabel />
      </div>
    </div>
  </section>

  <Overstap volgende={t.volgende} />
</Pagina>

<style>
  .mini {
    --gat: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    margin-top: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
  }
  .mini ol {
    display: grid;
    padding: 0;
    list-style: none;
  }
  .mini li {
    position: relative;
    padding: 0 0 1.25rem 1.75rem;
  }
  .mini li::before {
    content: '';
    position: absolute;
    top: 0.62rem;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--navy);
  }
  .mini li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0.62rem;
    left: 3px;
    width: 1px;
    height: 100%;
    background: var(--navy);
    transform-origin: top;
  }
  .mini-thuis::before {
    display: none;
  }
  .mini-huis {
    position: absolute;
    top: 0.25rem;
    left: -0.45rem;
    width: 1.3rem;
    height: auto;
    overflow: visible;
  }
  .mini-huis path {
    fill: var(--navy);
  }
  .mini a {
    display: grid;
    gap: 0.2rem;
    min-height: 2.75rem;
    color: var(--navy);
    text-decoration: none;
  }
  .mini-naam {
    font-family: var(--font-kop);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s ease;
  }
  .mini a:hover .mini-naam {
    text-decoration-color: currentColor;
  }
  .mini-kost {
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }

  .ww {
    --nr: clamp(2.75rem, 2.2rem + 2vw, 4.25rem);
    --nr-breed: 3rem;
    --kolom: clamp(1.25rem, 0.8rem + 1.6vw, 2.75rem);
    --tussen: clamp(3rem, 2.25rem + 3vw, 5rem);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }
  .ww-banen {
    display: none;
  }
  .ww-route {
    display: grid;
    gap: var(--tussen);
    padding: 0;
    list-style: none;
  }
  .ww-stap {
    position: relative;
    display: grid;
    grid-template-columns: var(--nr-breed) minmax(0, 1fr);
    column-gap: var(--kolom);
    scroll-margin-top: calc(var(--kop-hoogte) + 4rem);
  }
  .ww-nr {
    grid-row: 1;
    font-family: var(--font-kop);
    font-size: var(--nr);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 0.85;
    text-align: center;
    color: var(--sky-deep);
    transition: color 0.45s var(--uit);
  }
  .ww-stap.bereikt .ww-nr {
    color: var(--navy);
  }
  .ww-thuis svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ww-thuis path {
    fill: color-mix(in srgb, var(--navy) 10%, var(--sky-wash));
    stroke: var(--navy);
    stroke-width: 12;
    stroke-linejoin: round;
    transition: fill 0.45s var(--uit);
  }
  .ww-stap.bereikt .ww-thuis path {
    fill: var(--navy);
  }
  .ww-lijn {
    position: absolute;
    top: calc(var(--nr) * 0.85 + 0.75rem);
    left: calc(var(--nr-breed) / 2);
    width: 1.5px;
    height: calc(100% + var(--tussen) - var(--nr) * 0.85 - 1.5rem);
    translate: -50% 0;
    background: color-mix(in srgb, var(--navy) 16%, transparent);
  }
  .ww-lijn span {
    display: block;
    height: 100%;
    background: var(--navy);
    transform-origin: top;
  }
  .ww-stap h3 {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    font-size: var(--h3-kaart);
    line-height: 1.1;
  }
  .ww-baan {
    grid-column: 2;
    margin-top: 1.5rem;
  }
  .ww-label {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--tekst-zacht);
  }
  .ww-wij p:not(.ww-label) {
    font-size: 1rem;
    line-height: 1.65;
  }
  .ww-meer {
    margin-top: 0.5rem;
  }
  .ww-meer summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 700;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, var(--navy) 30%, transparent);
  }
  .ww-meer summary::-webkit-details-marker {
    display: none;
  }
  .ww-meer summary::after {
    content: '';
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.15em;
    transition: rotate 0.3s var(--uit), translate 0.3s var(--uit);
  }
  .ww-meer[open] summary::after {
    rotate: 225deg;
    translate: 0 0.15em;
  }
  .ww-meer summary:hover {
    text-decoration-color: currentColor;
  }
  .ww-punt + .ww-punt {
    margin-top: 1rem;
  }
  .ww-jij h4 {
    font-family: var(--font-tekst);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--navy);
  }
  .ww-jij .ww-punt p {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .ww-kort {
    font-family: var(--font-kop);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--navy);
  }
  .ww-kosten > p:last-child {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--tekst-zacht);
  }
  .ww-citaat {
    max-width: 40rem;
    margin: var(--tussen) 0 0 calc(var(--nr-breed) + var(--kolom));
    padding-top: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    border-top: 1px solid var(--vel-rand);
  }

  .ww-blok {
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .ww-blok + .ww-blok .maat {
    padding-top: clamp(3rem, 2.5rem + 2.5vw, 5rem);
    border-top: 1px solid var(--vel-rand);
  }
  .ww-blok h2 {
    font-size: var(--h2-blok);
    line-height: 1.1;
  }
  .ww-intro {
    max-width: 40rem;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .ww-nota {
    display: grid;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border: 1px solid var(--vel-rand);
    border-radius: 2px;
    background: #fff;
  }
  .ww-nota > div {
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem);
  }
  .ww-nota > div + div {
    border-top: 1px solid var(--line);
  }
  .ww-nota dt {
    font-family: var(--font-kop);
    font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.75rem);
    line-height: 1.15;
    color: var(--navy);
  }
  .ww-nota dd {
    max-width: 34rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.65;
  }
  .ww-prijzen {
    margin-top: 2rem;
  }
  .ww-prijzen h3 {
    font-size: 1.375rem;
  }
  .ww-prijzen dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .ww-prijzen p {
    margin-top: 0.75rem;
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }
  .ww-tabel {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mini li:not(:last-child)::after {
      animation: mini-lijn-v 0.7s var(--uit) both;
    }
    .mini li:nth-child(2)::after {
      animation-delay: 0.15s;
    }
    .mini li:nth-child(3)::after {
      animation-delay: 0.3s;
    }
    .mini li {
      animation: mini-in 0.6s var(--uit) both;
    }
    .mini li:nth-child(2) {
      animation-delay: 0.12s;
    }
    .mini li:nth-child(3) {
      animation-delay: 0.24s;
    }
    .mini li:nth-child(4) {
      animation-delay: 0.36s;
    }
  }
  @keyframes mini-lijn-v {
    from {
      scale: 1 0;
    }
  }
  @keyframes mini-lijn-h {
    from {
      scale: 0 1;
    }
  }
  @keyframes mini-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  @media (min-width: 48rem) {
    .mini ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--gat);
    }
    .mini li {
      padding: 1.5rem 0 0;
    }
    .mini li::before {
      top: -3px;
    }
    .mini li:not(:last-child)::after {
      top: 0;
      left: 0;
      width: calc(100% + var(--gat));
      height: 1px;
      transform-origin: left;
      animation-name: mini-lijn-h;
    }
    .mini-huis {
      top: -0.7rem;
      left: -0.55rem;
      width: 1.6rem;
    }
    .ww-nota {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ww-nota > div + div {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  @media (min-width: 64rem) {
    .ww {
      --nr-breed: 4rem;
    }
    .ww-banen {
      position: sticky;
      top: var(--kop-zicht);
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
      column-gap: var(--kolom);
      margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
      padding: 0.9rem 0 0.9rem calc(var(--nr-breed) + var(--kolom));
      border-bottom: 1px solid var(--vel-rand);
      background: var(--sky-wash);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--tekst-zacht);
      transition: top 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .ww-stap {
      grid-template-columns: var(--nr-breed) minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
    }
    .ww-stap h3 {
      grid-column: 2 / -1;
    }
    .ww-baan {
      grid-row: 2;
      margin-top: 1.25rem;
    }
    .ww-jij {
      grid-column: 3;
    }
    .ww-kosten {
      grid-column: 4;
    }
    .ww-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const stappen = gsap.utils.toArray<HTMLElement>('[data-ww-stap]');
    stappen.forEach((stap, i) => {
      ScrollTrigger.create({
        trigger: stap,
        start: 'top 62%',
        onEnter: () => stap.classList.add('bereikt'),
        onLeaveBack: () => stap.classList.remove('bereikt'),
      });
      const vol = stap.querySelector('[data-ww-vol]');
      const volgende = stappen[i + 1];
      if (vol && volgende) {
        gsap.fromTo(
          vol,
          { scaleY: 0 },
          { scaleY: 1, ease: 'none', scrollTrigger: { trigger: stap, start: 'top 62%', endTrigger: volgende, end: 'top 62%', scrub: 0.5 } },
        );
      }
    });
    return () => stappen.forEach((stap) => stap.classList.remove('bereikt'));
  });
</script>
