---
import Pagina from '../components/v3/Pagina.astro';
import PaginaKop from '../components/v3/PaginaKop.astro';
import Paragraaf from '../components/v3/Paragraaf.astro';
import Vergelijkingstabel from '../components/v3/Vergelijkingstabel.astro';
import Citaat from '../components/v3/Citaat.astro';
import Overstap from '../components/v3/Overstap.astro';
import { huis, huisViewBox } from '../components/v3/merk';
import teksten from '../content/teksten/v3-paginas.json';
import kaarten from '../content/v3-vergelijkingskaarten.json';

const t = teksten.werkwijze;
const k = teksten.kaart;
const laatste = t.stappen.length - 1;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <PaginaKop titel={t.titel} lead={t.lead} feiten={t.feiten} />

  <section class="ww" aria-labelledby="ww-titel">
    <div class="maat">
      <h2 id="ww-titel" class="ww-kop">{t.route_titel}</h2>
      <div class="ww-banen" aria-hidden="true">
        <span>{t.banen.wij}</span>
        <span>{t.banen.jij}</span>
        <span>{t.banen.kosten}</span>
      </div>
      <ol class="ww-route">
        {t.stappen.map((s, i) => (
          <li class="ww-stap" data-ww-stap>
            {i !== laatste && <span class="ww-lijn" aria-hidden="true"><span data-ww-vol></span></span>}
            <span class:list={['ww-merk', { 'ww-thuis': i === laatste }]} aria-hidden="true">
              {i === laatste ? (
                <svg viewBox={huisViewBox}><path d={huis} /></svg>
              ) : (
                <span class="cijfer">{i + 1}</span>
              )}
            </span>
            <h3>
              {i !== laatste && <span class="sr-alleen">Stap {i + 1}, </span>}
              {s.titel}
            </h3>
            <div class="ww-baan ww-wij">
              <p class="ww-label">{t.banen.wij}</p>
              <p>{s.tekst}</p>
              {s.extra && <p>{s.extra}</p>}
            </div>
            <div class="ww-baan ww-jij">
              <p class="ww-label">{t.banen.jij}</p>
              {s.jij.map((j) => (
                <div class="ww-punt">
                  <h4>{j.titel}</h4>
                  <p>{j.tekst}</p>
                </div>
              ))}
            </div>
            <div class="ww-baan ww-kosten">
              <p class="ww-label">{t.banen.kosten}</p>
              <p class="ww-kort">{s.kosten.kort}</p>
              <p>{s.kosten.tekst}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ww-citaat kamer" aria-label="Wat een klant zegt">
    <div class="maat" data-onthul>
      <Citaat id={t.citaat} groot />
    </div>
  </section>

  <Paragraaf id="kosten" titel={t.kosten_titel}>
    <p slot="kant">{t.kosten_intro}</p>
    <div class="ww-nota" data-onthul>
      <dl>
        {t.kosten_regels.map((r) => (
          <div>
            <dt>{r.wat}</dt>
            <dd class="ww-hoe">{r.hoe}</dd>
            {r.noot && <dd class="ww-noot">{r.noot}</dd>}
          </div>
        ))}
      </dl>
      {kaarten.toon_prijzen && (
        <div class="ww-prijzen">
          <h3>{k.prijzen_titel}</h3>
          <dl>
            {kaarten.kaarten.map((x) => (
              <div>
                <dt>{x.titel}</dt>
                <dd class="ww-hoe cijfer">{x.prijs_kort}</dd>
              </div>
            ))}
          </dl>
          <p class="ww-noot">{k.prijzen_uitleg}</p>
        </div>
      )}
    </div>
  </Paragraaf>

  <Paragraaf id="vergelijkingskaarten" titel={t.kaarten_titel}>
    <p slot="kant">{kaarten.uitleg}</p>
    <div data-onthul>
      <Vergelijkingstabel />
    </div>
  </Paragraaf>

  <Overstap volgende={t.volgende} />
</Pagina>

<style>
  .ww {
    --merk: 2.75rem;
    --kolom: clamp(1.25rem, 0.8rem + 1.6vw, 2.75rem);
    --tussen: clamp(3rem, 2.25rem + 3vw, 5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .ww-kop {
    font-size: var(--h2-blok);
    line-height: 1.1;
  }
  .ww-banen {
    display: none;
  }
  .ww-route {
    display: grid;
    gap: var(--tussen);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: 0;
    list-style: none;
  }
  .ww-stap {
    position: relative;
    display: grid;
    grid-template-columns: var(--merk) minmax(0, 1fr);
    column-gap: var(--kolom);
  }
  .ww-merk {
    grid-row: 1;
    display: grid;
    place-items: center;
    width: var(--merk);
    height: var(--merk);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--navy);
    font-family: var(--font-kop);
    font-size: 1.25rem;
    color: var(--navy);
    transition: background-color 0.45s var(--uit), color 0.45s var(--uit);
  }
  .ww-stap.bereikt .ww-merk:not(.ww-thuis) {
    background: var(--navy);
    color: #fff;
  }
  .ww-thuis {
    box-shadow: none;
    background: none;
  }
  .ww-thuis svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ww-thuis path {
    fill: color-mix(in srgb, var(--navy) 10%, var(--paper));
    stroke: var(--navy);
    stroke-width: 14;
    stroke-linejoin: round;
    transition: fill 0.45s var(--uit);
  }
  .ww-stap.bereikt .ww-thuis path {
    fill: var(--navy);
  }
  .ww-lijn {
    position: absolute;
    top: var(--merk);
    left: calc(var(--merk) / 2);
    width: 1.5px;
    height: calc(100% - var(--merk) + var(--tussen));
    translate: -50% 0;
    background: var(--line);
  }
  .ww-lijn span {
    display: block;
    height: 100%;
    background: var(--navy);
    transform-origin: top;
  }
  .ww-stap h3 {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    font-size: var(--h3-kaart);
    line-height: 1.1;
  }
  .ww-baan {
    grid-column: 2;
    margin-top: 1.5rem;
  }
  .ww-label {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--tekst-zacht);
  }
  .ww-wij p:not(.ww-label) {
    font-size: 1rem;
    line-height: 1.65;
  }
  .ww-wij p:not(.ww-label) + p {
    margin-top: 0.75rem;
  }
  .ww-punt + .ww-punt {
    margin-top: 1rem;
  }
  .ww-jij h4 {
    font-family: var(--font-tekst);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--navy);
  }
  .ww-jij .ww-punt p {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .ww-kort {
    font-family: var(--font-kop);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--navy);
  }
  .ww-kosten > p:last-child {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--tekst-zacht);
  }

  .ww-citaat {
    margin-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    background: var(--wash-warm);
  }
  .ww-citaat :global(.citaat-groot) {
    max-width: 44rem;
  }
  .ww-citaat :global(.citaat-groot blockquote) {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
    line-height: 1.25;
  }
  .ww-citaat :global(.citaat blockquote::before) {
    color: var(--brown);
  }

  .ww-nota {
    container-type: inline-size;
    max-width: 46rem;
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 20px 44px -34px rgba(0, 40, 58, 0.4);
  }
  .ww-nota dl > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .ww-nota dl > div:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .ww-nota dt {
    font-weight: 600;
    line-height: 1.45;
    color: var(--navy);
  }
  .ww-hoe {
    font-family: var(--font-kop);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--navy);
  }
  .ww-noot {
    max-width: 36rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--tekst-zacht);
  }
  .ww-prijzen {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .ww-prijzen h3 {
    margin-bottom: 0.5rem;
    font-size: 1.375rem;
  }

  @container (min-width: 32rem) {
    .ww-nota dl > div {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2.5rem;
    }
    .ww-hoe {
      text-align: right;
    }
    .ww-noot {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .ww-banen {
      position: sticky;
      top: var(--kop-zicht);
      z-index: 2;
      transition: top 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
      column-gap: var(--kolom);
      margin-top: clamp(1.5rem, 1rem + 1vw, 2.25rem);
      padding: 0.9rem 0 0.9rem calc(var(--merk) + var(--kolom));
      border-bottom: 1px solid color-mix(in srgb, var(--navy) 14%, transparent);
      background: var(--paper);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--tekst-zacht);
    }
    .ww-route {
      margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    }
    .ww-stap {
      grid-template-columns: var(--merk) minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
    }
    .ww-stap h3 {
      grid-column: 2 / -1;
    }
    .ww-baan {
      grid-row: 2;
      margin-top: 1.25rem;
    }
    .ww-jij {
      grid-column: 3;
    }
    .ww-kosten {
      grid-column: 4;
    }
    .ww-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const stappen = gsap.utils.toArray<HTMLElement>('[data-ww-stap]');
    stappen.forEach((stap, i) => {
      ScrollTrigger.create({
        trigger: stap,
        start: 'top 62%',
        onEnter: () => stap.classList.add('bereikt'),
        onLeaveBack: () => stap.classList.remove('bereikt'),
      });
      const vol = stap.querySelector('[data-ww-vol]');
      const volgende = stappen[i + 1];
      if (vol && volgende) {
        gsap.fromTo(
          vol,
          { scaleY: 0 },
          { scaleY: 1, ease: 'none', scrollTrigger: { trigger: stap, start: 'top 62%', endTrigger: volgende, end: 'top 62%', scrub: 0.5 } },
        );
      }
    });
    return () => stappen.forEach((stap) => stap.classList.remove('bereikt'));
  });
</script>
