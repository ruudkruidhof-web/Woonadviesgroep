---
import Pagina from '../../components/v3/Pagina.astro';
import KamerKop from '../../components/v3/proef/KamerKop.astro';
import Bewijs from '../../components/v3/proef/Bewijs.astro';
import HoofdEnHart from '../../components/v3/HoofdEnHart.astro';
import Situatiekamers from '../../components/v3/proef/Situatiekamers.astro';
import Klanten from '../../components/v3/Klanten.astro';
import Werkwijze from '../../components/v3/Werkwijze.astro';
import Contact from '../../components/v3/Contact.astro';
import diensten from '../../content/v3-diensten.json';
import home from '../../content/teksten/v3.json';
import proef from '../../content/teksten/v3-proef.json';

const d = diensten.find((x) => x.id === 'hypotheken')!;
const p = d.pagina;
const h = proef.hypotheken;
---
<Pagina titel={d.titel} omschrijving={p.lead}>
  <KamerKop titel={d.titel} lead={p.lead} situaties={p.situaties} />
  <Bewijs items={h.bewijs} />

  <HoofdEnHart
    id="advies"
    titel={h.belofte_kop}
    lead={h.belofte_lead}
    slotregel={null}
    hoofd={{ woord: home.hoofdhart.hoofd_label, sub: h.hoofd_sub, regels: [h.advies_opties, h.advies_analyse] }}
    hart={{ woord: home.hoofdhart.hart_label, sub: h.hart_sub, regels: [h.advies_contact], citaat: 'marit-ruben' }}
  />

  <Situatiekamers titel={p.situaties_titel} lead={h.reis} items={p.situaties} knop={p.situaties_knop} onderwerp={d.titel} />
  <Klanten />
  <Werkwijze onderwerp={d.titel} />
  <Contact onderwerp={d.titel} />
</Pagina>
