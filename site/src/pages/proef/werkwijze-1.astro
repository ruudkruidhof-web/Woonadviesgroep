---
import Pagina from '../../components/v3/Pagina.astro';
import RouteKop from '../../components/v3/proef/RouteKop.astro';
import Stapkamers from '../../components/v3/proef/Stapkamers.astro';
import Kostenvlak from '../../components/v3/proef/Kostenvlak.astro';
import Citaat from '../../components/v3/Citaat.astro';
import Contact from '../../components/v3/Contact.astro';
import teksten from '../../content/teksten/v3-paginas.json';

const t = teksten.werkwijze;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <RouteKop titel={t.titel} lead={t.lead} stappen={t.stappen} label={t.mini_label} />
  <Stapkamers titel={t.route_titel} stappen={t.stappen} banen={t.banen} />

  <div class="uitspraak sectie">
    <div class="maat" data-onthul>
      <Citaat id={t.citaat} groot />
    </div>
  </div>

  <Kostenvlak titel={t.kosten_titel} intro={t.kosten_intro} />
  <Contact />
</Pagina>

<style>
  .uitspraak {
    padding-bottom: 0;
  }
</style>
