---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Inhoud from '../components/v3/Inhoud.astro';
import teksten from '../content/teksten/v3-paginas.json';

const t = teksten.privacy;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <Opening titel={t.titel} acties={false}>
    <section class="pv-kort" aria-labelledby="pv-kort-titel">
      <h2 id="pv-kort-titel" class="sr-alleen">{t.kort_titel}</h2>
      <ul>
        {t.kort.map((k) => <li>{k}</li>)}
      </ul>
    </section>
  </Opening>

  <div class="maat pv-raster">
    <div class="pv-zij">
      <Inhoud titel={t.inhoud_titel} items={t.secties} />
    </div>
    <article class="pv-tekst">
      {t.secties.map((s) => (
        <section id={s.id} aria-labelledby={`pv-${s.id}`}>
          <h2 id={`pv-${s.id}`}>{s.titel}</h2>
          {s.alineas.map((a) => <p>{a}</p>)}
        </section>
      ))}
      <p class="pv-datum">{t.bijgewerkt}</p>
    </article>
  </div>
</Pagina>

<style>
  .pv-kort {
    width: 100%;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    text-align: left;
  }
  .pv-kort ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pv-kort li {
    padding-block: 1.25rem 1.5rem;
    border-top: 1.5px solid color-mix(in srgb, var(--sky-deep) 40%, transparent);
    font-family: var(--font-kop);
    font-size: clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem);
    line-height: 1.3;
    color: var(--navy);
  }

  @media (min-width: 48rem) {
    .pv-kort ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  .pv-raster {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-bottom: clamp(4.5rem, 3rem + 5vw, 8rem);
  }
  .pv-tekst {
    max-width: 36rem;
  }
  .pv-tekst section {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  .pv-tekst section:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .pv-tekst h2 {
    font-size: var(--h2-blok);
  }
  .pv-tekst p {
    margin-top: 0.9rem;
    line-height: 1.65;
  }
  .pv-datum {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }

  @media (min-width: 64rem) {
    .pv-raster {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
    .pv-zij {
      position: sticky;
      top: calc(var(--kop-hoogte) + 1.5rem);
      align-self: start;
    }
  }
</style>
