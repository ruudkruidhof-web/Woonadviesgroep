---
import Pagina from '../components/v3/Pagina.astro';
import Opening from '../components/v3/Opening.astro';
import Kaartregel from '../components/v3/Kaartregel.astro';
import Einde from '../components/v3/Einde.astro';
import Icoon from '../components/v3/Icoon.astro';
import teksten from '../content/teksten/v3-paginas.json';
import kaarten from '../content/v3-vergelijkingskaarten.json';
import bedrijf from '../content/bedrijf.json';

const t = teksten.dienstverlening;
const k = teksten.kaart;
---
<Pagina titel={t.meta_titel} omschrijving={t.omschrijving}>
  <Opening titel={t.titel} lead={t.lead} acties={false}>
    <section class="reg" id="registraties" aria-labelledby="reg-titel">
      <h2 id="reg-titel" class="sr-alleen">{t.registraties_titel}</h2>
      <ul>
        {t.registraties.map((r) => (
          <li>
            <p class="reg-orgaan"><abbr title={r.naam}>{r.kort}</abbr></p>
            <p class="reg-nummer cijfer">{bedrijf[r.veld as 'afm' | 'kifid' | 'kvk']}</p>
            <a href={r.url} target="_blank" rel="noopener" class="tekstlink">
              {r.link}
              <Icoon naam="dak" maat={10} />
            </a>
          </li>
        ))}
      </ul>
      <p class="reg-naam">{t.handelsnaam}</p>
    </section>
  </Opening>

  <section class="on kamer" id="onafhankelijk" aria-labelledby="on-titel" data-kamer>
    <div class="maat on-vak">
      <div class="on-kop">
        <h2 id="on-titel" data-regels>{t.onafhankelijk_titel}</h2>
        <p class="lead" data-onthul>{t.onafhankelijk_lead}</p>
        <p data-onthul>{t.vrijheid}</p>
      </div>
      <dl class="on-groepen">
        {kaarten.kaarten.map((x) => (
          <div data-onthul>
            <dt>
              <a href={x.url} target="_blank" rel="noopener">
                {x.titel}
                <span class="sr-alleen">, vergelijkingskaart (pdf)</span>
              </a>
              <span>{x.sub}</span>
            </dt>
            <dd class:list={[{ 'on-nee': !x.onafhankelijk }]}>
              <strong>{x.onafhankelijk ? k.ja_kort : k.nee_kort}</strong>
              <span>{x.onafhankelijk_uitleg}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bl sectie" id="beloning" aria-labelledby="bl-titel">
    <div class="maat bl-vak">
      <div class="bl-kop">
        <h2 id="bl-titel" data-regels>{t.beloning_titel}</h2>
        <a href="/werkwijze-en-kosten" class="tekstlink" data-onthul>
          {t.beloning_link}
          <Icoon naam="dak" maat={11} />
        </a>
      </div>
      {t.beloning.map((b) => (
        <div class="bl-soort" data-onthul>
          <h3>{b.titel}</h3>
          <p>{b.tekst}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="kl kamer" id="klachten" aria-labelledby="kl-titel" data-kamer>
    <div class="maat">
      <div class="kl-kop">
        <h2 id="kl-titel" data-regels>{t.klacht_titel}</h2>
        <p class="lead" data-onthul>{t.klacht_lead}</p>
      </div>
      <ol class="kl-stappen">
        {t.klacht_stappen.map((s, i) => (
          <li data-onthul>
            <span class="kl-cijfer cijfer" aria-hidden="true">{i + 1}</span>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
            {i === 0 ? (
              <a href={`mailto:${bedrijf.email}`} class="tekstlink">{bedrijf.email}</a>
            ) : (
              <a href="https://www.kifid.nl" target="_blank" rel="noopener" class="tekstlink">
                kifid.nl
                <Icoon naam="dak" maat={10} />
              </a>
            )}
          </li>
        ))}
      </ol>
      <p class="kl-slot" data-onthul>{t.aansprakelijk}</p>
    </div>
  </section>

  <section class="dc" id="documenten" aria-labelledby="dc-titel">
    <div class="maat bl-vak">
      <h2 id="dc-titel" data-regels>{t.documenten_titel}</h2>
      <div class="dc-kaarten" data-onthul>
        <Kaartregel ids={kaarten.kaarten.map((x) => x.id)} />
      </div>
    </div>
  </section>

  <Einde volgende={teksten.afsluiter} />
</Pagina>

<style>
  .reg {
    width: 100%;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    scroll-margin-top: calc(var(--kop-hoogte) + 2rem);
  }
  .reg ul {
    display: grid;
    gap: 1.75rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .reg li {
    display: grid;
    justify-items: center;
  }
  .reg-orgaan abbr {
    font-weight: 700;
    text-decoration: none;
    color: var(--sky-deep);
  }
  .reg-nummer {
    margin-top: 0.2rem;
    font-family: var(--font-kop);
    font-size: var(--h2-blok);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--navy);
  }
  .reg .tekstlink {
    font-size: var(--ui);
  }
  .reg-naam {
    margin-top: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    font-size: var(--ui);
    color: var(--tekst-zacht);
  }

  .on {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
    background: var(--sky-wash);
    scroll-margin-top: var(--kop-hoogte);
  }
  .on-vak {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .on h2 {
    max-width: 12ch;
    font-size: var(--h2);
    line-height: 1.05;
    text-wrap: balance;
  }
  .on-kop p {
    max-width: 28rem;
    margin-top: 1.25rem;
    line-height: 1.65;
  }
  .on-kop .lead {
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    color: var(--navy);
  }
  .on-groepen > div {
    display: grid;
    grid-template-columns: clamp(4.5rem, 3rem + 6vw, 8rem) minmax(0, 1fr);
    gap: 0.25rem clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 1.5rem;
    border-top: 1.5px solid color-mix(in srgb, var(--sky-deep) 35%, transparent);
  }
  .on-groepen > div:last-child {
    padding-bottom: 0;
  }
  .on-groepen dt {
    grid-column: 2;
  }
  .on-groepen dt a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block: -0.4rem;
    font-family: var(--font-kop);
    font-size: var(--h3);
    line-height: 1.15;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--navy) 25%, transparent);
    text-underline-offset: 0.25em;
  }
  .on-groepen dt a:hover {
    text-decoration-color: currentColor;
  }
  .on-groepen dt span:not(.sr-alleen) {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--ui);
    color: var(--navy-soft);
  }
  .on-groepen dd {
    display: contents;
  }
  .on-groepen strong {
    grid-column: 1;
    grid-row: 1 / span 2;
    font-family: var(--font-kop);
    font-size: var(--h2);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--sky-deep);
  }
  .on-groepen .on-nee strong {
    color: var(--brown);
  }
  .on-groepen dd span {
    grid-column: 2;
    font-size: var(--ui);
    line-height: 1.55;
    color: var(--navy);
  }

  .bl-vak {
    display: grid;
    gap: 2rem;
  }
  .bl h2,
  .dc h2 {
    max-width: 12ch;
    font-size: var(--h2-blok);
    line-height: 1.08;
    text-wrap: balance;
  }
  .bl-kop .tekstlink {
    margin-top: 0.75rem;
  }
  .bl-soort {
    padding-top: 1.25rem;
    border-top: 1.5px solid color-mix(in srgb, var(--sky-deep) 40%, transparent);
  }
  .bl-soort h3 {
    font-size: var(--h3);
  }
  .bl-soort p {
    max-width: 26rem;
    margin-top: 0.75rem;
    line-height: 1.65;
  }

  .kl {
    --boog: clamp(3.5rem, 1.5rem + 7vw, 9rem);
    padding-block: calc(var(--boog) + 2rem) clamp(4rem, 3rem + 5vw, 7rem);
    border-radius: 50% 50% var(--radius) var(--radius) / var(--boog) var(--boog) var(--radius) var(--radius);
    background: var(--navy);
    color: #bcd2e1;
    scroll-margin-top: var(--kop-hoogte);
  }
  .kl :focus-visible {
    outline-color: var(--sky);
  }
  .kl-kop {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .kl h2 {
    font-size: var(--h2);
    line-height: 1.05;
    color: #fff;
    text-wrap: balance;
  }
  .kl-kop .lead {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--sky-wash);
    text-wrap: balance;
  }
  .kl-stappen {
    display: grid;
    gap: 3rem;
    margin: clamp(3rem, 2.5rem + 3vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .kl-stappen li {
    position: relative;
    padding-left: 4.5rem;
  }
  .kl-cijfer {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    font-family: var(--font-kop);
    font-size: 3.25rem;
    line-height: 1;
    color: var(--sky);
    text-align: center;
  }
  .kl-stappen h3 {
    padding-top: 0.6rem;
    font-size: var(--h3-kaart);
    line-height: 1.1;
    color: #fff;
  }
  .kl-stappen p {
    max-width: 30rem;
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .kl .tekstlink {
    margin-top: 0.5rem;
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }
  .kl .tekstlink:hover {
    text-decoration-color: #fff;
  }
  .kl-slot {
    max-width: 36rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .dc {
    padding-top: var(--sectie);
  }

  @media (min-width: 48rem) {
    .reg ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }
    .reg li + li {
      border-left: 1px solid var(--vel-rand);
    }
  }

  @media (min-width: 64rem) {
    .on-vak {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .bl-vak {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3.5fr) minmax(0, 3.5fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
    .dc-kaarten {
      grid-column: 2 / -1;
    }
    .kl-stappen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 6vw, 6rem);
    }
    .kl-stappen li {
      padding: 6.25rem 0 0;
    }
    .kl-stappen li::before {
      content: '';
      position: absolute;
      top: 2.1rem;
      left: 4rem;
      right: 0;
      height: 1.5px;
      background: rgba(255, 255, 255, 0.14);
    }
    .kl-stappen li:first-child::before {
      right: calc(-1 * clamp(3rem, 6vw, 6rem));
    }
    .kl-cijfer {
      width: auto;
      font-size: 4.25rem;
      text-align: left;
    }
    .kl-stappen h3 {
      padding-top: 0;
    }
    .kl-slot {
      margin-inline: auto;
      text-align: center;
    }
  }
</style>
