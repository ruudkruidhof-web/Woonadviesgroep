---
import Citaat from './Citaat.astro';
import Icoon from './Icoon.astro';

const { titel, items, knop, onderwerp } = Astro.props;
---
<section class="si" id="situaties" aria-labelledby="si-titel">
  <div class="maat">
    <h2 id="si-titel">{titel}</h2>
    {items.map((s) => (
      <div class="si-situatie" id={s.id} data-onthul>
        <h3>{s.titel}</h3>
        <p class="si-tekst">{s.tekst}</p>
        {s.review && (
          <div class="si-citaat">
            <Citaat id={s.review} klein />
          </div>
        )}
        <button type="button" class="knop knop-lijn si-knop" data-plan-open data-onderwerp={onderwerp}>
          {knop}
          <Icoon naam="dak" maat={12} />
        </button>
      </div>
    ))}
  </div>
</section>

<style>
  .si {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) clamp(1rem, 0.5rem + 1vw, 2rem);
    background: linear-gradient(var(--sky-wash) 12%, color-mix(in srgb, var(--sky-wash) 55%, var(--paper)) 55%, var(--paper) 96%);
  }
  .si h2 {
    max-width: 18ch;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    text-wrap: balance;
  }
  .si-situatie {
    display: grid;
    align-items: start;
    justify-items: start;
    padding-block: clamp(2.25rem, 1.75rem + 2.5vw, 4rem);
    border-top: 1px solid var(--vel-rand);
    scroll-margin-top: calc(var(--kop-hoogte) + 1rem);
  }
  .si-situatie h3 {
    max-width: 13ch;
    font-size: var(--h3-kaart);
    line-height: 1.1;
    color: var(--navy);
    text-wrap: balance;
  }
  .si-tekst {
    max-width: 34rem;
    margin-top: 1rem;
    font-size: var(--lead);
    line-height: 1.55;
  }
  .si-citaat {
    max-width: 34rem;
    margin-top: 1.75rem;
  }
  .si-knop {
    margin-top: 1.75rem;
  }

  @media (min-width: 64rem) {
    .si-situatie {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'titel tekst citaat' 'titel knop citaat';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 4vw, 4.5rem);
    }
    .si-situatie h3 {
      grid-area: titel;
    }
    .si-tekst {
      grid-area: tekst;
      margin-top: 0.2rem;
    }
    .si-citaat {
      grid-area: citaat;
      margin-top: 0.35rem;
    }
    .si-knop {
      grid-area: knop;
    }
  }

  @media (max-width: 47.99rem) {
    .si-knop {
      width: 100%;
    }
  }
</style>
