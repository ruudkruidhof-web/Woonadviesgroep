---
import Icoon from './Icoon.astro';
import Merk from '../Merk.astro';
import teksten from '../../content/teksten/v3.json';
import bedrijf from '../../content/bedrijf.json';

const t = teksten.werkwijze;
---
<section id="werkwijze" class="werkwijze sectie kamer" data-kamer aria-labelledby="werkwijze-titel">
  <div class="maat">
    <div class="sectie-kop">
      <h2 id="werkwijze-titel" data-regels>{t.titel}</h2>
      <p data-onthul>{t.lead}</p>
    </div>

    <div class="w-route" data-route>
      <div class="w-lijn" aria-hidden="true">
        <span data-route-vol></span>
        <Icoon naam="dak" maat={14} />
      </div>
      <ol class="w-stappen">
        {t.stappen.map((s, i) => (
          <li class="w-stap" data-stap>
            <span class="w-cijfer cijfer" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-alleen">Stap {i + 1}, </span>{s.titel}</h3>
            <p>{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="w-band" data-onthul>
      <div class="w-kosten">
        <span class="w-zegel"><Merk breedte={38} /></span>
        <div>
          <h3>{t.kosten_titel}</h3>
          <p>{t.kosten}</p>
        </div>
      </div>
      <div class="w-start">
        <p class="w-start-titel">{t.start}</p>
        <div class="w-acties">
          <button type="button" class="knop knop-licht" data-plan-open>
            {teksten.hero.knop}
            <Icoon naam="dak" maat={12} />
          </button>
          <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink">
            <Icoon naam="bel" maat={15} />
            <span>Of bel <span class="cijfer">{bedrijf.telefoon}</span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .werkwijze {
    background: var(--navy);
    color: #bcd2e1;
  }
  .werkwijze h2,
  .werkwijze h3 {
    color: #fff;
  }
  .werkwijze .sectie-kop p {
    color: var(--sky-wash);
  }

  .w-route {
    position: relative;
  }
  .w-lijn {
    position: absolute;
    top: 1.75rem;
    bottom: 1rem;
    left: 1.25rem;
    width: 1.5px;
    background: rgba(255, 255, 255, 0.14);
  }
  .w-lijn span {
    position: absolute;
    inset: 0;
    background: var(--sky);
    transform-origin: top center;
  }
  .w-lijn :global(.dak) {
    position: absolute;
    left: 50%;
    bottom: -0.5rem;
    translate: -50% 0;
    rotate: 90deg;
    color: var(--sky);
  }
  .w-stappen {
    display: grid;
    gap: 3rem;
    padding: 0;
    list-style: none;
  }
  .w-stap {
    position: relative;
    padding-left: 4.5rem;
  }
  .w-cijfer {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    padding-block: 0.25rem;
    background: var(--navy);
    font-family: var(--font-kop);
    font-size: 3.25rem;
    line-height: 1;
    color: var(--sky);
    text-align: center;
  }
  .w-stap h3 {
    padding-top: 0.6rem;
    font-size: var(--h3);
  }
  .w-stap p {
    max-width: 22rem;
    margin-top: 0.75rem;
  }

  .w-band {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    border-radius: 20px;
    background: color-mix(in srgb, var(--navy), #fff 7%);
  }
  .w-kosten {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  .w-zegel {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--paper);
  }
  .w-kosten h3 {
    font-size: var(--h3);
  }
  .w-kosten p {
    max-width: 30rem;
    margin-top: 0.6rem;
  }
  .w-start-titel {
    font-family: var(--font-kop);
    font-size: var(--h3);
    line-height: 1.25;
    color: #fff;
  }
  .w-acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.25rem;
  }
  .werkwijze .tekstlink {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }
  .werkwijze .tekstlink:hover {
    text-decoration-color: #fff;
  }

  @media (max-width: 47.99rem) {
    .w-band {
      margin-inline: -0.75rem;
      padding: 1.75rem 1.25rem;
    }
  }

  @media (min-width: 40rem) {
    .w-kosten {
      grid-template-columns: auto 1fr;
    }
  }

  @media (min-width: 64rem) {
    .w-lijn {
      top: 2.1rem;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1.5px;
    }
    .w-lijn span {
      transform-origin: left center;
    }
    .w-lijn :global(.dak) {
      left: auto;
      right: -0.35rem;
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
      rotate: 0deg;
    }
    .w-stappen {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }
    .w-stap {
      padding: 6.25rem 0 0;
    }
    .w-cijfer {
      width: auto;
      padding: 0 1.25rem 0 0;
      font-size: 4.25rem;
      text-align: left;
    }
    .w-stap h3 {
      padding-top: 0;
    }
    .w-band {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
    .w-start {
      padding-left: clamp(2.5rem, 5vw, 5rem);
      border-left: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
</style>
