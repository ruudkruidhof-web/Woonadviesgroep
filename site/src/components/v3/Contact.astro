---
import Icoon from './Icoon.astro';
import Merk from '../Merk.astro';
import teksten from '../../content/teksten/v3.json';
import bedrijf from '../../content/bedrijf.json';

const t = teksten.contact;
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${bedrijf.adres_straat}, ${bedrijf.adres_plaats}`)}`;
---
<section id="contact" class="contact sectie" aria-labelledby="contact-titel">
  <div class="maat c-vak">
    <div class="c-kop">
      <h2 id="contact-titel" data-regels>{t.titel}</h2>
      <p class="lead" data-onthul>{t.lead}</p>
    </div>

    <div class="c-kaart" data-kaartje>
      <div class="c-kaart-kop">
        <Merk breedte={64} />
        <div>
          <p class="c-naam">{bedrijf.naam}</p>
          <p class="c-motto">{bedrijf.tagline}</p>
        </div>
      </div>
      <div class="c-kaart-gegevens">
        <address>
          {bedrijf.adres_straat}<br />{bedrijf.adres_plaats}
          <a href={route} target="_blank" rel="noopener" class="tekstlink">Route plannen <Icoon naam="dak" maat={10} /></a>
        </address>
        <p>
          <a href={`tel:${bedrijf.telefoon_link}`} class="cijfer">{bedrijf.telefoon}</a><br />
          <a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a>
        </p>
      </div>
      <p class="c-reg cijfer">KvK {bedrijf.kvk} · AFM {bedrijf.afm} · Kifid {bedrijf.kifid}</p>
    </div>

    <ul class="c-acties" data-onthul>
      <li>
        <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-lijn">
          <Icoon naam="bel" maat={15} />
          Bel ons
        </a>
      </li>
      <li>
        <a href={`https://wa.me/${bedrijf.whatsapp}`} class="knop knop-lijn">
          <Icoon naam="whatsapp" maat={16} />
          Stuur een WhatsApp
        </a>
      </li>
      <li>
        <button type="button" class="knop knop-vol" data-plan-open>
          {teksten.hero.knop}
          <Icoon naam="dak" maat={12} />
        </button>
      </li>
    </ul>
  </div>
</section>

<style>
  .c-vak {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .c-kop h2 {
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 4rem);
    line-height: 1.05;
  }
  .c-kop p {
    max-width: 30rem;
    margin: 1.25rem auto 0;
  }

  .c-kaart {
    display: grid;
    gap: 1.75rem;
    width: min(100%, 36rem);
    margin-top: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 40, 58, 0.06), 0 30px 60px -34px rgba(0, 40, 58, 0.5);
    text-align: left;
  }
  .c-kaart-kop {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .c-kaart-kop :global(svg) {
    flex-shrink: 0;
  }
  .c-naam {
    font-family: var(--font-kop);
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--navy);
  }
  .c-motto {
    margin-top: 0.3rem;
    font-size: var(--klein);
    color: var(--brown);
  }
  .c-kaart-gegevens {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--navy);
  }
  .c-kaart-gegevens address {
    font-style: normal;
  }
  .c-kaart-gegevens a:not(.tekstlink) {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--navy) 25%, transparent);
    text-underline-offset: 0.25em;
  }
  .c-kaart-gegevens a:not(.tekstlink):hover {
    text-decoration-color: currentColor;
  }
  .c-kaart-gegevens .tekstlink {
    display: flex;
    width: fit-content;
    min-height: 2.5rem;
    font-size: var(--ui);
  }
  .c-reg {
    font-size: 0.8125rem;
    color: var(--tekst-zacht);
  }

  .c-acties {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 22rem);
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }
  .c-acties .knop {
    width: 100%;
  }

  @media (min-width: 40rem) {
    .c-kaart {
      aspect-ratio: 1.7;
      align-content: space-between;
    }
    .c-kaart-gegevens {
      grid-template-columns: 1fr 1fr;
    }
    .c-acties {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .c-acties .knop {
      width: auto;
    }
  }
</style>
