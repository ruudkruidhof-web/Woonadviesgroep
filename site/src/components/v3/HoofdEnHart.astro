---
import Merk from '../Merk.astro';
import teksten from '../../content/teksten/v3.json';

const t = teksten.hoofdhart;
const kanten = [
  { id: 'hoofd', woord: t.hoofd_label, sub: t.hoofd_sub, regels: t.hoofd },
  { id: 'hart', woord: t.hart_label, sub: t.hart_sub, regels: t.hart },
];
---
<section class="hh sectie" aria-labelledby="hh-titel">
  <div class="maat">
    <div class="hh-kop">
      <h2 id="hh-titel" data-regels>{t.titel}</h2>
      <p class="lead" data-onthul>{t.lead}</p>
    </div>

    <div class="hh-tweeluik" data-hh>
      <div class="hh-merk">
        <span data-hh-merk>
          <Merk breedte={232} titel="Het beeldmerk van WoonAdvies Groep: een huis midden in een hart" />
        </span>
      </div>
      {kanten.map((k) => (
        <div class={`hh-helft hh-${k.id}`} data-hh-kant={k.id}>
          <h3>
            <span class="hh-woord">{k.woord}</span>
            <span class="hh-sub">{k.sub}</span>
          </h3>
          <ul>
            {k.regels.map((regel) => <li>{regel}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="hh-slot" data-onthul>{t.slot}</p>
  </div>
</section>

<style>
  .hh-kop {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  .hh-kop h2 {
    font-size: clamp(2.5rem, 1.9rem + 2.8vw, 4.25rem);
    line-height: 1.05;
  }
  .hh-kop p {
    max-width: 34rem;
    margin: 1.5rem auto 0;
  }

  .hh-tweeluik {
    --boog: 3.25rem;
    position: relative;
    display: grid;
    margin-top: calc(clamp(3rem, 2rem + 3vw, 4.5rem) + 5rem);
    text-align: center;
  }
  .hh-merk {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    translate: -50% -42%;
  }
  .hh-merk > span {
    display: block;
  }
  .hh-merk :global(svg) {
    display: block;
    width: clamp(9.5rem, 7rem + 8vw, 14.5rem);
    height: auto;
  }
  .hh-helft {
    padding: clamp(2.5rem, 2rem + 2vw, 3.5rem) clamp(1.5rem, 1rem + 3vw, 4rem);
  }
  .hh-hoofd {
    padding-top: 8.5rem;
    border-radius: 50% 50% 0 0 / var(--boog) var(--boog) 0 0;
    background: var(--sky-wash);
  }
  .hh-hart {
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--wash-warm);
  }
  .hh-helft h3 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .hh-woord {
    font-size: clamp(3rem, 2.3rem + 2.6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hh-hoofd .hh-woord {
    color: var(--sky-deep);
  }
  .hh-hart .hh-woord {
    color: var(--brown);
  }
  .hh-sub {
    font-family: var(--font-tekst);
    font-size: var(--ui);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--navy);
  }
  .hh-helft ul {
    max-width: 24rem;
    margin: 2rem auto 0;
    padding: 0;
    list-style: none;
  }
  .hh-helft li {
    color: var(--navy-soft);
  }
  .hh-helft li + li::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1.5px;
    margin: 1.25rem auto;
    background: currentColor;
    opacity: 0.35;
  }
  .hh-hoofd li + li::before {
    background: var(--sky-deep);
  }
  .hh-hart li + li::before {
    background: var(--brown);
  }
  .hh-slot {
    max-width: 34rem;
    margin: clamp(3rem, 2.5rem + 2vw, 4.5rem) auto 0;
    font-family: var(--font-kop);
    font-size: var(--h3);
    line-height: 1.3;
    color: var(--navy);
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .hh-tweeluik {
      --boog: 5.5rem;
      grid-template-columns: 1fr 1fr;
    }
    .hh-helft {
      padding-top: 8.5rem;
      padding-bottom: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    }
    .hh-hoofd {
      position: relative;
      margin-right: -1px;
      border-radius: 50% 50% 0 var(--radius) / var(--boog) var(--boog) 0 var(--radius);
    }
    .hh-hart {
      border-radius: 50% 50% var(--radius) 0 / var(--boog) var(--boog) var(--radius) 0;
    }
    .hh-merk {
      translate: -50% -38%;
    }
  }
</style>
