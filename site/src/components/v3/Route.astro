---
import { huis, huisViewBox } from './merk';

const { titel, stappen, banen } = Astro.props;
const laatste = stappen.length - 1;
---
<section class="ro kamer" id="route" aria-labelledby="ro-titel" data-kamer>
  <div class="maat">
    <h2 id="ro-titel" class="sr-alleen">{titel}</h2>

    <div class="ro-route" data-loop>
      <div class="ro-lijn" aria-hidden="true"><span data-loop-vol></span></div>

      <ol class="ro-stappen">
        {stappen.map((s, i) => (
          <li class="ro-stap" id={s.id}>
            <span class="ro-cijfer cijfer" aria-hidden="true">
              {i === laatste ? <svg viewBox={huisViewBox}><path d={huis} /></svg> : i + 1}
            </span>

            <div class="ro-wat" data-onthul>
              <h3>{i < laatste && <span class="sr-alleen">Stap {i + 1}, </span>}{s.titel}</h3>
              <p class="ro-kern">{s.kern}</p>
              <p class="ro-tekst">{s.tekst}</p>
            </div>

            <div class="ro-zij" data-onthul>
              <div class="ro-kosten">
                <h4>{banen.kosten}</h4>
                <p class="ro-woord">{s.kosten.kort}</p>
                <p>{s.kosten.tekst}</p>
              </div>
              <div class="ro-jij">
                <h4>{banen.jij}</h4>
                {s.jij.map((j) => (
                  <p><strong>{j.titel}.</strong> {j.tekst}</p>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .ro {
    --boog: clamp(3.5rem, 1.5rem + 7vw, 9rem);
    --cijfer: clamp(4rem, 2.5rem + 5vw, 7.5rem);
    padding-block: calc(var(--boog) + 1.5rem) clamp(4rem, 3rem + 5vw, 8rem);
    border-radius: 50% 50% var(--radius) var(--radius) / var(--boog) var(--boog) var(--radius) var(--radius);
    background: var(--navy);
    color: #bcd2e1;
  }
  .ro :focus-visible {
    outline-color: var(--sky);
  }
  .ro-route {
    position: relative;
  }
  .ro-lijn {
    position: absolute;
    top: calc(var(--cijfer) * 0.5);
    bottom: 0;
    left: calc(var(--cijfer) * 0.3);
    width: 1.5px;
    background: rgba(255, 255, 255, 0.14);
  }
  .ro-lijn span {
    position: absolute;
    inset: 0;
    background: var(--sky);
    transform-origin: top center;
  }
  .ro-stappen {
    display: grid;
    gap: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ro-stap {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-left: calc(var(--cijfer) * 0.6 + 1.5rem);
    scroll-margin-top: calc(var(--kop-hoogte) + 1.5rem);
  }
  .ro-stap:last-child::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: -1px;
    left: 0;
    width: calc(var(--cijfer) * 0.6);
    background: var(--navy);
  }
  .ro-cijfer {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: calc(var(--cijfer) * 0.6);
    padding-block: 0.35rem;
    background: var(--navy);
    font-family: var(--font-kop);
    font-size: var(--cijfer);
    line-height: 0.9;
    color: var(--sky);
  }
  .ro-cijfer svg {
    display: block;
    width: calc(var(--cijfer) * 0.6);
    height: auto;
    margin-block: 0.4rem;
    fill: var(--sky);
  }
  .ro-wat h3 {
    font-size: var(--h3-kaart);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .ro-kern {
    max-width: 26ch;
    margin-top: 1rem;
    font-family: var(--font-kop);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    line-height: 1.25;
    color: var(--sky-wash);
    text-wrap: balance;
  }
  .ro-tekst {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .ro-zij {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .ro-zij h4 {
    font-family: var(--font-tekst);
    font-size: var(--klein);
    font-weight: 600;
    color: var(--sky);
  }
  .ro-woord {
    margin-top: 0.35rem;
    font-family: var(--font-kop);
    font-size: var(--h3);
    line-height: 1.15;
    color: #fff;
  }
  .ro-zij p:not(.ro-woord) {
    max-width: 24rem;
    margin-top: 0.5rem;
    font-size: var(--ui);
    line-height: 1.6;
  }
  .ro-zij strong {
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ro-stap:target .ro-wat h3 {
      animation: ro-doel 1.6s var(--uit) 0.3s;
    }
  }
  @keyframes ro-doel {
    from {
      color: var(--sky);
    }
  }

  @media (max-width: 30rem) {
    .ro-kern {
      hyphens: auto;
    }
  }

  @media (min-width: 64rem) {
    .ro-lijn {
      left: calc(var(--cijfer) * 0.35);
    }
    .ro-stap {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 6vw, 6rem);
      padding-left: calc(var(--cijfer) * 0.7 + clamp(2.5rem, 5vw, 5rem));
    }
    .ro-cijfer,
    .ro-stap:last-child::before {
      width: calc(var(--cijfer) * 0.7);
    }
    .ro-zij {
      padding-top: 0;
      padding-left: clamp(1.5rem, 3vw, 3rem);
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
</style>
