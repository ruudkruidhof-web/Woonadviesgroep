---
import Icoon from './Icoon.astro';
import diensten from '../../content/v3-diensten.json';
import teksten from '../../content/teksten/v3.json';

const t = teksten.diensten;
const [kern, ...kamers] = diensten;
// Het huis uit het beeldmerk (zelfde pad als in Merk.astro), hier als lijn.
const huis = 'M256 108 L480 330 L364 450 L359 449 L359 352 L366 348 L395 346 L390 336 L256 206 L122 336 L117 346 L146 348 L153 352 L153 449 L148 450 L32 330 Z';
---
<section id="diensten" class="diensten sectie" aria-labelledby="diensten-titel">
  <div class="maat">
    <div class="sectie-kop">
      <h2 id="diensten-titel" data-regels>{t.titel}</h2>
      <p data-onthul>{t.lead}</p>
    </div>

    <div class="d-gebouw" data-gebouw>
      <article id={`dienst-${kern.id}`} class="d-kamer d-kern" aria-labelledby={`dienst-${kern.id}-titel`}>
        <svg class="d-huis" viewBox="20 96 472 366" aria-hidden="true"><path d={huis} /></svg>
        <h3 id={`dienst-${kern.id}-titel`}>{kern.titel}</h3>
        <p class="d-tekst">{kern.tekst}</p>
        <ul class="d-situaties">
          {kern.situaties.map((s) => (
            <li>
              <Icoon naam="dak" maat={11} />
              {s}
            </li>
          ))}
        </ul>
        <div class="d-acties">
          <button type="button" class="knop knop-licht" data-plan-open data-onderwerp={kern.titel}>
            {t.knop}
            <Icoon naam="dak" maat={12} />
          </button>
          <a href="/v3/volgt-na-opdracht" class="tekstlink">
            Meer over {kern.titel.toLowerCase()}
            <Icoon naam="dak" maat={11} />
          </a>
        </div>
      </article>

      {kamers.map((d) => (
        <a id={`dienst-${d.id}`} href="/v3/volgt-na-opdracht" class={`d-kamer d-zij d-${d.id}`}>
          <h3>{d.titel}</h3>
          <p>{d.kort}</p>
          <span class="d-pijl" aria-hidden="true"><Icoon naam="dak" maat={13} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .d-gebouw {
    --voeg: 10px;
    --boog: clamp(4rem, 3rem + 3vw, 6rem);
    display: grid;
    gap: var(--voeg);
  }
  .d-kamer {
    position: relative;
    border-radius: var(--radius);
    isolation: isolate;
    overflow: hidden;
  }

  .d-kern {
    display: flex;
    flex-direction: column;
    padding: calc(var(--boog) * 0.85) clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border-radius: 50% 50% var(--radius) var(--radius) / var(--boog) var(--boog) var(--radius) var(--radius);
    background: var(--navy);
    color: var(--sky-wash);
  }
  .d-kern h3 {
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .d-tekst {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .d-situaties {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
  }
  .d-situaties li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.55rem;
    font-weight: 600;
    color: #fff;
  }
  .d-situaties :global(.dak) {
    color: var(--sky);
  }
  .d-acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .d-kern .tekstlink {
    color: #fff;
    text-decoration-color: color-mix(in srgb, #fff 40%, transparent);
  }
  .d-huis {
    position: absolute;
    z-index: -1;
    right: -3.5rem;
    bottom: -4.5rem;
    width: clamp(15rem, 10rem + 14vw, 24rem);
    height: auto;
    fill: none;
    stroke: var(--sky);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
    opacity: 0.32;
    transition: translate 0.6s var(--uit), opacity 0.4s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .d-kern:hover .d-huis {
      translate: 0 -0.5rem;
      opacity: 0.5;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .d-kamer:target {
      animation: doel 1.6s var(--uit) 0.3s;
    }
  }
  @keyframes doel {
    from {
      box-shadow: 0 0 0 4px var(--sky);
    }
    to {
      box-shadow: 0 0 0 4px transparent;
    }
  }

  .d-zij {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    column-gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    text-decoration: none;
    color: var(--navy-soft);
    transition: background-color 0.3s ease;
  }
  .d-zij h3 {
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .d-zij p {
    grid-column: 1;
    max-width: 26rem;
    margin-top: 0.6rem;
  }
  .d-pijl {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    color: var(--kamer-accent);
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .d-zij:hover .d-pijl,
  .d-zij:focus-visible .d-pijl {
    background: var(--kamer-accent);
    color: #fff;
  }
  .d-zij:hover :global(.dak),
  .d-zij:focus-visible :global(.dak) {
    translate: 0.15em 0;
  }
  .d-pensioenen {
    --kamer-accent: var(--sky-deep);
    background: var(--sky-wash);
  }
  .d-pensioenen:hover {
    background: color-mix(in srgb, var(--sky-wash), var(--sky) 16%);
  }
  .d-verzekeringen {
    --kamer-accent: var(--brown);
    background: var(--wash-warm);
  }
  .d-verzekeringen:hover {
    background: color-mix(in srgb, var(--wash-warm), var(--brown) 9%);
  }
  .d-financien {
    --kamer-accent: var(--navy);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .d-financien:hover {
    background: var(--ice);
  }

  @media (min-width: 64rem) {
    .d-gebouw {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: repeat(3, auto);
    }
    .d-kern {
      grid-row: 1 / span 3;
      padding-top: calc(var(--boog) + 1.5rem);
      border-radius: min(24vw, 21rem) var(--radius) var(--radius) var(--radius) / var(--boog) var(--radius) var(--radius) var(--radius);
    }
    .d-pensioenen {
      padding-top: calc(var(--boog) * 0.8);
      border-radius: var(--radius) min(24vw, 21rem) var(--radius) var(--radius) / var(--radius) var(--boog) var(--radius) var(--radius);
    }
  }
</style>
