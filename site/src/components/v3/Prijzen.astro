---
import kaarten from '../../content/v3-vergelijkingskaarten.json';
import teksten from '../../content/teksten/v3-paginas.json';

const { kaart: id } = Astro.props;
const kaart = kaarten.kaarten.find((k) => k.id === id);
---
{kaarten.toon_prijzen && kaart && (
  <div class="pr" data-onthul>
    <h3>{teksten.kaart.prijzen_titel}</h3>
    <dl>
      {kaart.prijzen.map((x) => (
        <div>
          <dt>{x.situatie}</dt>
          <dd class="cijfer">{x.bedrag}</dd>
        </div>
      ))}
    </dl>
    <p>{teksten.kaart.prijzen_uitleg}</p>
  </div>
)}

<style>
  .pr {
    width: min(100%, 30rem);
    margin-top: 2.5rem;
    text-align: left;
  }
  .pr h3 {
    font-size: var(--h3);
    text-align: center;
  }
  .pr dl {
    margin-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .pr dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .pr dd {
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }
  .pr p {
    margin-top: 0.75rem;
    font-size: var(--klein);
    text-align: center;
  }
</style>
