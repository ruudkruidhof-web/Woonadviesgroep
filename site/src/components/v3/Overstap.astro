---
import Icoon from './Icoon.astro';
import home from '../../content/teksten/v3.json';

const { volgende, onderwerp } = Astro.props;
---
<section class="os" aria-labelledby="os-titel">
  <div class="maat os-strook" data-onthul>
    <h2 id="os-titel">{volgende.titel}</h2>
    <p>{volgende.tekst}</p>
    <div class="os-acties">
      <a href={volgende.href} class="knop knop-vol">
        {volgende.label}
        <Icoon naam="dak" maat={12} />
      </a>
      <button type="button" class="knop knop-lijn" data-plan-open data-onderwerp={onderwerp}>
        {home.hero.knop}
      </button>
    </div>
  </div>
</section>

<style>
  .os {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem) clamp(4.5rem, 3rem + 5vw, 8rem);
  }
  .os-strook {
    padding-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-top: 1px solid var(--vel-rand);
  }
  .os h2 {
    max-width: 20ch;
    font-size: var(--h2);
    line-height: 1.05;
    text-wrap: balance;
  }
  .os p {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: var(--lead);
    line-height: 1.55;
  }
  .os-acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 47.99rem) {
    .os-acties .knop {
      width: 100%;
    }
  }
</style>
