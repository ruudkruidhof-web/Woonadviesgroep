<script is:inline>
  setTimeout(() => window.beweegt || document.documentElement.classList.add('beweging-uit'), 4000);
</script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);
  (window as any).beweegt = true;

  const binnen = { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' };
  const start = 'top 85%';
  const mm = gsap.matchMedia();

  const telaat = () => document.documentElement.classList.contains('beweging-uit');

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    if (telaat()) return;
    document.querySelectorAll<HTMLElement>('[data-regels]').forEach((kop) => {
      SplitText.create(kop, {
        type: 'lines',
        autoSplit: true,
        onSplit: (self) => {
          gsap.set(kop, { opacity: 1 });
          return gsap.fromTo(self.lines, { y: 14, opacity: 0 }, { ...binnen, stagger: 0.06, scrollTrigger: { trigger: kop, start, once: true } });
        },
      });
    });

    gsap.set('[data-onthul]', { y: 14, opacity: 0 });
    ScrollTrigger.batch('[data-onthul]', {
      start,
      once: true,
      onEnter: (els) => gsap.to(els, { ...binnen, delay: 0.08, stagger: 0.07 }),
    });

    gsap.utils.toArray<HTMLElement>('[data-kamer]').forEach((kamer) => {
      const r = getComputedStyle(kamer).borderTopLeftRadius;
      gsap.fromTo(
        kamer,
        { clipPath: `inset(3% 2.5% round ${r})` },
        { clipPath: `inset(0% 0% round ${r})`, duration: 1, ease: 'power3.out', clearProps: 'clipPath', scrollTrigger: { trigger: kamer, start: 'top 92%', once: true } },
      );
    });

    const gebouw = document.querySelector('[data-gebouw]');
    if (gebouw) {
      gsap.fromTo(gebouw.querySelectorAll('.d-kamer'), { y: 24, opacity: 0 }, { ...binnen, duration: 0.8, stagger: 0.07, scrollTrigger: { trigger: gebouw, start: 'top 82%', once: true } });
    }

    const kaartje = document.querySelector('[data-kaartje]');
    if (kaartje) {
      gsap.fromTo(kaartje, { y: 36, rotate: -1.5, opacity: 0 }, { ...binnen, rotate: 0, duration: 1, scrollTrigger: { trigger: kaartje, start: 'top 88%', once: true } });
    }
  });

  mm.add({ beweging: '(prefers-reduced-motion: no-preference)', breed: '(min-width: 48rem)' }, (ctx) => {
    const { beweging, breed } = ctx.conditions!;
    if (!beweging || telaat()) return;

    const hh = document.querySelector('[data-hh]');
    if (hh) {
      const kant = (x: number) => ({ opacity: 0, x: breed ? x : 0, y: breed ? 0 : 18 });
      gsap
        .timeline({ scrollTrigger: { trigger: hh, start: 'top 78%', once: true } })
        .fromTo('[data-hh-kant="hoofd"]', kant(-36), { ...binnen, x: 0, duration: 0.9 }, 0)
        .fromTo('[data-hh-kant="hart"]', kant(36), { ...binnen, x: 0, duration: 0.9 }, breed ? 0 : 0.12)
        .fromTo('[data-hh-merk]', { opacity: 0, y: -22, scale: 0.92 }, { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: 'back.out(1.15)' }, 0.35);
    }
  });

  mm.add({ beweging: '(prefers-reduced-motion: no-preference)', breed: '(min-width: 64rem)' }, (ctx) => {
    const { beweging, breed } = ctx.conditions!;
    if (!beweging || telaat()) return;

    const route = document.querySelector('[data-route]');
    if (route) {
      const as = breed ? 'scaleX' : 'scaleY';
      const tl = gsap.timeline({ scrollTrigger: { trigger: route, start: 'top 78%', once: true } });
      tl.fromTo(route.querySelector('[data-route-vol]'), { [as]: 0 }, { [as]: 1, duration: 1.4, ease: 'power2.inOut' }, 0);
      route.querySelectorAll('.w-stap').forEach((stap, i) => {
        tl.fromTo(stap, { y: 16, opacity: 0 }, { ...binnen, duration: 0.8 }, 0.15 + i * 0.4);
      });
    }
  });
</script>
