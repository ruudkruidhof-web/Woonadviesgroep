<script is:inline>
  setTimeout(() => window.beweegt || document.documentElement.classList.add('beweging-uit'), 4000);
</script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);
  (window as any).beweegt = true;

  const binnen = { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' };
  const start = 'top 85%';
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-regels]').forEach((kop) => {
      SplitText.create(kop, {
        type: 'lines',
        autoSplit: true,
        onSplit: (self) => {
          gsap.set(kop, { opacity: 1 });
          return gsap.fromTo(self.lines, { y: 14, opacity: 0 }, { ...binnen, stagger: 0.06, scrollTrigger: { trigger: kop, start, once: true } });
        },
      });
    });

    gsap.utils.toArray<HTMLElement>('[data-onthul], .w-stap > :not(.w-punt, .w-zegel)').forEach((el) => {
      gsap.fromTo(el, { y: 14, opacity: 0 }, { ...binnen, delay: 0.08, scrollTrigger: { trigger: el, start, once: true } });
    });
  });

  mm.add({ beweging: '(prefers-reduced-motion: no-preference)', breed: '(min-width: 64rem)' }, (ctx) => {
    const { beweging, breed } = ctx.conditions!;
    if (!beweging) return;

    const hh = document.querySelector('[data-hh]');
    if (hh) {
      const kant = (x: number) => ({ opacity: 0, x: breed ? x : 0, y: breed ? 0 : 14 });
      gsap
        .timeline({ scrollTrigger: { trigger: hh, start: 'top 75%', once: true } })
        .fromTo('[data-hh-merk]', { opacity: 0, scale: 0.94 }, { opacity: 1, scale: 1, duration: 0.9, ease: 'power3.out' })
        .fromTo('[data-hh-kant="hoofd"]', kant(-28), { ...binnen, x: 0, duration: 0.8 }, 0.1)
        .fromTo('[data-hh-kant="hart"]', kant(28), { ...binnen, x: 0, duration: 0.8 }, breed ? 0.1 : 0.2)
        .from('[data-hh-lijn]', { scaleX: 0, duration: 0.7, ease: 'power2.inOut' }, 0.5);
    }

    const route = document.querySelector('[data-route]');
    if (route) {
      const vol = route.querySelector('[data-route-vol]');
      const punten = [...route.querySelectorAll('.w-punt, .w-zegel')];
      const drempels = punten.map((_, i) => (i / (punten.length - 1)) * 0.9);
      const bereikt = new Set<Element>();
      const as = breed ? 'scaleX' : 'scaleY';
      gsap.set(punten, { opacity: 0.35, scale: 0.86 });
      const tl = gsap.timeline({
        scrollTrigger: { trigger: route, start: 'top 75%', end: breed ? 'bottom 82%' : 'bottom 78%', scrub: 0.6 },
        onUpdate() {
          const voortgang = this.progress();
          punten.forEach((punt, i) => {
            if (bereikt.has(punt) || voortgang < drempels[i]) return;
            bereikt.add(punt);
            gsap.to(punt, { opacity: 1, scale: 1, duration: 0.5, ease: 'power3.out' });
          });
        },
      });
      tl.fromTo(vol, { [as]: 0 }, { [as]: 1, duration: 1, ease: 'none' });
    }
  });
</script>
