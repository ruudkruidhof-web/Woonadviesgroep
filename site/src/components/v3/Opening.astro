---
import Kruimels from './Kruimels.astro';
import Icoon from './Icoon.astro';
import home from '../../content/teksten/v3.json';
import bedrijf from '../../content/bedrijf.json';

const { titel, lead, stappen = [], onderwerp, acties = true } = Astro.props;
---
<section class="op" aria-labelledby="op-titel">
  <div class="maat op-vak">
    <Kruimels hier={titel} stappen={stappen} />
    <h1 id="op-titel">{titel}</h1>
    {lead && <p class="lead op-lead">{lead}</p>}
    {acties && (
      <div class="op-acties">
        <button type="button" class="knop knop-vol" data-plan-open data-onderwerp={onderwerp}>
          {home.hero.knop}
          <Icoon naam="dak" maat={12} />
        </button>
        <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink">
          <span>Bel <span class="cijfer">{bedrijf.telefoon}</span></span>
        </a>
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  .op {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .op-vak {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .op :global(.kruimels ol) {
    justify-content: center;
  }
  .op h1 {
    max-width: 14ch;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-size: min(clamp(3.25rem, 1.8rem + 5.8vw, 6.75rem), 15vw);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .op-lead {
    max-width: 36rem;
    margin-top: 1.75rem;
    text-wrap: balance;
  }
  .op-acties {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .op-acties {
      flex-direction: row;
      gap: 1rem 1.6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .op-vak > * {
      animation: op-in 0.9s var(--uit) both;
    }
    .op h1 {
      animation-delay: 0.1s;
    }
    .op-lead {
      animation-delay: 0.2s;
    }
    .op-acties {
      animation-delay: 0.3s;
    }
    .op-vak > :nth-child(n + 5) {
      animation-delay: 0.45s;
    }
  }
  @keyframes op-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
</style>
