---
import Kruimels from './Kruimels.astro';

const { titel, hier = titel, lead, stappen, feiten } = Astro.props;
---
<header class="pk">
  <div class="maat">
    <Kruimels hier={hier} stappen={stappen} />
    <h1>{titel}</h1>
    {lead && <p class="lead pk-lead">{lead}</p>}
    <slot />
    {feiten && (
      <dl class="pk-feiten">
        {feiten.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.waarde}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</header>

<style>
  .pk {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .pk h1 {
    max-width: 16ch;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    font-size: var(--h1-pagina);
    line-height: 1.03;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pk-lead {
    max-width: 42rem;
    margin-top: 1.5rem;
  }
  .pk-feiten {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--navy) 16%, transparent);
  }
  .pk-feiten > div {
    padding-block: 1.1rem;
  }
  .pk-feiten > div + div {
    border-top: 1px solid var(--line);
  }
  .pk-feiten dt {
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }
  .pk-feiten dd {
    margin-top: 0.3rem;
    font-family: var(--font-kop);
    font-size: clamp(1.3125rem, 1.2rem + 0.4vw, 1.5rem);
    line-height: 1.2;
    color: var(--navy);
  }

  @media (min-width: 48rem) {
    .pk-feiten {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    .pk-feiten > div {
      padding-right: 1.5rem;
    }
    .pk-feiten > div + div {
      padding-left: 1.5rem;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pk h1,
    .pk-lead,
    .pk-feiten {
      animation: pk-in 0.8s var(--uit) both;
    }
    .pk-lead {
      animation-delay: 0.1s;
    }
    .pk-feiten {
      animation-delay: 0.2s;
    }
  }
  @keyframes pk-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
</style>
