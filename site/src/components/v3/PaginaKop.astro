---
import Kruimels from './Kruimels.astro';

const { titel, hier = titel, lead, stappen } = Astro.props;
---
<header class="pk">
  <svg class="pk-boog" viewBox="0 0 1156.6 680" aria-hidden="true">
    <circle class="pk-hoofd" cx="340" cy="340" r="339" pathLength="1" />
    <circle class="pk-hart" cx="816.6" cy="340" r="339" pathLength="1" />
  </svg>
  <div class="maat">
    <Kruimels hier={hier} stappen={stappen} />
    <h1>{titel}</h1>
    {lead && <p class="lead pk-lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .pk {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .pk h1 {
    max-width: 16ch;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    font-size: var(--h1-pagina);
    line-height: 1.03;
    letter-spacing: -0.02em;
  }
  .pk-lead {
    max-width: 40rem;
    margin-top: 1.5rem;
  }
  .pk-boog {
    display: none;
  }

  @media (min-width: 64rem) {
    .pk-boog {
      display: block;
      position: absolute;
      z-index: -1;
      top: -10rem;
      left: calc(50% - var(--maat) / 2 + 47rem);
      width: 54rem;
      height: auto;
      overflow: visible;
    }
    .pk-boog circle {
      fill: none;
      stroke-width: 1.25;
      vector-effect: non-scaling-stroke;
      transform-box: fill-box;
      transform-origin: center;
      rotate: 180deg;
    }
    .pk-hoofd {
      stroke: var(--sky-deep);
      opacity: 0.55;
    }
    .pk-hart {
      stroke: var(--brown);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pk-boog circle {
      stroke-dasharray: 1 1;
      animation: pk-teken 2.4s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    }
    .pk-hart {
      animation-delay: 0.35s;
    }
    .pk h1,
    .pk-lead {
      animation: pk-in 0.8s var(--uit) both;
    }
    .pk-lead {
      animation-delay: 0.12s;
    }
  }
  @keyframes pk-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes pk-teken {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
