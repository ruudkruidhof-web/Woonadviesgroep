---
import Icoon from './Icoon.astro';
import reviews from '../../content/reviews.json';

const { items = [], licht = false } = Astro.props;
---
<ul class:list={['bw', { 'bw-licht': licht }]}>
  <li>
    <a href={reviews.google_url} target="_blank" rel="noopener">
      <b class="cijfer">{reviews.score}</b>
      <span class="bw-sterren" role="img" aria-label="5 van de 5 sterren">
        {[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" maat={10} />)}
      </span>
      Google
    </a>
  </li>
  <li>
    <a href={reviews.advieskeuze_url} target="_blank" rel="noopener">
      <b class="cijfer">{reviews.advieskeuze_score}/10</b> Advieskeuze
    </a>
  </li>
  {items.map((x) => <li><b>{x.b}</b> {x.tekst}</li>)}
</ul>

<style>
  .bw {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.9rem;
    margin: 0;
    padding: 0.75rem 0.5rem 0;
    list-style: none;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--navy-soft);
    white-space: nowrap;
  }
  .bw li,
  .bw a {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 2.75rem;
  }
  .bw a {
    color: inherit;
    text-decoration: none;
  }
  .bw a:hover {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.25em;
  }
  .bw b {
    font-family: var(--font-kop);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
    color: var(--navy);
  }
  .bw-sterren {
    align-self: center;
    display: inline-flex;
    gap: 1px;
    color: #c98a12;
  }
  .bw-licht {
    color: #bcd2e1;
  }
  .bw-licht b {
    color: #fff;
  }

  @media (min-width: 48rem) {
    .bw {
      gap: 0.6rem clamp(1.5rem, 3vw, 2.6rem);
      font-size: 0.84375rem;
    }
    .bw b {
      font-size: 1.25rem;
    }
  }
</style>
