---
import Icoon from './Icoon.astro';
import diensten from '../../content/v3-diensten.json';
import bedrijf from '../../content/bedrijf.json';
import teksten from '../../content/teksten/v3.json';

const links = [
  { href: '/v3/werkwijze-en-kosten', label: 'Werkwijze en kosten' },
  { href: '/v3/over-ons', label: 'Over ons' },
  { href: '/v3/contact', label: 'Contact' },
];
const pad = Astro.url.pathname.replace(/\/$/, '');
const huidig = (href: string) => (pad === href ? 'page' : undefined);
const inDiensten = diensten.some((d) => pad === `/v3/${d.id}`);
---
<header class="kop" data-kop>
  <div class="maat kop-balk">
    <a href="/v3" class="kop-logo" aria-label="WoonAdvies Groep, naar home">
      <img src="/logo.webp" alt="WoonAdvies Groep" width="150" height="43" />
    </a>

    <nav class="kop-nav" aria-label="Hoofdmenu">
      <ul>
        <li class="kop-sub" data-sub>
          <button type="button" aria-expanded="false" aria-controls="kop-diensten" data-actief={inDiensten || undefined}>
            Diensten
            <Icoon naam="omlaag" maat={11} />
          </button>
          <div id="kop-diensten" class="kop-paneel">
            <ul>
              {diensten.map((d) => (
                <li>
                  <a href={`/v3/${d.id}`} aria-current={huidig(`/v3/${d.id}`)}>
                    <span class="kop-paneel-titel">{d.titel}</span>
                    <span class="kop-paneel-tekst">{d.menu}</span>
                    <Icoon naam="dak" maat={11} />
                  </a>
                </li>
              ))}
            </ul>
            <div class="kop-paneel-voet">
              <button type="button" class="tekstlink" data-plan-open>{teksten.diensten.knop}</button>
              <a href={`tel:${bedrijf.telefoon_link}`} class="cijfer">{bedrijf.telefoon}</a>
            </div>
          </div>
        </li>
        {links.map((l) => <li><a href={l.href} aria-current={huidig(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>

    <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-lijn kop-bel">
      <Icoon naam="bel" maat={15} />
      <span class="cijfer">{bedrijf.telefoon}</span>
    </a>

    <button type="button" class="kop-menuknop" popovertarget="kop-menu" aria-label="Menu openen">
      <span aria-hidden="true"></span>
      Menu
    </button>
  </div>

  <div id="kop-menu" class="kop-menu" popover>
    <div class="kop-menu-balk">
      <a href="/v3" class="kop-menu-logo" aria-label="WoonAdvies Groep, naar home">
        <img src="/logo.webp" alt="WoonAdvies Groep" width="132" height="38" />
      </a>
      <button type="button" class="kop-menu-sluit" popovertarget="kop-menu" popovertargetaction="hide" aria-label="Menu sluiten">
        <Icoon naam="sluit" maat={14} />
      </button>
    </div>
    <nav aria-label="Menu">
      <p class="kop-menu-groep">Diensten</p>
      <ul class="kop-menu-diensten">
        {diensten.map((d) => <li><a href={`/v3/${d.id}`} aria-current={huidig(`/v3/${d.id}`)}>{d.titel}</a></li>)}
      </ul>
      <ul class="kop-menu-links">
        {links.map((l) => <li><a href={l.href} aria-current={huidig(l.href)}>{l.label}</a></li>)}
      </ul>
      <a href="/v3/onze-dienstverlening" class="kop-menu-extra" aria-current={huidig('/v3/onze-dienstverlening')}>{teksten.voet.dienstverlening}</a>
    </nav>
    <div class="kop-menu-acties">
      <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-vol">
        <Icoon naam="bel" maat={15} />
        Bel <span class="cijfer">{bedrijf.telefoon}</span>
      </a>
      <a href={`https://wa.me/${bedrijf.whatsapp}`} class="knop knop-lijn">
        <Icoon naam="whatsapp" maat={16} />
        Stuur een WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .kop {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: translate 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
  }
  .kop[data-gescrold] {
    border-bottom-color: var(--line);
  }
  .kop[data-verborgen]:not(:focus-within) {
    translate: 0 -100%;
  }
  .kop-balk {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--kop-hoogte);
  }
  .kop-logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
  }
  .kop-logo img {
    width: 150px;
    height: auto;
  }
  .kop-nav,
  .kop-bel {
    display: none;
  }
  .kop-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  .kop-nav > ul > li > a,
  .kop-sub > button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: var(--ui);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .kop-nav > ul > li > a:hover,
  .kop-sub > button:hover,
  .kop-sub > button[aria-expanded='true'] {
    background: var(--sky-wash);
  }
  .kop-nav > ul > li > a[aria-current='page'],
  .kop-sub > button[data-actief] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--sky);
    text-underline-offset: 0.45em;
  }
  .kop-paneel a[aria-current='page'] {
    background: var(--sky-wash);
  }
  .kop-menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--sky);
    text-underline-offset: 0.2em;
  }
  .kop-menu-logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .kop-menu-extra {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--navy);
  }
  .kop-sub {
    position: relative;
  }
  .kop-sub > button :global(svg) {
    transition: rotate 0.25s ease;
  }
  .kop-sub > button[aria-expanded='true'] :global(svg) {
    rotate: 180deg;
  }
  .kop-paneel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: -0.5rem;
    width: 21.5rem;
    padding: 0.4rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(0, 40, 58, 0.05), 0 16px 36px -20px rgba(0, 40, 58, 0.35);
    opacity: 0;
    visibility: hidden;
    translate: 0 -4px;
    transition: opacity 0.18s var(--uit), translate 0.22s var(--uit), visibility 0s linear 0.22s;
  }
  .kop-sub[data-open] .kop-paneel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }
  .kop-paneel ul {
    padding: 0;
    list-style: none;
  }
  .kop-paneel a:not(.cijfer) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .kop-paneel a:not(.cijfer):hover,
  .kop-paneel a:not(.cijfer):focus-visible {
    background: var(--sky-wash);
  }
  .kop-paneel-titel {
    font-size: var(--ui);
    font-weight: 600;
    line-height: 1.3;
    color: var(--navy);
  }
  .kop-paneel-tekst {
    grid-row: 2;
    margin-top: 0.1rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--tekst-zacht);
  }
  .kop-paneel a :global(.dak) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--sky-deep);
    opacity: 0;
    translate: -0.2em 0;
    transition: opacity 0.15s ease, translate 0.2s var(--uit);
  }
  .kop-paneel a:hover :global(.dak),
  .kop-paneel a:focus-visible :global(.dak) {
    opacity: 1;
    translate: 0 0;
  }
  .kop-paneel-voet {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.35rem;
    padding: 0.3rem 0.85rem 0.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .kop-paneel-voet .tekstlink {
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    cursor: pointer;
  }
  .kop-paneel-voet .cijfer {
    color: var(--tekst-zacht);
    text-decoration: none;
  }
  .kop-paneel-voet .cijfer:hover {
    color: var(--navy);
  }
  .kop-menuknop {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1.5px solid color-mix(in srgb, var(--navy) 22%, transparent);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--navy);
    cursor: pointer;
  }
  .kop-menuknop span,
  .kop-menuknop span::before {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .kop-menuknop span {
    position: relative;
    translate: 0 -3px;
  }
  .kop-menuknop span::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .kop-menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 1.25rem 1.5rem;
    border: 0;
    background: var(--paper);
    flex-direction: column;
    opacity: 0;
    translate: 0 -12px;
    transition: opacity 0.3s ease, translate 0.35s cubic-bezier(0.22, 1, 0.36, 1), display 0.35s allow-discrete, overlay 0.35s allow-discrete;
  }
  .kop-menu:popover-open {
    display: flex;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .kop-menu:popover-open {
      opacity: 0;
      translate: 0 -12px;
    }
  }
  .kop-menu-balk {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--kop-hoogte);
  }
  .kop-menu-sluit {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid color-mix(in srgb, var(--navy) 22%, transparent);
    border-radius: 50%;
    background: none;
    color: var(--navy);
    cursor: pointer;
  }
  .kop-menu nav {
    margin-top: 1.5rem;
  }
  .kop-menu-groep {
    font-size: var(--klein);
    font-weight: 700;
    color: var(--tekst-zacht);
  }
  .kop-menu ul {
    list-style: none;
    padding: 0;
  }
  .kop-menu-diensten {
    margin-top: 0.4rem;
    padding-bottom: 1rem !important;
    border-bottom: 1px solid var(--line);
  }
  .kop-menu-diensten a,
  .kop-menu-links a {
    display: block;
    padding: 0.45rem 0;
    font-family: var(--font-kop);
    font-size: 1.625rem;
    line-height: 1.25;
    color: var(--navy);
    text-decoration: none;
  }
  .kop-menu-links {
    margin-top: 1rem;
  }
  .kop-menu-acties {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .kop-nav {
      display: block;
    }
    .kop-bel {
      display: inline-flex;
      min-height: 2.75rem;
      padding: 0.5rem 1.15rem;
      font-size: var(--ui);
    }
    .kop-menuknop {
      display: none;
    }
  }

  :global(html:has(#kop-menu:popover-open)) {
    overflow: hidden;
  }

  @supports not (overlay: auto) {
    .kop-menu {
      transition: opacity 0.3s ease, translate 0.35s var(--uit);
      transition: opacity 0.3s ease, translate 0.35s var(--uit), display 0.35s allow-discrete;
    }
  }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]')!;
  const sub = kop.querySelector<HTMLElement>('[data-sub]')!;
  const subKnop = sub.querySelector('button')!;
  const menu = document.getElementById('kop-menu')!;
  let sluitTimer = 0;

  const zetSub = (open: boolean) => {
    clearTimeout(sluitTimer);
    sub.toggleAttribute('data-open', open);
    subKnop.setAttribute('aria-expanded', String(open));
  };

  let doorHover = false;
  subKnop.addEventListener('click', () => {
    const open = sub.hasAttribute('data-open');
    zetSub(doorHover ? true : !open);
    doorHover = false;
  });
  if (matchMedia('(hover: hover)').matches) {
    sub.addEventListener('mouseenter', () => {
      doorHover = !sub.hasAttribute('data-open');
      zetSub(true);
    });
    sub.addEventListener('mouseleave', () => {
      sluitTimer = window.setTimeout(() => zetSub(false), 160);
    });
  }
  sub.addEventListener('focusout', (e) => {
    if (!sub.contains(e.relatedTarget as Node)) zetSub(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sub.hasAttribute('data-open')) {
      zetSub(false);
      subKnop.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!sub.contains(e.target as Node)) zetSub(false);
  });

  sub.querySelectorAll('.kop-paneel a, .kop-paneel button').forEach((el) => el.addEventListener('click', () => zetSub(false)));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
  menu.addEventListener('toggle', (e) => {
    const open = (e as ToggleEvent).newState === 'open';
    const achter = [kop.querySelector('.kop-balk'), ...document.querySelectorAll('body > :not(.kop, script, dialog)')];
    achter.forEach((el) => el?.toggleAttribute('inert', open));
    if (open) menu.querySelector('a')?.focus();
  });

  let vorige = scrollY;
  let bezig = false;
  const opScroll = () => {
    const y = scrollY;
    const open = sub.hasAttribute('data-open') || menu.matches(':popover-open');
    kop.toggleAttribute('data-gescrold', y > 8);
    if (!open && !kop.contains(document.activeElement) && y > 320 && y > vorige + 4) kop.setAttribute('data-verborgen', '');
    else if (y < vorige - 4 || y <= 320) kop.removeAttribute('data-verborgen');
    vorige = y;
    bezig = false;
  };
  addEventListener('scroll', () => {
    if (!bezig) {
      bezig = true;
      requestAnimationFrame(opScroll);
    }
  }, { passive: true });
</script>
