---
import Kruimels from '../Kruimels.astro';
import { huis, huisViewBox } from '../merk';

const { titel, lead, stappen, label } = Astro.props;
const laatste = stappen.length - 1;
---
<section class="rk kamer" aria-labelledby="rk-titel">
  <div class="maat">
    <Kruimels hier={titel} />
    <h1 id="rk-titel">{titel}</h1>
    <p class="rk-lead">{lead}</p>
    <nav class="rk-route" aria-label={label}>
      <ol>
        {stappen.map((s, i) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="rk-cijfer cijfer" aria-hidden="true">
                {i === laatste ? <svg viewBox={huisViewBox}><path d={huis} /></svg> : i + 1}
              </span>
              <span class="rk-naam">{s.titel}</span>
              <span class="rk-kost">{s.kosten.kort}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .rk {
    --boog: clamp(4rem, 2.5rem + 5vw, 8.5rem);
    margin-top: var(--rand);
    padding-block: calc(var(--boog) * 0.85) clamp(2.75rem, 2rem + 3vw, 4.5rem);
    border-radius: 50% 50% var(--radius) var(--radius) / var(--boog) var(--boog) var(--radius) var(--radius);
    background: var(--navy);
    color: var(--sky-wash);
  }
  .rk :focus-visible {
    outline-color: var(--sky);
  }
  .rk :global(.kruimels ol) {
    color: #bcd2e1;
  }
  .rk :global(.kruimels a:hover) {
    color: #fff;
  }
  .rk h1 {
    max-width: 12ch;
    margin-top: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    font-size: min(clamp(3rem, 1.8rem + 4.6vw, 5.5rem), 14vw);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .rk-lead {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: var(--lead);
    line-height: 1.55;
  }

  .rk-route {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .rk-route ol {
    --gat: 0px;
    display: grid;
    padding: 0;
    list-style: none;
  }
  .rk-route li {
    position: relative;
  }
  .rk-route li:not(:last-child)::before,
  .rk-route li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 3.25rem;
    bottom: -0.75rem;
    left: 1.25rem;
    width: 1.5px;
    background: rgba(255, 255, 255, 0.14);
  }
  .rk-route li:not(:last-child)::after {
    background: var(--sky);
    transform-origin: top;
  }
  .rk-route a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 2rem;
    padding-block: 0.6rem;
    color: inherit;
    text-decoration: none;
  }
  .rk-cijfer {
    grid-row: 1 / span 2;
    position: relative;
    z-index: 1;
    padding-block: 0.25rem;
    background: var(--navy);
    font-family: var(--font-kop);
    font-size: 3rem;
    line-height: 1;
    color: var(--sky);
    text-align: center;
  }
  .rk-cijfer svg {
    display: block;
    width: 2.5rem;
    height: auto;
    margin-top: 0.4rem;
    fill: var(--sky);
  }
  .rk-naam {
    align-self: end;
    padding-top: 0.5rem;
    font-family: var(--font-kop);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s ease;
  }
  .rk-route a:hover .rk-naam {
    text-decoration-color: currentColor;
  }
  .rk-kost {
    margin-top: 0.3rem;
    font-size: var(--klein);
    color: #bcd2e1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rk h1,
    .rk-lead,
    .rk-route li {
      animation: rk-in 0.8s var(--uit) both;
    }
    .rk-lead {
      animation-delay: 0.1s;
    }
    .rk-route li:nth-child(1) {
      animation-delay: 0.2s;
    }
    .rk-route li:nth-child(2) {
      animation-delay: 0.3s;
    }
    .rk-route li:nth-child(3) {
      animation-delay: 0.4s;
    }
    .rk-route li:nth-child(4) {
      animation-delay: 0.5s;
    }
    .rk-route li::after {
      animation: rk-lijn-v 0.7s cubic-bezier(0.65, 0, 0.35, 1) both;
    }
    .rk-route li:nth-child(1)::after {
      animation-delay: 0.35s;
    }
    .rk-route li:nth-child(2)::after {
      animation-delay: 0.65s;
    }
    .rk-route li:nth-child(3)::after {
      animation-delay: 0.95s;
    }
  }
  @keyframes rk-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes rk-lijn-v {
    from {
      scale: 1 0;
    }
  }
  @keyframes rk-lijn-h {
    from {
      scale: 0 1;
    }
  }

  @media (min-width: 64rem) {
    .rk {
      padding-top: calc(var(--boog) + 1rem);
      border-radius: min(38vw, 36rem) var(--radius) var(--radius) var(--radius) / var(--boog) var(--radius) var(--radius) var(--radius);
    }
    .rk-route ol {
      --gat: clamp(1.5rem, 3vw, 3rem);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--gat);
    }
    .rk-route li:not(:last-child)::before,
    .rk-route li:not(:last-child)::after {
      top: 2.1rem;
      bottom: auto;
      left: 0;
      width: calc(100% + var(--gat));
      height: 1.5px;
    }
    .rk-route li:not(:last-child)::after {
      transform-origin: left;
      animation-name: rk-lijn-h;
    }
    .rk-route a {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 0;
    }
    .rk-cijfer {
      grid-row: auto;
      justify-self: start;
      padding: 0 1.25rem 0 0;
      font-size: 4.25rem;
      text-align: left;
    }
    .rk-cijfer svg {
      width: 3.75rem;
      margin: 0.35rem 0 0.4rem;
    }
    .rk-naam {
      padding-top: 1.25rem;
    }
  }
</style>
