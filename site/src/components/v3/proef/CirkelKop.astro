---
import Kruimels from '../Kruimels.astro';
import Icoon from '../Icoon.astro';
import home from '../../../content/teksten/v3.json';
import bedrijf from '../../../content/bedrijf.json';

const { titel, lead, stappen = [], onderwerp } = Astro.props;
const t = home.hero;
---
<section class="ck" aria-labelledby="ck-titel">
  <div class="ck-podium">
    <div class="ck-figuur" aria-hidden="true">
      <svg class="ck-lijnen" viewBox="0 0 1156.6 680" preserveAspectRatio="none" focusable="false">
        <path class="ck-hoofd" d="M578.3 97.5A340 340 0 1 0 578.3 582.5A340 340 0 0 0 578.3 97.5" pathLength="1" />
        <path class="ck-hart" d="M578.3 97.5A340 340 0 1 1 578.3 582.5A340 340 0 0 1 578.3 97.5" pathLength="1" />
      </svg>
      <span class="ck-knoop"></span>
      <span class="ck-knoop ck-knoop-onder"></span>
      <span class="ck-woord ck-woord-hoofd">{t.hoofd}</span>
      <span class="ck-woord ck-woord-hart">{t.hart}</span>
    </div>

    <div class="ck-tekst">
      <Kruimels hier={titel} stappen={stappen} />
      <h1 id="ck-titel">{titel}</h1>
      <p class="ck-lead">{lead}</p>
      <div class="ck-acties">
        <button type="button" class="knop knop-vol" data-plan-open data-onderwerp={onderwerp}>
          {t.knop}
          <Icoon naam="dak" maat={12} />
        </button>
        <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink">
          <span>Bel <span class="cijfer">{bedrijf.telefoon}</span></span>
        </a>
      </div>
    </div>
  </div>
  <slot />
</section>

<style>
  .ck {
    --r: min(250px, calc((100vw - 6rem) / 3.4018));
    position: relative;
    overflow: clip;
  }
  .ck-podium {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 7rem 6.5rem;
  }
  .ck-figuur {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    aspect-ratio: 1156.6 / 680;
    translate: -50% 0;
    pointer-events: none;
  }
  .ck-lijnen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ck-lijnen path {
    fill: none;
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .ck-hoofd {
    stroke: var(--sky-deep);
    opacity: 0.6;
  }
  .ck-hart {
    stroke: var(--brown);
    opacity: 0.55;
  }
  .ck-knoop {
    position: absolute;
    left: 50%;
    top: 14.34%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--navy);
    translate: -50% -50%;
  }
  .ck-knoop-onder {
    top: 85.66%;
  }
  .ck-woord {
    position: absolute;
    top: 3.01%;
    padding: 0.25rem 0.6rem;
    background: var(--paper);
    font-family: var(--font-kop);
    font-size: 1.0625rem;
    line-height: 1;
    translate: -50% -50%;
  }
  .ck-woord-hoofd {
    left: 39.45%;
    color: var(--sky-deep);
  }
  .ck-woord-hart {
    left: 60.55%;
    color: var(--brown);
  }

  .ck-tekst {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    width: min(100% - 3rem, 36rem);
    text-align: center;
  }
  .ck-tekst::before {
    content: '';
    position: absolute;
    inset: -1rem -0.5rem -0.5rem;
    z-index: -1;
    border-radius: 1.5rem;
    background: var(--paper);
    box-shadow: 0 0 1rem 0.5rem var(--paper);
  }
  .ck-tekst :global(.kruimels ol) {
    justify-content: center;
  }
  .ck h1 {
    margin-top: 1.25rem;
    font-size: min(clamp(3rem, 2rem + 4vw, 5.25rem), 14vw);
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .ck-lead {
    max-width: 30rem;
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: balance;
  }
  .ck-acties {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .ck-acties {
      flex-direction: row;
      gap: 1rem 1.6rem;
    }
  }

  @media (min-width: 64rem) {
    .ck-podium {
      height: calc(var(--r) * 2 + 3rem);
      padding-block: 1.5rem;
    }
    .ck-figuur {
      top: 1.5rem;
      bottom: 1.5rem;
    }
    .ck-woord {
      top: 50%;
      padding: 0.3rem 0.8rem;
      font-size: 1.125rem;
    }
    .ck-woord-hoofd {
      left: 0;
    }
    .ck-woord-hart {
      left: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ck-tekst > * {
      animation: ck-in 0.9s var(--uit) both;
    }
    .ck h1 {
      animation-delay: 0.12s;
    }
    .ck-lead {
      animation-delay: 0.24s;
    }
    .ck-acties {
      animation-delay: 0.36s;
    }
    .ck-woord,
    .ck-knoop {
      animation: ck-verschijn 0.6s ease-out 1.2s both;
    }
    .ck-lijnen path {
      stroke-dasharray: 1 1;
      animation: ck-teken 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    }
  }
  @keyframes ck-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes ck-verschijn {
    from {
      opacity: 0;
    }
  }
  @keyframes ck-teken {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
