---
import Merk from '../../Merk.astro';
import Kaartregel from '../Kaartregel.astro';
import teksten from '../../../content/teksten/v3-paginas.json';
import kaarten from '../../../content/v3-vergelijkingskaarten.json';

const { titel, intro } = Astro.props;
const k = teksten.kaart;
const beloning = teksten.dienstverlening.beloning;
---
<section class="kv sectie" id="kosten" aria-labelledby="kv-titel">
  <div class="maat">
    <div class="sectie-kop">
      <h2 id="kv-titel" data-regels>{titel}</h2>
      <p data-onthul>{intro}</p>
    </div>

    <div class="kv-vlak" data-onthul>
      <span class="kv-zegel"><Merk breedte={38} /></span>
      <dl class="kv-beloning">
        {beloning.map((b) => (
          <div>
            <dt>{b.titel}</dt>
            <dd>{b.tekst}</dd>
          </div>
        ))}
      </dl>
      {kaarten.toon_prijzen && (
        <div class="kv-prijzen">
          <h3>{k.prijzen_titel}</h3>
          <dl>
            {kaarten.kaarten.map((x) => (
              <div>
                <dt>{x.titel}</dt>
                <dd class="cijfer">{x.prijs_kort}</dd>
              </div>
            ))}
          </dl>
          <p>{k.prijzen_uitleg}</p>
        </div>
      )}
      <div class="kv-kaarten">
        <Kaartregel ids={kaarten.kaarten.map((x) => x.id)} />
      </div>
    </div>
  </div>
</section>

<style>
  .kv {
    padding-bottom: calc(var(--sectie) * 0.4);
  }
  .kv-vlak {
    display: grid;
    gap: 2rem;
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    border-radius: 20px;
    background: var(--sky-wash);
  }
  .kv-zegel {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: #fff;
  }
  .kv-beloning {
    display: grid;
    gap: 2rem;
  }
  .kv-beloning dt {
    font-family: var(--font-kop);
    font-size: var(--h3-kaart);
    line-height: 1.1;
    color: var(--navy);
  }
  .kv-beloning dd {
    max-width: 32rem;
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .kv-prijzen h3 {
    font-size: var(--h3-kaart);
    line-height: 1.1;
    color: var(--navy);
  }
  .kv-prijzen dl {
    margin-top: 1rem;
    border-top: 1px solid var(--vel-rand);
  }
  .kv-prijzen dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--vel-rand);
  }
  .kv-prijzen dd {
    font-weight: 600;
    color: var(--navy);
    white-space: nowrap;
  }
  .kv-prijzen p {
    margin-top: 0.75rem;
    font-size: var(--klein);
    color: var(--tekst-zacht);
  }

  @media (min-width: 48rem) {
    .kv-vlak {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .kv-zegel {
      grid-row: 1 / span 3;
    }
    .kv-beloning {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4rem);
    }
    .kv-beloning > div + div {
      padding-left: clamp(2rem, 4vw, 4rem);
      border-left: 1px solid var(--vel-rand);
    }
    .kv-prijzen,
    .kv-kaarten {
      grid-column: 2;
    }
  }
</style>
