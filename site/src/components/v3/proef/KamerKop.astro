---
import Kruimels from '../Kruimels.astro';
import Icoon from '../Icoon.astro';
import { huis, huisViewBox } from '../merk';
import home from '../../../content/teksten/v3.json';
import paginas from '../../../content/teksten/v3-paginas.json';
import bedrijf from '../../../content/bedrijf.json';

const { titel, lead, situaties = [] } = Astro.props;
---
<section class="kk kamer" aria-labelledby="kk-titel">
  <svg class="kk-huis" viewBox={huisViewBox} aria-hidden="true"><path d={huis} pathLength="1" /></svg>
  <div class="maat kk-raster">
    <div class="kk-kruimel">
      <Kruimels hier={titel} stappen={[{ href: '/#diensten', label: paginas.dienst.kruimel }]} />
    </div>
    <h1 id="kk-titel">{titel}</h1>
    <p class="kk-lead">{lead}</p>
    <ul class="kk-situaties">
      {situaties.map((s) => (
        <li>
          <a href={`#${s.id}`}>
            <Icoon naam="dak" maat={12} />
            {s.titel}
          </a>
        </li>
      ))}
    </ul>
    <div class="kk-acties">
      <button type="button" class="knop knop-licht" data-plan-open data-onderwerp={titel}>
        {home.hero.knop}
        <Icoon naam="dak" maat={12} />
      </button>
      <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink">
        <Icoon naam="bel" maat={15} />
        <span>Bel <span class="cijfer">{bedrijf.telefoon}</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .kk {
    --boog: clamp(4rem, 2.5rem + 5vw, 8.5rem);
    position: relative;
    margin-top: var(--rand);
    padding-block: calc(var(--boog) * 0.85) clamp(2.75rem, 2rem + 3vw, 5rem);
    border-radius: 50% 50% var(--radius) var(--radius) / var(--boog) var(--boog) var(--radius) var(--radius);
    background: var(--navy);
    color: var(--sky-wash);
    overflow: hidden;
    isolation: isolate;
  }
  .kk :focus-visible {
    outline-color: var(--sky);
  }
  .kk-huis {
    position: absolute;
    z-index: -1;
    right: -4.5rem;
    bottom: -7rem;
    width: clamp(17rem, 8rem + 30vw, 42rem);
    height: auto;
    fill: none;
    stroke: var(--sky);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
    opacity: 0.26;
  }
  .kk-raster {
    display: grid;
    grid-template-areas: 'kruimel' 'titel' 'lead' 'sit' 'acties';
  }
  .kk-kruimel {
    grid-area: kruimel;
  }
  .kk :global(.kruimels ol) {
    color: #bcd2e1;
  }
  .kk :global(.kruimels a:hover) {
    color: #fff;
  }
  .kk h1 {
    grid-area: titel;
    margin-top: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    font-size: min(clamp(3.25rem, 1.8rem + 5.6vw, 6.25rem), 15vw);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .kk-lead {
    grid-area: lead;
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: var(--lead);
    line-height: 1.55;
  }
  .kk-situaties {
    grid-area: sit;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .kk-situaties li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .kk-situaties a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }
  .kk-situaties a:hover {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 0.3em;
  }
  .kk-situaties :global(.dak) {
    color: var(--sky);
    rotate: 90deg;
  }
  .kk-acties {
    grid-area: acties;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
  }
  .kk .tekstlink {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }
  .kk .tekstlink:hover {
    text-decoration-color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .kk-raster > * {
      animation: kk-in 0.8s var(--uit) both;
    }
    .kk h1 {
      animation-delay: 0.08s;
    }
    .kk-lead {
      animation-delay: 0.16s;
    }
    .kk-situaties,
    .kk-acties {
      animation-delay: 0.26s;
    }
    .kk-huis path {
      stroke-dasharray: 1 1;
      animation: kk-teken 2.4s cubic-bezier(0.65, 0, 0.35, 1) 0.3s both;
    }
  }
  @keyframes kk-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes kk-teken {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .kk-acties .knop {
      width: 100%;
    }
  }

  @media (min-width: 64rem) {
    .kk {
      padding-top: calc(var(--boog) + 1rem);
      border-radius: min(38vw, 36rem) var(--radius) var(--radius) var(--radius) / var(--boog) var(--radius) var(--radius) var(--radius);
    }
    .kk-raster {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'kruimel .' 'titel .' 'lead sit' 'acties sit';
      column-gap: clamp(3rem, 7vw, 8rem);
    }
    .kk-situaties {
      align-self: end;
      margin-top: 0;
    }
  }
</style>
