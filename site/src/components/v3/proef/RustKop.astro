---
import Kruimels from '../Kruimels.astro';
import Icoon from '../Icoon.astro';
import home from '../../../content/teksten/v3.json';
import bedrijf from '../../../content/bedrijf.json';

const { titel, lead, stappen = [], onderwerp } = Astro.props;
---
<section class="rs" aria-labelledby="rs-titel">
  <div class="maat rs-vak">
    <Kruimels hier={titel} stappen={stappen} />
    <h1 id="rs-titel">{titel}</h1>
    <p class="lead rs-lead">{lead}</p>
    <div class="rs-acties">
      <button type="button" class="knop knop-vol" data-plan-open data-onderwerp={onderwerp}>
        {home.hero.knop}
        <Icoon naam="dak" maat={12} />
      </button>
      <a href={`tel:${bedrijf.telefoon_link}`} class="tekstlink">
        <span>Bel <span class="cijfer">{bedrijf.telefoon}</span></span>
      </a>
    </div>
    <slot />
  </div>
</section>

<style>
  .rs {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .rs-vak {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .rs :global(.kruimels ol) {
    justify-content: center;
  }
  .rs h1 {
    max-width: 14ch;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-size: min(clamp(3.25rem, 1.8rem + 5.8vw, 6.75rem), 15vw);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .rs-lead {
    max-width: 36rem;
    margin-top: 1.75rem;
    text-wrap: balance;
  }
  .rs-acties {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .rs-acties {
      flex-direction: row;
      gap: 1rem 1.6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rs-vak > * {
      animation: rs-in 0.9s var(--uit) both;
    }
    .rs h1 {
      animation-delay: 0.1s;
    }
    .rs-lead {
      animation-delay: 0.2s;
    }
    .rs-acties {
      animation-delay: 0.3s;
    }
    .rs-vak > :nth-child(5) {
      animation-delay: 0.45s;
    }
  }
  @keyframes rs-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
</style>
