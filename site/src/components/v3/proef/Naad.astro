---
import Merk from '../../Merk.astro';

const { id, titel, lead, labels, merk = false } = Astro.props;
---
<section class="nd sectie" id={id} aria-labelledby={`${id}-titel`}>
  <div class="maat">
    <div class="nd-kop">
      <h2 id={`${id}-titel`} data-regels>{titel}</h2>
      {lead && <p class="lead" data-onthul>{lead}</p>}
    </div>

    <div class:list={['nd-blok', { 'nd-met-merk': merk, 'nd-met-labels': labels }]} data-onthul>
      {merk ? (
        <span class="nd-merk"><Merk breedte={200} /></span>
      ) : (
        <span class="nd-zegel"><Merk breedte={34} /></span>
      )}
      {labels && (
        <div class="nd-labels">
          <p class="nd-label nd-label-hoofd"><span>{labels.hoofd.woord}</span>{labels.hoofd.sub}</p>
          <p class="nd-label nd-label-hart"><span>{labels.hart.woord}</span>{labels.hart.sub}</p>
        </div>
      )}
      <slot />
    </div>
    <slot name="onder" />
  </div>
</section>

<style>
  .nd-kop {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  .nd-kop h2 {
    text-wrap: balance;
  }
  .nd-kop p {
    max-width: 34rem;
    margin: 1.5rem auto 0;
  }
  .nd + .nd {
    padding-top: calc(var(--sectie) * 0.3);
  }
  .nd-blok {
    --boog: clamp(3rem, 2rem + 3vw, 5.5rem);
    position: relative;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5rem);
  }
  .nd-blok .nd-labels + :global(.nr)::before {
    content: none;
  }
  .nd-met-merk {
    margin-top: calc(clamp(3rem, 2rem + 3vw, 4.5rem) + 4.5rem);
  }
  .nd-merk,
  .nd-zegel {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    translate: -50% -50%;
  }
  .nd-merk {
    translate: -50% -42%;
  }
  .nd-merk :global(svg) {
    display: block;
    width: clamp(8rem, 6rem + 6vw, 12rem);
    height: auto;
  }
  .nd-zegel {
    top: calc(var(--boog) * 0.4);
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 6px var(--paper);
  }
  .nd-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 50% 50% 0 0 / var(--boog) var(--boog) 0 0;
    overflow: hidden;
  }
  .nd-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: calc(var(--boog) + 2rem) 1rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy);
    text-align: center;
  }
  .nd-met-merk .nd-label {
    padding-top: calc(var(--boog) + 3.5rem);
  }
  .nd-label span {
    font-family: var(--font-kop);
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .nd-label-hoofd {
    background: var(--sky-wash);
  }
  .nd-label-hoofd span {
    color: var(--sky-deep);
  }
  .nd-label-hart {
    background: var(--wash-warm);
  }
  .nd-label-hart span {
    color: var(--brown);
  }

  @media (min-width: 48rem) {
    .nd-labels {
      border-radius: 0;
      overflow: visible;
    }
    .nd-label-hoofd {
      border-radius: 50% 50% 0 0 / var(--boog) var(--boog) 0 0;
    }
    .nd-label-hart {
      border-radius: 50% 50% 0 0 / var(--boog) var(--boog) 0 0;
    }
    .nd-zegel {
      top: var(--boog);
    }
  }
</style>
