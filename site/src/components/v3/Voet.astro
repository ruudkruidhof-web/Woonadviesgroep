---
import Icoon from './Icoon.astro';
import Merk from '../Merk.astro';
import diensten from '../../content/v3-diensten.json';
import kaarten from '../../content/v3-vergelijkingskaarten.json';
import teksten from '../../content/teksten/v3.json';
import bedrijf from '../../content/bedrijf.json';

const t = teksten.voet;
const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${bedrijf.adres_straat}, ${bedrijf.adres_plaats}`)}`;
---
<footer class="voet">
  <div class="maat voet-top">
    <p class="voet-zin">{bedrijf.tagline}</p>
    <div class="voet-zegel" aria-hidden="true">
      <Merk breedte={220} />
    </div>
    <p class="voet-direct">
      <a href={`tel:${bedrijf.telefoon_link}`} class="voet-bel">
        <span class="cijfer">{bedrijf.telefoon}</span>
        <Icoon naam="dak" maat={18} />
      </a>
      <a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a>
    </p>
  </div>

  <div class="maat voet-raster">
    <nav aria-label="Diensten">
      <h2>Diensten</h2>
      <ul>
        {diensten.map((d) => <li><a href={`/${d.id}`}>{d.titel}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2>{t.kaarten_titel}</h2>
      <ul>
        {kaarten.kaarten.map((k) => (
          <li>
            <a href={k.url} target="_blank" rel="noopener">
              <span class="sr-alleen">Vergelijkingskaart </span>{k.titel}<span class="sr-alleen"> (pdf)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2>{t.kantoor_titel}</h2>
      <ul>
        <li>{bedrijf.adres_straat}</li>
        <li>{bedrijf.adres_plaats}</li>
        <li><a href={route} target="_blank" rel="noopener">{t.route}</a></li>
      </ul>
    </div>
    <div>
      <h2>{t.registraties_titel}</h2>
      <ul class="cijfer">
        <li>AFM {bedrijf.afm}</li>
        <li>Kifid {bedrijf.kifid}</li>
        <li>KvK {bedrijf.kvk}</li>
      </ul>
    </div>
  </div>

  <div class="maat voet-onder">
    <p>&copy; {new Date().getFullYear()} {bedrijf.naam}, {t.handelsnaam}</p>
    <ul>
      <li><a href="/onze-dienstverlening">{t.dienstverlening}</a></li>
      <li><a href="/onze-dienstverlening#klachten">Klachten</a></li>
      <li><a href="/privacy-en-cookies">Privacy en cookies</a></li>
    </ul>
  </div>
</footer>

<style>
  .voet {
    padding: clamp(4rem, 3rem + 5vw, 7rem) 0 clamp(1.5rem, 1rem + 1vw, 2.25rem);
    background: #002c40;
    color: #bcd2e1;
    font-size: var(--ui);
  }
  .voet-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) 2rem;
    align-items: start;
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .voet-zin {
    max-width: 15ch;
    font-family: var(--font-kop);
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .voet-zegel {
    display: grid;
    place-items: center;
    width: clamp(4.5rem, 2.5rem + 7vw, 9rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
  }
  .voet-zegel :global(svg) {
    width: 58%;
    height: auto;
  }
  .voet-direct {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem clamp(1.5rem, 4vw, 3.5rem);
  }
  .voet-direct a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .voet-bel {
    gap: 0.9rem;
    font-family: var(--font-kop);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
    color: var(--sky);
    text-decoration: none;
  }
  .voet-bel :global(.dak) {
    transition: translate 0.25s var(--uit);
  }
  .voet-bel:hover {
    color: #fff;
  }
  .voet-bel:hover :global(.dak) {
    translate: 0.25em 0;
  }

  .voet-raster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.5rem;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-block: 1px solid rgba(255, 255, 255, 0.14);
  }
  .voet h2 {
    font-family: var(--font-tekst);
    font-size: var(--ui);
    font-weight: 600;
    letter-spacing: 0;
    color: #fff;
  }
  .voet ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .voet-raster ul {
    margin-top: 0.35rem;
  }
  .voet-raster li {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    line-height: 1.3;
  }
  .voet-raster a,
  .voet-onder a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .voet a:not(.voet-bel) {
    color: #bcd2e1;
    text-decoration: none;
  }
  .voet a:not(.voet-bel):hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .voet :focus-visible {
    outline-color: var(--sky);
  }

  .voet-onder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-top: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    font-size: var(--klein);
  }
  .voet-onder ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  @media (min-width: 48rem) {
    .voet-raster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
