  .verhaal-beeld blockquote {
    position: absolute;
    left: -0.75rem;
    right: 2.5rem;
    bottom: -1.75rem;
    background: var(--brown);
    color: #f6efe9;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    padding: 1.2rem 1.5rem;
    border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgba(83, 60, 55, 0.5);
  }
  .verhaal-tekst h2 {
    margin-bottom: 1.3rem;
  }
  .verhaal-tekst p + p {
    margin-top: 1.05rem;
  }

  .route {
    position: relative;
    margin-top: 0;
    padding-block: 5rem 5.5rem;
    background:
      radial-gradient(120% 90% at 12% 0%, #0d4a66 0%, transparent 60%),
      linear-gradient(165deg, #003850 0%, #012c40 100%);
    color: #cfe0ec;
    overflow: clip;
  }
  .route h2 {
    color: #fff;
  }
  .route-intro {
    margin-top: 1rem;
    max-width: 56ch;
    color: #b6cddd;
  }
  .route-vlak {
    position: relative;
    margin-top: 3.4rem;
  }
  .route-pad {
    display: none;
    position: absolute;
    top: 1.4rem;
    left: 0;
    width: 100%;
    height: 3.4rem;
    color: rgba(106, 171, 218, 0.6);
    pointer-events: none;
  }
  .stations {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 1.4rem;
  }
  .station {
    position: relative;
    padding: 1.9rem 1.8rem 1.7rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(133, 176, 205, 0.22);
    border-radius: var(--radius);
    backdrop-filter: blur(2px);
  }
  .station-nr {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: linear-gradient(150deg, #0d4a66, #003850);
    border: 1.5px solid var(--sky);
    color: #fff;
    margin-bottom: 1rem;
  }
  .station-nr i {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--sky);
    color: #012c40;
    font-family: var(--font-kop);
    font-style: italic;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .station:nth-child(2) .station-nr {
    border-color: color-mix(in srgb, var(--brown) 55%, #fff 25%);
  }
  .station:nth-child(2) .station-nr i {
    background: color-mix(in srgb, var(--brown) 55%, #fff 25%);
  }
  .station h3 {
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
  }
  .station p {
    margin-top: 0.55rem;
    font-size: 0.97rem;
    color: #b6cddd;
  }
  .route-einde {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 2rem 0 0 0.3rem;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.55rem;
    color: #fff;
  }
  .route-einde svg {
    color: var(--sky);
    flex-shrink: 0;
  }
  .route-cta {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    margin-top: 3rem;
    padding-top: 2.4rem;
    border-top: 1px solid rgba(133, 176, 205, 0.2);
  }
  .route-cta p {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: #fff;
    max-width: 34ch;
  }
  .knop-wit-vol {
    margin-top: 1.1rem;
    background: #fff;
    color: var(--navy);
  }
  .knop-wit-vol:hover {
    background: var(--sky-wash);
  }
  .route-bel {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: #9fbdd2;
    text-decoration: none;
  }
  .route-bel:hover {
    color: #fff;
  }

  .situaties {
    background: linear-gradient(180deg, var(--wash-warm-licht), var(--paper));
  }
  .situatie-kaarten {
    list-style: none;
    margin: 2.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .situatie-kaarten > li {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.8rem 1.6rem 1.6rem;
    transition: translate 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .situatie-kaarten > li::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--sky);
    scale: 1 0;
    transform-origin: top;
    transition: scale 0.3s ease;
  }
  .situatie-kaarten > li:nth-child(even)::before {
    background: var(--brown);
  }
  .situatie-kaarten > li:hover {
    translate: 0 -0.35rem;
    border-color: transparent;
    box-shadow: 0 26px 48px -28px rgba(0, 56, 80, 0.45);
  }
  .situatie-kaarten > li:hover::before {
    scale: 1 1;
  }
  .situatie-nr {
    position: absolute;
    top: 0.9rem;
    right: 1.1rem;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--line);
    transition: color 0.25s ease;
  }
  .situatie-kaarten > li:hover .situatie-nr {
    color: var(--sky);
  }
  .situatie-icoon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--sky-wash);
    color: var(--sky-deep);
    transition: scale 0.25s ease;
  }
  .situatie-kaarten > li:nth-child(even) .situatie-icoon {
    background: var(--wash-warm);
    color: var(--brown);
  }
  .situatie-kaarten > li:hover .situatie-icoon {
    scale: 1.08;
  }
  .situatie-kaarten h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }
  .situatie-kaarten p {
    font-size: 0.94rem;
  }
  .situatie-kaarten a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.3rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--sky-deep);
    text-decoration: none;
  }
  .situatie-kaarten a::after {
    content: '→';
    transition: translate 0.2s ease;
  }
  .situatie-kaarten a:hover::after {
    translate: 0.25rem 0;
  }

  .artikelen {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.2rem;
  }
  .artikelen img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    transition: scale 0.4s ease;
  }
  .artikelen article:hover img {
    scale: 1.015;
  }
  .artikelen time {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1rem;
    color: var(--brown);
  }
  .artikelen h3 {
    margin-top: 0.45rem;
    font-size: 1.35rem;
    font-weight: 500;
    max-width: 24ch;
  }
  .artikelen p {
    margin-top: 0.55rem;
    font-size: 0.96rem;
    max-width: 46ch;
  }
  .artikelen-rest {
    display: grid;
    gap: 2.5rem;
  }

  .manifest {
    overflow: clip;
  }
  .manifest-grid {
    display: grid;
    gap: 1.6rem;
  }
  .manifest-tekst-blok {
    background: linear-gradient(160deg, var(--sky-wash), color-mix(in srgb, var(--sky-wash) 40%, var(--paper)));
    border-radius: calc(var(--radius) * 1.4);
    padding: 2.4rem 2.2rem;
  }
  .manifest-merk {
    display: block;
    margin-bottom: 1.2rem;
  }
  .manifest-tekst-blok h2 {
    max-width: 14ch;
  }
  .manifest-tekst-blok p {
    font-size: 1rem;
    max-width: 46ch;
    margin-top: 1rem;
  }
  .faq {
    background: var(--navy);
    color: #cfe0ec;
    border-radius: calc(var(--radius) * 1.4);
    padding: 2.4rem 2.2rem;
  }
  .faq h3 {
    color: #fff;
    font-size: clamp(1.9rem, 3.5vw, 2.3rem);
    line-height: 1.1;
    padding-bottom: 1.1rem;
  }
  .faq h3::after {
    content: '';
    display: block;
    width: 2.6rem;
    height: 3px;
    margin-top: 0.9rem;
    border-radius: 2px;
    background: var(--sky);
  }
  .faq-lijst {
    margin-top: 0.4rem;
  }
  .faq details {
    border-bottom: 1px solid rgba(133, 176, 205, 0.28);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-kop);
    font-size: 1.12rem;
    color: #fff;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-teken {
    position: relative;
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
  }
  .faq-teken::before,
  .faq-teken::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    border-radius: 1px;
    background: var(--sky);
    transition: rotate 0.3s ease;
  }
  .faq-teken::after {
    rotate: 90deg;
  }
  .faq details[open] .faq-teken::after {
    rotate: 0deg;
  }
  .faq details p {
    padding: 0 0 1.15rem;
    font-size: 0.96rem;
    line-height: 1.6;
    color: #b6cddd;
    max-width: 52ch;
  }

  .contact {
    position: relative;
    margin-top: 6.5rem;
    padding-block: 5.5rem;
    overflow: hidden;
  }
  .contact-achtergrond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(0, 56, 80, 0.92) 25%, rgba(0, 56, 80, 0.6) 70%, rgba(0, 56, 80, 0.4));
  }
  .contact-inhoud {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-areas: 'tekst' 'kaartje' 'kanalen';
    gap: 2.6rem;
    align-items: center;
  }
  .contact-tekst {
    grid-area: tekst;
  }
  .contact .kaartje {
    grid-area: kaartje;
  }
  .kanalen {
    grid-area: kanalen;
    display: grid;
    gap: 1rem;
  }
  .contact h2 {
    color: #fff;
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    max-width: 16ch;
  }
  .contact-tekst > p {
    color: #d7e6f0;
    margin-top: 1rem;
    max-width: 46ch;
  }
  .kanaal {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'icoon titel pijl' 'icoon detail pijl';
    column-gap: 0.9rem;
    align-items: center;
    background: rgba(251, 250, 248, 0.97);
    border: 0;
    border-radius: 14px;
    padding: 0.95rem 1.15rem;
    font: inherit;
    text-align: left;
    text-decoration: none;
    color: var(--navy-soft);
    cursor: pointer;
    transition: translate 0.22s ease, box-shadow 0.22s ease;
  }
  .kanaal:hover {
    translate: 0 -0.25rem;
    box-shadow: 0 24px 44px -26px rgba(0, 20, 30, 0.85);
  }
  .kanaal-bel {
    --kanaal-kleur: var(--sky-deep);
  }
  .kanaal-app {
    --kanaal-kleur: #128c4b;
  }
  .kanaal-plan {
    --kanaal-kleur: var(--brown);
  }
  .kanaal-icoon {
    grid-area: icoon;
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--kanaal-kleur) 15%, #fff);
    color: var(--kanaal-kleur);
  }
  .kanaal-titel {
    grid-area: titel;
    align-self: end;
    font-family: var(--font-kop);
    font-size: 1.12rem;
    font-weight: 560;
    color: var(--navy);
  }
  .kanaal-detail {
    grid-area: detail;
    align-self: start;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--kanaal-kleur);
  }
  .kanaal-sub {
    display: none;
  }
  .kanaal-pijl {
    grid-area: pijl;
    font-size: 1.05rem;
    color: var(--kanaal-kleur);
    translate: -0.2rem 0;
    opacity: 0.5;
    transition: opacity 0.22s ease, translate 0.22s ease;
  }
  .kanaal:hover .kanaal-pijl {
    opacity: 1;
    translate: 0 0;
  }

  .kaartje {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 2.2rem 2rem 1.8rem;
    box-shadow: 0 40px 70px -30px rgba(0, 20, 30, 0.75);
    rotate: 1deg;
  }
  .kaartje-merk {
    display: block;
  }
  .kaartje-naam {
    margin-top: 1.1rem;
    font-family: var(--font-kop);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
  }
  .kaartje-motto {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1rem;
    color: var(--brown);
    margin-top: 0.3rem;
  }
  .kaartje-gegevens {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.55rem 1rem;
    margin: 1.6rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }
  .kaartje-gegevens dt {
    font-weight: 600;
    color: var(--navy);
  }
  .kaartje-gegevens dd {
    margin: 0;
    color: var(--navy-soft);
  }
  .kaartje-gegevens a {
    color: var(--sky-deep);
    text-decoration: none;
  }
  .kaartje-gegevens a:hover {
    text-decoration: underline;
  }
  .kaartje-voet {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    color: #7f95a5;
  }

  #plan-dialoog {
    width: min(92vw, 56rem);
    max-height: min(92vh, 46rem);
    margin: auto;
    border: 0;
    border-radius: 22px;
    padding: 0;
    background: var(--paper);
    box-shadow: 0 60px 120px -40px rgba(0, 30, 44, 0.6);
  }
  #plan-dialoog::backdrop {
    background: rgba(0, 30, 44, 0.55);
    backdrop-filter: blur(4px);
  }
  #plan-dialoog[open] {
    display: grid;
  }
  .dialoog-merk {
    display: none;
    flex-direction: column;
    background: linear-gradient(160deg, var(--navy), #0d4a66);
    color: #d7e6f0;
  }
  .dialoog-foto {
    width: 100%;
    height: 13rem;
    object-fit: cover;
    object-position: center 20%;
  }
  .dialoog-merk-inhoud {
    display: flex;
    flex-direction: column;
    align-items: start;
    flex: 1;
    padding: 1.7rem 2.2rem 2.4rem;
  }
  .dialoog-motto {
    font-family: var(--font-kop);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.3;
    color: #fff;
    max-width: 16ch;
  }
  .dialoog-wie {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--sky);
    font-weight: 600;
  }
  .dialoog-sub {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.9rem;
  }
  .dialoog-merk a {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1.5px solid var(--sky);
    align-self: start;
    margin-top: 0.3rem;
  }
  .dialoog-merk a + a {
    margin-top: 0.6rem;
  }
  #plan-dialoog form {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 2.2rem 1.8rem;
  }
  #plan-dialoog form h3 {
    font-size: 1.7rem;
  }
  .dialoog-intro {
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }
  #plan-dialoog label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
  }
  #plan-dialoog label span {
    font-weight: 400;
    color: var(--navy-soft);
  }
  #plan-dialoog input,
  #plan-dialoog select,
  #plan-dialoog textarea {
    font: inherit;
    font-weight: 400;
    color: var(--navy);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
  }
  #plan-dialoog input:focus-visible,
  #plan-dialoog select:focus-visible,
  #plan-dialoog textarea:focus-visible {
    outline: 2px solid var(--sky-deep);
    outline-offset: 1px;
  }
  #plan-dialoog form .knop {
    justify-self: start;
    margin-top: 0.4rem;
  }
  .dialoog-sluit {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
  }
  .dialoog-sluit:hover {
    border-color: var(--sky);
    color: var(--sky-deep);
  }
  .dialoog-succes {
    display: grid;
    justify-items: start;
    gap: 0.8rem;
    padding: 2.6rem 2.2rem;
  }
  .dialoog-succes[hidden] {
    display: none;
  }
  .dialoog-succes svg {
    color: var(--brown);
  }
  .dialoog-succes h3 {
    font-size: 1.6rem;
  }
  .dialoog-succes p {
    max-width: 38ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .stempel svg,
    .stroom-spoor {
      animation: none;
    }
    .stroom {
      overflow-y: auto;
    }
  }

  @media (min-width: 720px) {
    .situatie-kaarten {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 2.5rem 3rem;
    }
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.25rem;
      align-items: center;
    }
    .hero-beeld {
      justify-self: end;
      width: min(100%, 23rem);
      rotate: 1.2deg;
      margin-right: 0.5rem;
    }
    .zekerheden {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      margin-top: 1.6rem;
      font-size: 0.9rem;
    }
    .zekerheden li + li {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
    section:not(.hero) {
      padding-top: 6.5rem;
    }
    .register-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: 4.5rem;
    }
    .register-beeld {
      display: block;
      position: sticky;
      top: 7rem;
      width: min(100%, 22rem);
      justify-self: end;
      aspect-ratio: 3 / 4;
      border-radius: 999px 999px var(--radius) var(--radius);
      overflow: hidden;
      box-shadow: 0 30px 60px -30px rgba(0, 56, 80, 0.4);
    }
    .register-beeld img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .register-beeld img.actief {
      opacity: 1;
    }
    summary {
      grid-template-columns: 3.2rem 1fr auto;
      padding-block: 1.8rem;
    }
    .reviews-grid {
      grid-template-columns: 0.92fr 1.05fr 0.85fr;
      gap: 2.5rem;
      align-items: stretch;
    }
    .reviews-tekst {
      align-self: center;
    }
    .uitgelicht {
      aspect-ratio: auto;
      height: 31rem;
    }
    .stroom {
      height: 31rem;
    }
    .verhaal {
      margin-top: 6.5rem;
      padding-block: 6rem 6.5rem;
    }
    .verhaal-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
    .verhaal-beeld {
      justify-self: start;
      rotate: -1.2deg;
    }
    .verhaal-beeld blockquote {
      left: auto;
      right: -3.5rem;
      bottom: 2.5rem;
      max-width: 17rem;
      rotate: 1.2deg;
    }
    .route-vlak {
      margin-top: 4rem;
    }
    .route-pad {
      display: block;
    }
    .stations {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
    .route-einde {
      position: absolute;
      top: -3.6rem;
      right: 0;
      margin: 0;
    }
    .route-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 1.5rem 3rem;
    }
    .route-cta p {
      grid-row: span 2;
    }
    .knop-wit-vol {
      margin-top: 0;
      justify-self: end;
    }
    .route-bel {
      margin-top: 0;
      justify-self: end;
    }
    .situatie-kaarten {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.2rem;
    }
    .artikelen {
      grid-template-columns: 1.5fr 1fr;
      gap: 3.5rem;
    }
    .artikel-groot img {
      aspect-ratio: 4 / 3;
    }
    .artikel-groot h3 {
      font-size: 1.8rem;
    }
    .artikelen-rest {
      gap: 3rem;
    }
    .artikelen-rest article {
      display: grid;
      grid-template-columns: 9.5rem 1fr;
      gap: 1.4rem;
      align-items: start;
    }
    .artikelen-rest img {
      aspect-ratio: 1;
    }
    .artikelen-rest time {
      margin-top: 0;
    }
    .manifest-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 2rem;
      align-items: stretch;
    }
    .contact {
      margin-top: 7rem;
      padding-block: 6.5rem;
    }
    .contact-inhoud {
      grid-template-columns: 1.25fr 0.75fr;
      grid-template-areas: 'tekst kaartje' 'kanalen kanalen';
      gap: 3.5rem 4rem;
    }
    .kaartje {
      justify-self: end;
      width: min(100%, 23rem);
    }
    .kanalen {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 0.5rem;
    }
    #plan-dialoog[open] {
      grid-template-columns: 1fr 1.4fr;
    }
    .dialoog-merk {
      display: flex;
    }
    #plan-dialoog form {
      padding: 2.6rem 2.6rem 2.4rem;
    }
    .dialoog-succes {
      grid-column: 2;
      padding: 3.2rem 2.6rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero h1 .regel, .hero .intro, .hero-acties, .hero-scores, .zekerheden, .hero-beeld', {
      opacity: 0,
      y: 24,
      duration: 0.9,
      ease: 'power2.out',
      stagger: 0.07,
    });
    gsap.from('.stempel', { opacity: 0, scale: 0.6, duration: 0.7, ease: 'back.out(1.6)', delay: 1 });
    gsap.from('.hero-stat', { opacity: 0, y: -14, rotate: -4, duration: 0.7, ease: 'back.out(1.6)', delay: 1.2 });

    const lijn = document.querySelector('.rust-lijn path');
    const lijnLengte = lijn.getTotalLength();
    gsap.fromTo(
      lijn,
      { strokeDasharray: lijnLengte, strokeDashoffset: lijnLengte },
      { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut', delay: 0.9 }
    );

    gsap.to('.hero-beeld', {
      y: -12,
      duration: 3.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 1.6,
    });
    gsap.to('.hero-blob-blauw', {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.hero-blob-warm', {
      yPercent: -14,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });

    const padVlak = document.querySelector('.route-pad');
    if (padVlak && getComputedStyle(padVlak).display !== 'none') {
      gsap.fromTo(
        '.route-pad',
        { clipPath: 'inset(0 100% 0 0)', opacity: 0 },
        {
          clipPath: 'inset(0 0% 0 0)',
          opacity: 1,
          ease: 'none',
          scrollTrigger: { trigger: '.route-vlak', start: 'top 85%', end: 'top 45%', scrub: 0.4 },
        }
      );
    }

    document.querySelectorAll('.reveal').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });
  });

  mm.add('(prefers-reduced-motion: reduce)', () => {
    gsap.set('.reveal, .route-pad', { opacity: 1, clearProps: 'clipPath' });
  });

  const beelden = document.querySelectorAll('.register-beeld img');
  const kies = (index) => {
    beelden.forEach((b) => b.classList.toggle('actief', b.dataset.index === index));
  };

  const rijen = [...document.querySelectorAll('.register-rijen > li')];
  const animatieOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  const sluit = (details) => {
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) {
      details.open = false;
      return;
    }
    gsap.to(klep, {
      height: 0,
      opacity: 0,
      duration: 0.35,
      ease: 'power2.inOut',
      onComplete: () => {
        details.open = false;
        gsap.set(klep, { clearProps: 'all' });
      },
    });
  };

  const openen = (details) => {
    details.open = true;
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) return;
    gsap.fromTo(
      klep,
      { height: 0, opacity: 0 },
      { height: 'auto', opacity: 1, duration: 0.45, ease: 'power2.out', onComplete: () => gsap.set(klep, { clearProps: 'all' }) }
    );
  };

  rijen.forEach((rij) => {
    const details = rij.querySelector('details');
    rij.querySelector('summary').addEventListener('click', (e) => {
      e.preventDefault();
      if (details.open) {
        sluit(details);
        return;
      }
      rijen.forEach((andere) => {
        const d = andere.querySelector('details');
        if (d !== details && d.open) sluit(d);
      });
      openen(details);
      kies(rij.dataset.index);
    });
    rij.addEventListener('mouseenter', () => kies(rij.dataset.index));
    rij.addEventListener('focusin', () => kies(rij.dataset.index));
  });

  document.querySelectorAll('.faq details').forEach((det) => {
    const antwoord = det.querySelector('p');
    det.querySelector('summary').addEventListener('click', (e) => {
      e.preventDefault();
      if (!animatieOk) {
        det.open = !det.open;
        return;
      }
      if (det.open) {
        gsap.to(antwoord, {
          height: 0,
          opacity: 0,
          overflow: 'hidden',
          duration: 0.3,
          ease: 'power2.inOut',
          onComplete: () => {
            det.open = false;
            gsap.set(antwoord, { clearProps: 'all' });
          },
        });
      } else {
        det.open = true;
        gsap.fromTo(
          antwoord,
          { height: 0, opacity: 0, overflow: 'hidden' },
          { height: 'auto', opacity: 1, duration: 0.4, ease: 'power2.out', onComplete: () => gsap.set(antwoord, { clearProps: 'all' }) }
        );
      }
    });
  });

  const dialoog = document.getElementById('plan-dialoog');
  const formulier = dialoog.querySelector('form');
  const succes = dialoog.querySelector('.dialoog-succes');
  const onderwerp = formulier.querySelector('select');

  document.querySelectorAll('[data-plan-open]').forEach((knop) => {
    knop.addEventListener('click', (e) => {
      e.preventDefault();
      formulier.hidden = false;
      succes.hidden = true;
      if (knop.dataset.dienst) onderwerp.value = knop.dataset.dienst;
      dialoog.showModal();
      formulier.querySelector('input').focus();
      if (animatieOk) {
        gsap.from(dialoog, { opacity: 0, y: 18, scale: 0.97, duration: 0.35, ease: 'power2.out' });
      }
    });
  });
  dialoog.querySelectorAll('.dialoog-sluit, .dialoog-sluit-2').forEach((k) => {
    k.addEventListener('click', () => dialoog.close());
  });
  dialoog.addEventListener('click', (e) => {
    if (e.target === dialoog) dialoog.close();
  });
  formulier.addEventListener('submit', (e) => {
    // Conceptfase: nog geen backend gekoppeld, de tracker leest het formulier via data-hb-lead
    e.preventDefault();
    formulier.hidden = true;
    succes.hidden = false;
  });
</script>
