      gap: 4rem;
    }
    .kaartje {
      justify-self: end;
      width: min(100%, 23rem);
    }
    .kanalen {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 0.5rem;
    }
    #plan-dialoog[open] {
      grid-template-columns: 1fr 1.4fr;
    }
    .dialoog-merk {
      display: flex;
    }
    #plan-dialoog form {
