    }
    .dialoog-succes {
      grid-column: 2;
      padding: 3.2rem 2.6rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero h1 .regel, .hero .intro, .hero-acties, .zekerheden, .hero-beeld', {
      opacity: 0,
      y: 26,
      duration: 0.9,
      ease: 'power2.out',
      stagger: 0.09,
    });
    gsap.from('.stempel', { opacity: 0, scale: 0.6, duration: 0.7, ease: 'back.out(1.6)', delay: 1 });
    gsap.from('.hero-stat', { opacity: 0, y: -14, rotate: -4, duration: 0.7, ease: 'back.out(1.6)', delay: 1.2 });

    const lijn = document.querySelector('.rust-lijn path');
    const lijnLengte = lijn.getTotalLength();
    gsap.fromTo(
      lijn,
      { strokeDasharray: lijnLengte, strokeDashoffset: lijnLengte },
      { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut', delay: 0.9 }
    );

    gsap.to('.hero-beeld', {
      y: -12,
      duration: 3.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: 1.6,
    });
    gsap.to('.hero-blob-blauw', {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.hero-blob-warm', {
      yPercent: -14,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });

    const pad = document.querySelector('.route-pad path');
    const padZichtbaar = () => getComputedStyle(document.querySelector('.route-pad')).display !== 'none';
    if (pad && padZichtbaar()) {
      gsap.fromTo(
        pad,
        { strokeDasharray: `7 7`, strokeDashoffset: 0, opacity: 0 },
        {
          opacity: 1,
          duration: 0.1,
          scrollTrigger: { trigger: '.route-vlak', start: 'top 95%', once: true },
        }
      );
      gsap.fromTo(
        '.route-pad',
        { clipPath: 'inset(0 100% 0 0)' },
        {
          clipPath: 'inset(0 0% 0 0)',
          ease: 'none',
          scrollTrigger: { trigger: '.route-vlak', start: 'top 92%', end: 'top 58%', scrub: 0.4 },
        }
      );
    }

    document.querySelectorAll('.reveal').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });
  });

  mm.add('(prefers-reduced-motion: reduce)', () => {
    gsap.set('.reveal, .route-pad', { opacity: 1, clearProps: 'clipPath' });
  });

  const beelden = document.querySelectorAll('.register-beeld img');
  const kies = (index) => {
    beelden.forEach((b) => b.classList.toggle('actief', b.dataset.index === index));
  };

  const rijen = [...document.querySelectorAll('.register-rijen > li')];
  const animatieOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  const sluit = (details) => {
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) {
      details.open = false;
      return;
    }
    gsap.to(klep, {
      height: 0,
      opacity: 0,
      duration: 0.35,
      ease: 'power2.inOut',
      onComplete: () => {
        details.open = false;
        gsap.set(klep, { clearProps: 'all' });
      },
    });
  };

  const openen = (details) => {
    details.open = true;
    const klep = details.querySelector('.register-klep');
    if (!animatieOk) return;
    gsap.fromTo(
      klep,
      { height: 0, opacity: 0 },
      { height: 'auto', opacity: 1, duration: 0.45, ease: 'power2.out', onComplete: () => gsap.set(klep, { clearProps: 'all' }) }
    );
  };

  rijen.forEach((rij) => {
    const details = rij.querySelector('details');
    rij.querySelector('summary').addEventListener('click', (e) => {
      e.preventDefault();
      if (details.open) {
        sluit(details);
        return;
      }
      rijen.forEach((andere) => {
        const d = andere.querySelector('details');
        if (d !== details && d.open) sluit(d);
      });
      openen(details);
      kies(rij.dataset.index);
    });
    rij.addEventListener('mouseenter', () => kies(rij.dataset.index));
    rij.addEventListener('focusin', () => kies(rij.dataset.index));
  });

  const quotes = [...document.querySelectorAll('.quote-wissel > li')];
  const dots = [...document.querySelectorAll('.quote-dots button')];
  let quoteIndex = 0;
  let quoteTimer;

  const toonQuote = (i) => {
    quoteIndex = i;
    quotes.forEach((q, j) => q.classList.toggle('actief', j === i));
    dots.forEach((d, j) => d.setAttribute('aria-pressed', String(j === i)));
  };
  const startQuotes = () => {
    if (!animatieOk || quotes.length < 2) return;
    quoteTimer = setInterval(() => toonQuote((quoteIndex + 1) % quotes.length), 7000);
  };
  const stopQuotes = () => clearInterval(quoteTimer);

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      stopQuotes();
      toonQuote(Number(dot.dataset.index));
      startQuotes();
    });
  });
  const stemmenVlak = document.querySelector('.stemmen-vlak');
  stemmenVlak.addEventListener('mouseenter', stopQuotes);
  stemmenVlak.addEventListener('mouseleave', startQuotes);
  stemmenVlak.addEventListener('focusin', stopQuotes);
  new IntersectionObserver(([zichtbaar]) => {
    stopQuotes();
    if (zichtbaar.isIntersecting) startQuotes();
  }, { threshold: 0.35 }).observe(stemmenVlak);

  const dialoog = document.getElementById('plan-dialoog');
  const formulier = dialoog.querySelector('form');
  const succes = dialoog.querySelector('.dialoog-succes');
  const onderwerp = formulier.querySelector('select');

  document.querySelectorAll('[data-plan-open]').forEach((knop) => {
    knop.addEventListener('click', (e) => {
      e.preventDefault();
      formulier.hidden = false;
      succes.hidden = true;
      if (knop.dataset.dienst) onderwerp.value = knop.dataset.dienst;
      dialoog.showModal();
      formulier.querySelector('input').focus();
      if (animatieOk) {
        gsap.from(dialoog, { opacity: 0, y: 18, scale: 0.97, duration: 0.35, ease: 'power2.out' });
      }
    });
  });
  dialoog.querySelectorAll('.dialoog-sluit, .dialoog-sluit-2').forEach((k) => {
    k.addEventListener('click', () => dialoog.close());
  });
  dialoog.addEventListener('click', (e) => {
    if (e.target === dialoog) dialoog.close();
  });
  formulier.addEventListener('submit', (e) => {
    // Conceptfase: nog geen backend gekoppeld, de tracker leest het formulier via data-hb-lead
    e.preventDefault();
    formulier.hidden = true;
    succes.hidden = false;
  });
</script>
