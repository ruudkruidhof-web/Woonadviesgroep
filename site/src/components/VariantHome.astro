---
import Merk from './Merk.astro';
import home from '../content/teksten/home.json';
import varianten from '../content/teksten/varianten.json';
import voorwie from '../content/voorwie.json';
import diensten from '../content/diensten.json';
import werkwijze from '../content/werkwijze.json';
import nieuws from '../content/nieuws.json';
import reviews from '../content/reviews.json';
import bedrijf from '../content/bedrijf.json';

const { thema = 'fris' } = Astro.props;

const datumFmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const [hoofdartikel, ...restartikelen] = nieuws;
const totaalReviews = reviews.aantal + reviews.advieskeuze_aantal;
const manifestTekst1 = thema === 'groen' ? varianten.manifest_tekst_1_groen : home.manifest_tekst_1;
const zekerheden = [
  'Volledig onafhankelijk',
  `AFM-geregistreerd (${bedrijf.afm})`,
  'Aangesloten bij Kifid',
  `Sinds ${bedrijf.sinds} in Rotterdam`,
];
const situatieIconen = {
  'eerste-woning': 'M6 26V15l10-8 10 8v11h-7v-6h-6v6Z',
  'doorstarters': 'M6 26v-8l7-6 7 6v8h-5v-5h-4v5Z M23 13V5m0 0-3 3m3-3 3 3',
  'scheiding': 'M6 26V15l10-8 10 8v11Z M16 11v15',
  'oversluiten': 'M9 23 23 9M13.5 11a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM23.5 21a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z',
};
---
<section class="hero">
  <div class="hero-blob hero-blob-blauw" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-warm" aria-hidden="true"></div>
  <div class="maat hero-grid">
    <div class="hero-tekst">
      <h1>
        <span class="regel" data-cms-field="hero_titel_voor">{home.hero_titel_voor}</span>
        <em class="regel rust" data-cms-field="hero_titel_accent">{home.hero_titel_accent}<svg class="rust-lijn" viewBox="0 0 140 14" preserveAspectRatio="none" aria-hidden="true"><path d="M6 10 C 40 3, 95 13, 134 5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></em>
        <span class="regel na" data-cms-field="hero_titel_na">{home.hero_titel_na}</span>
      </h1>
      <p class="intro" data-cms-field="hero_tekst">{home.hero_tekst}</p>
      <div class="hero-acties">
        <a href="#contact" class="knop knop-vol" data-plan-open data-hb-goal="kennismaking">{home.hero_knop}</a>
        <a href={`tel:${bedrijf.telefoon_link}`} class="knop knop-lijn">Bel {bedrijf.telefoon}</a>
        <a href={`https://wa.me/${bedrijf.whatsapp}`} class="knop knop-lijn knop-app" data-hb-goal="whatsapp">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3 4.3c-.2 0-.5.1-.7.4-.2.2-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.6-.7c.2-.2.2-.4.1-.6l-.8-1.9c-.2-.5-.4-.5-.6-.5Z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
    <figure class="hero-beeld">
      <img src={home.hero_beeld} alt={home.hero_beeld_alt} width="1600" height="900" fetchpriority="high" data-cms-field="hero_beeld" />
      <span class="hero-stat" aria-label={`${varianten.stat_getal} ${varianten.stat_tekst}`}>
        <b data-cms-field="stat_getal">{varianten.stat_getal}</b>
        <span data-cms-field="stat_tekst">{varianten.stat_tekst}</span>
      </span>
      <span class="stempel" aria-hidden="true">
        <Merk breedte={44} klasse="stempel-merk" />
        <svg viewBox="0 0 120 120">
          <defs>
            <path id="stempel-rond" d="M60 13 a47 47 0 1 1 -0.01 0" />
          </defs>
          <text>
            <textPath href="#stempel-rond">Financiële rust · sinds 2010 · Rotterdam ·&nbsp;</textPath>
          </text>
        </svg>
      </span>
    </figure>
  </div>
  <ul class="maat zekerheden">
    {zekerheden.map((z) => (
      <li>
        <svg width="15" height="10" viewBox="0 0 16 11" aria-hidden="true"><path d="M2 9.5 8 2l6 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {z}
      </li>
    ))}
  </ul>
</section>

<section class="situaties" id="voorwie" aria-labelledby="situaties-kop">
  <div class="maat">
    <div class="situaties-kop">
      <h2 id="situaties-kop" class="reveal" data-cms-field="voorwie_titel">{varianten.voorwie_titel}</h2>
      <p class="reveal" data-cms-field="voorwie_tekst">{varianten.voorwie_tekst}</p>
    </div>
    <ul class="situatie-kaarten" data-cms-collection="voorwie">
      {voorwie.map((s) => (
        <li class="reveal" data-cms-item={s.id}>
          <span class="situatie-icoon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 32 32"><path d={situatieIconen[s.id]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3 data-cms-field="titel">{s.titel}</h3>
          <p data-cms-field="tekst">{s.tekst}</p>
          <a href="#contact" data-plan-open data-dienst={s.dienst} data-hb-goal="situatie-interesse">{varianten.voorwie_knop}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="register" id="diensten" aria-labelledby="register-kop">
  <div class="maat">
    <div class="register-kop">
      <h2 id="register-kop" class="reveal" data-cms-field="diensten_titel">{home.diensten_titel}</h2>
      <p class="reveal" data-cms-field="diensten_tekst">{home.diensten_tekst}</p>
    </div>
    <div class="register-grid">
      <ol class="register-rijen" data-cms-collection="diensten">
        {diensten.map((d, i) => (
          <li class="reveal" id={d.id} data-cms-item={d.id} data-index={i}>
            <details open={i === 0}>
              <summary>
                <span class="register-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 data-cms-field="titel">{d.titel}</h3>
                <span class="register-plus" aria-hidden="true"></span>
              </summary>
              <div class="register-klep">
                <div class="register-inhoud">
                  <p data-cms-field="tekst">{d.tekst}</p>
                  <ul>
                    {d.punten.map((punt) => (
                      <li>
                        <svg width="12" height="9" viewBox="0 0 16 11" aria-hidden="true"><path d="M2 9.5 8 2l6 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {punt}
                      </li>
                    ))}
                  </ul>
                  <a href="#contact" data-plan-open data-dienst={d.titel} data-hb-goal="dienst-interesse">Bespreek uw situatie</a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
      <figure class="register-beeld" aria-hidden="true">
        {diensten.map((d, i) => (
          <img src={d.beeld} alt="" width="900" height="1200" loading="lazy" class={i === 0 ? 'actief' : ''} data-index={i} />
        ))}
      </figure>
    </div>
  </div>
</section>

<section class="stemmen" aria-labelledby="stemmen-kop">
  <div class="maat">
    <div class="stemmen-vlak">
      <div class="stemmen-scores">
        <h2 id="stemmen-kop" class="reveal" data-cms-field="reviews_titel">{varianten.reviews_titel}</h2>
        <p class="stemmen-intro reveal" data-cms-field="reviews_tekst">{varianten.reviews_tekst}</p>
        <dl class="scorelijst reveal">
          <div class="score-rij">
            <dt>
              <span class="score-logo" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
              </span>
              Google
            </dt>
            <dd>
              <b>{reviews.score}</b>
              <span class="sterren" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg width="15" height="14" viewBox="0 0 20 19"><path d="M10 .8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.3L10 15.1l-5.7 3.1 1.2-6.3L.8 7.5l6.4-.8Z" fill="currentColor"/></svg>
                ))}
              </span>
              <a href={reviews.google_url}>{reviews.aantal} reviews</a>
            </dd>
          </div>
          <div class="score-rij">
            <dt>
              <span class="score-logo score-tien" aria-hidden="true">{reviews.advieskeuze_score}</span>
              Advieskeuze
            </dt>
            <dd>
              <b>{reviews.advieskeuze_score}<span class="score-van">/10</span></b>
              <a href={reviews.advieskeuze_url}>{reviews.advieskeuze_aantal} reviews</a>
            </dd>
          </div>
        </dl>
        <p class="score-som reveal">Samen {totaalReviews} beoordelingen van klanten die ons vooraf niet kenden.</p>
      </div>
      <div class="stemmen-quote reveal">
        <ul class="quote-wissel" data-cms-collection="reviews-uitgelicht">
          {reviews.uitgelicht.map((r, i) => (
            <li class={i === 0 ? 'actief' : ''} data-cms-item={r.id}>
              <blockquote data-cms-field="tekst">{r.tekst}</blockquote>
              <p class="quote-naam"><span data-cms-field="naam">{r.naam}</span> <span class="quote-bron">via {r.bron}, {r.wanneer}</span></p>
            </li>
          ))}
        </ul>
        <div class="quote-dots">
          {reviews.uitgelicht.map((r, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Review van ${r.naam}`} data-index={i}></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="verhaal" aria-labelledby="verhaal-kop">
  <div class="maat verhaal-grid">
    <figure class="verhaal-beeld reveal">
      <img src={home.verhaal_beeld} alt={home.verhaal_beeld_alt} width="960" height="1200" loading="lazy" data-cms-field="verhaal_beeld" />
      <blockquote data-cms-field="verhaal_quote">{home.verhaal_quote}</blockquote>
    </figure>
    <div class="verhaal-tekst">
      <h2 id="verhaal-kop" class="reveal" data-cms-field="verhaal_titel">{home.verhaal_titel}</h2>
      <p class="reveal" data-cms-field="verhaal_tekst_1">{home.verhaal_tekst_1}</p>
      <p class="reveal" data-cms-field="verhaal_tekst_2">{home.verhaal_tekst_2}</p>
    </div>
  </div>
</section>

<section class="route" id="werkwijze" aria-labelledby="route-kop">
  <div class="maat">
    <h2 id="route-kop" class="reveal" data-cms-field="werkwijze_titel">{home.werkwijze_titel}</h2>
    <p class="route-intro reveal" data-cms-field="werkwijze_tekst_kort">{varianten.werkwijze_tekst_kort}</p>
    <div class="route-vlak">
      <svg class="route-pad" viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 32 C 90 10, 200 54, 320 32 S 560 10, 680 32 S 920 54, 1000 30" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="7 7" stroke-linecap="round" />
      </svg>
      <ol class="stations" data-cms-collection="werkwijze">
        {werkwijze.map((stap, i) => (
          <li class="station reveal" data-cms-item={stap.id}>
            <span class="station-nr" aria-hidden="true">{i + 1}</span>
            <h3 data-cms-field="titel">{stap.titel}</h3>
            <p data-cms-field="kort">{stap.kort}</p>
          </li>
        ))}
      </ol>
      <p class="route-einde reveal">
        <svg width="30" height="28" viewBox="0 0 34 32" aria-hidden="true"><path d="M17 3 32 18h-5v11H7V18H2Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>
        <span data-cms-field="werkwijze_einde">{home.werkwijze_einde}</span>
      </p>
    </div>
    <div class="route-slot">
      <aside class="briefje reveal">
        <span class="briefje-merk"><Merk breedte={46} /></span>
        <h3 data-cms-field="kosten_titel">{home.kosten_titel}</h3>
        <p data-cms-field="werkwijze_kosten">{home.werkwijze_kosten}</p>
      </aside>
      <div class="route-cta reveal">
        <p>Het begint dus gewoon met een kop koffie. Bij u thuis of bij ons aan de Oostmaaslaan.</p>
        <a href="#contact" class="knop knop-vol" data-plan-open data-hb-goal="kennismaking">Plan een kennismaking</a>
        <a href={`tel:${bedrijf.telefoon_link}`} class="route-bel">Of bel {bedrijf.telefoon}</a>
      </div>
    </div>
  </div>
</section>

<section class="manifest" aria-labelledby="manifest-kop">
  <div class="maat manifest-strip">
    <span class="manifest-merk reveal"><Merk breedte={124} /></span>
    <h2 id="manifest-kop" class="reveal" data-cms-field="manifest_titel">{home.manifest_titel}</h2>
    <div class="manifest-tekst">
      <p class="reveal" data-cms-field="manifest_tekst_1">{manifestTekst1}</p>
      <p class="reveal" data-cms-field="manifest_tekst_2">{home.manifest_tekst_2}</p>
    </div>
  </div>
</section>

<section class="actueel" id="actueel" aria-labelledby="actueel-kop">
  <div class="maat">
    <h2 id="actueel-kop" class="reveal" data-cms-field="actueel_titel">{home.actueel_titel}</h2>
    <div class="artikelen" data-cms-collection="nieuws">
      <article class="artikel-groot reveal" data-cms-item={hoofdartikel.id}>
        <img src={hoofdartikel.beeld} alt={hoofdartikel.beeld_alt} width="1400" height="933" loading="lazy" data-cms-field="beeld" />
        <div>
          <time datetime={hoofdartikel.datum}>{datumFmt.format(new Date(hoofdartikel.datum))}</time>
          <h3 data-cms-field="titel">{hoofdartikel.titel}</h3>
          <p data-cms-field="tekst">{hoofdartikel.tekst}</p>
        </div>
      </article>
      <div class="artikelen-rest">
        {restartikelen.map((artikel) => (
          <article class="reveal" data-cms-item={artikel.id}>
            <img src={artikel.beeld} alt={artikel.beeld_alt} width="900" height="600" loading="lazy" data-cms-field="beeld" />
            <div>
              <time datetime={artikel.datum}>{datumFmt.format(new Date(artikel.datum))}</time>
              <h3 data-cms-field="titel">{artikel.titel}</h3>
              <p data-cms-field="tekst">{artikel.tekst}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="contact" id="contact" aria-labelledby="contact-kop">
  <img src={home.contact_beeld} alt="" width="2100" height="900" loading="lazy" class="contact-achtergrond" />
  <div class="maat contact-inhoud">
    <div class="contact-tekst">
      <h2 id="contact-kop" class="reveal" data-cms-field="contact_titel">{home.contact_titel}</h2>
      <p class="reveal" data-cms-field="contact_tekst">{home.contact_tekst}</p>
    </div>
    <aside class="kaartje reveal">
      <span class="kaartje-merk"><Merk breedte={54} /></span>
      <p class="kaartje-naam">{bedrijf.naam}</p>
      <p class="kaartje-motto">{bedrijf.tagline}</p>
      <dl class="kaartje-gegevens">
        <dt>Kantoor</dt>
        <dd>{bedrijf.adres_straat}<br />{bedrijf.adres_plaats}</dd>
        <dt>Telefoon</dt>
        <dd><a href={`tel:${bedrijf.telefoon_link}`}>{bedrijf.telefoon}</a></dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></dd>
      </dl>
      <p class="kaartje-voet">KvK {bedrijf.kvk} &middot; AFM {bedrijf.afm} &middot; Kifid {bedrijf.kifid}</p>
    </aside>
    <div class="kanalen reveal">
      <a href={`tel:${bedrijf.telefoon_link}`} class="kanaal" data-hb-goal="bellen">
        <span class="kanaal-icoon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 16 16"><path d="M3.2 1.5h2.1c.4 0 .8.3.9.7l.6 2.2c.1.4 0 .8-.3 1L5.3 6.6a10.5 10.5 0 0 0 4.1 4.1l1.2-1.2c.2-.3.6-.4 1-.3l2.2.6c.4.1.7.5.7.9v2.1c0 .6-.5 1-1 1A13 13 0 0 1 2.2 2.5c0-.5.4-1 1-1z" fill="currentColor"/></svg>
        </span>
        <span class="kanaal-titel" data-cms-field="contact_bel_titel">{varianten.contact_bel_titel}</span>
        <span class="kanaal-detail">{bedrijf.telefoon}</span>
        <span class="kanaal-sub" data-cms-field="contact_bel_tekst">{varianten.contact_bel_tekst}</span>
      </a>
      <a href={`https://wa.me/${bedrijf.whatsapp}`} class="kanaal" data-hb-goal="whatsapp">
        <span class="kanaal-icoon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3 4.3c-.2 0-.5.1-.7.4-.2.2-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.6-.7c.2-.2.2-.4.1-.6l-.8-1.9c-.2-.5-.4-.5-.6-.5Z"/></svg>
        </span>
        <span class="kanaal-titel" data-cms-field="contact_app_titel">{varianten.contact_app_titel}</span>
        <span class="kanaal-detail">{bedrijf.telefoon}</span>
        <span class="kanaal-sub" data-cms-field="contact_app_tekst">{varianten.contact_app_tekst}</span>
      </a>
      <button type="button" class="kanaal" data-plan-open data-hb-goal="kennismaking">
        <span class="kanaal-icoon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 6h16v14H4Z M4 10h16 M8 3v4 M16 3v4 M9 15l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="kanaal-titel" data-cms-field="contact_plan_titel">{varianten.contact_plan_titel}</span>
        <span class="kanaal-detail">Via het formulier</span>
        <span class="kanaal-sub" data-cms-field="contact_plan_tekst">{varianten.contact_plan_tekst}</span>
      </button>
    </div>
  </div>
</section>

<dialog id="plan-dialoog">
  <div class="dialoog-merk">
    <span class="dialoog-zegel"><Merk breedte={46} /></span>
    <p class="dialoog-motto">{bedrijf.tagline}</p>
    <p class="dialoog-sub">Liever direct iemand spreken?</p>
    <a href={`tel:${bedrijf.telefoon_link}`}>Bel {bedrijf.telefoon}</a>
    <a href={`https://wa.me/${bedrijf.whatsapp}`}>Of stuur een WhatsApp</a>
  </div>
  <form method="dialog" data-hb-lead>
    <button type="button" class="dialoog-sluit" aria-label="Sluiten">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <h3>Plan een kennismaking</h3>
    <p class="dialoog-intro">Vrijblijvend en kosteloos, bij u thuis of bij ons op kantoor.</p>
    <label>
      Uw naam
      <input type="text" name="naam" autocomplete="name" required />
    </label>
    <label>
      Telefoon of e-mail
      <input type="text" name="contact" autocomplete="tel" required />
    </label>
    <label>
      Waar gaat het over?
      <select name="onderwerp">
        <option>Kennismaking</option>
